BYTE FUNC RetLt(INT a,b) RETURN(a<b)
BYTE FUNC BranchLt(INT a,b) IF a<b THEN RETURN(1) FI RETURN(0)
BYTE FUNC RetLe(INT a,b) RETURN(a<=b)
BYTE FUNC BranchLe(INT a,b) IF a<=b THEN RETURN(1) FI RETURN(0)
BYTE FUNC RetGt(INT a,b) RETURN(a>b)
BYTE FUNC BranchGt(INT a,b) IF a>b THEN RETURN(1) FI RETURN(0)
BYTE FUNC RetGe(INT a,b) RETURN(a>=b)
BYTE FUNC BranchGe(INT a,b) IF a>=b THEN RETURN(1) FI RETURN(0)
BYTE FUNC Imm(INT a) RETURN(a<0)
PROC Main() RETURN
