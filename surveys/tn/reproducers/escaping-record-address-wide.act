; Independent layout: 2-byte stride and a full-word embedded displacement.
TYPE Element=[CARD value]
TYPE Table=[BYTE ARRAY prefix(256) Element ARRAY rows(8)]
Table POINTER view=$0600
BYTE byteIndex=$0602
CARD wordIndex=$0604
CARD ARRAY results(5)

CARD FUNC Address(Table POINTER table BYTE index)
RETURN(@table.rows(index))

CARD FUNC ReadViaLocal(Table POINTER table CARD index)
  Element POINTER item
  item=@table.rows(index)
RETURN(item.value)

CARD FUNC ReadDirect(Table POINTER table CARD index)
RETURN(table.rows(index).value)

CARD FUNC AddressZero(Table POINTER table)
RETURN(@table.rows(0))

CARD FUNC AddressField(Table POINTER table)
RETURN(@table.rows)

PROC Main()
  results(0)=Address(view,byteIndex)
  results(1)=ReadViaLocal(view,wordIndex)
  results(2)=ReadDirect(view,wordIndex)
  results(3)=AddressZero(view)
  results(4)=AddressField(view)
RETURN
