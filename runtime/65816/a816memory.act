MODULE A816MEMORY
; Link memory.s in the embedding platform. Ordinary, reentrant native-v2 calls:
; no stack use, allocation, interrupt masking or shared writable state.
; Callers provide valid contiguous ordinary-memory objects; Move permits overlap.
PUBLIC EXTERNAL PROC Clear(BYTE POINTER destination SIZE length)
PUBLIC EXTERNAL PROC Move(BYTE POINTER destination,source SIZE length)
PUBLIC EXTERNAL PROC Fill(BYTE POINTER destination BYTE value SIZE length)
ENDMODULE
