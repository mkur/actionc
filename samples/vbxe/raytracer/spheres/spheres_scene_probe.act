; Deterministic, hardware-independent probe for the sphere ray kernel.
; Compile with --profile modern. The result bytes are also exercised by the
; actionc VM tests, so this program does not require VBXE.
MODULE SPHERES_SCENE_PROBE

USE SPHERES_SCENE AS SCENE

BYTE ARRAY shades(10)=$0700
BYTE ARRAY reflections(10)=$0710
BYTE done=$0720

PROC Sample(BYTE index, CARD col, BYTE row)
  shades(index)=SCENE.Trace(col,row)
  reflections(index)=SCENE.LastReflections
RETURN

PROC Main()
  Sample(0,0,0)
  Sample(1,160,0)
  Sample(2,0,96)
  Sample(3,80,96)
  Sample(4,160,96)
  Sample(5,240,96)
  Sample(6,319,96)
  Sample(7,160,191)
  Sample(8,319,191)
  ; This SR320 ray reaches the measured four-reflection maximum.
  Sample(9,142,80)
  done=$A5
  DO OD
RETURN

ENDMODULE
