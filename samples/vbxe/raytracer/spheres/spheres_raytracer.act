; Progressive VBXE ray tracer based on the Atari BASIC ten-liner.
;
; Compile with:
;   actionc --module-path samples/vbxe --profile modern \
;     --runtime standalone samples/vbxe/raytracer/spheres/spheres_raytracer.act
MODULE VBXE_SPHERES_RAYTRACER

USE ATARI.GTIA
USE ATARI.OS
USE SPHERES_SCENE AS SCENE
USE SHARED.SCREEN AS VIDEO
USE SYS

CONST CARD OUTPUT_WIDTH=320

CONST BYTE LAST_ROW=191

; Trace into a conventional row first. Keeping ray calculation separate from
; framebuffer writes lets the progressive renderer reuse one expensive row for
; every screen row in its current coarse span.
BYTE ARRAY line(OUTPUT_WIDTH)

STRING missing(0)="VBXE FX 1.2x is required."
STRING rendering(0)="Rendering the VBXE ray tracer..."
STRING keyText(0)="Press any key to continue."

PROC WaitKey()
  ; Reset the latch so a key used to launch the program cannot dismiss it, and
  ; keep the OS attract-mode timer inactive while the image is being viewed.
  OS.CH=OS.NO_KEY
  WHILE OS.CH=OS.NO_KEY
  DO
    OS.ATRACT=0
  OD
RETURN

PROC TraceLine(BYTE row)
  BYTE shade
  CARD col

  col=0
  WHILE col<SCENE.WIDTH
  DO
    ; Trace returns a palette index, so no pixel-format conversion is needed
    ; when the row is copied to the 8-bit VBXE framebuffer.
    OS.ATRACT=0
    shade=SCENE.Trace(col,row)
    line(col)=shade
    col==+1
  OD
RETURN

PROC CopyLine(BYTE row)
  CARD x
  BYTE POINTER destination

  ; RowAddress hides the framebuffer base and stride selected by the shared
  ; VBXE screen module.
  destination=VIDEO.RowAddress(row)
  x=0
  WHILE x<OUTPUT_WIDTH
  DO
    destination(x)=line(x)
    x==+1
  OD
RETURN

PROC ShowSpan(BYTE sourceRow,height)
  BYTE firstRow,lastRow,row

  ; Scene rows grow upward in the original formula, while framebuffer rows grow
  ; downward. Flip the coordinate and fill the unresolved band ending at that
  ; screen row with the newest sample.
  lastRow=LAST_ROW-sourceRow
  firstRow=lastRow-height
  row=firstRow
  WHILE row<=lastRow
  DO
    CopyLine(row)
    row==+1
  OD
RETURN

PROC Render()
  BYTE gap,offset,height,row

  ; Render a recognizable image quickly, then halve the sampling interval.
  ; Each pass fills only the gaps left by earlier passes: 64-row bands first,
  ; followed by 32, 16, 8, 4, and finally 2-row bands.
  gap=64
  offset=0
  height=63
  DO
    row=offset
    WHILE row<SCENE.HEIGHT
    DO
      TraceLine(row)
      ShowSpan(row,height)
      row==+gap
    OD

    IF offset=0 THEN
      ; The first refinement samples the midpoint of each 64-row span.
      offset=gap RSH 1
      height=offset-1
    ELSE
      gap=gap RSH 1
      IF gap<=1 THEN
        EXIT
      FI
      offset=gap RSH 1
      height=offset-1
    FI
  OD
RETURN

PROC Main()
  ; Start in a normal OS text mode so initialization errors remain readable.
  SYS.Graphics(0)
  SYS.PrintE(rendering)
  IF VIDEO.Init()=0 THEN
    SYS.PrintE(missing)
    SYS.PrintE(keyText)
    WaitKey()
    RETURN
  FI

  GTIA.COLBAK=0
  OS.COLOR4=0
  ; VIDEO.Init has installed the SR320 framebuffer and grayscale palette. The
  ; renderer can now write palette indexes directly into extended memory.
  Render()
  WaitKey()
  VIDEO.Shutdown()
  SYS.Graphics(0)
RETURN

ENDMODULE
