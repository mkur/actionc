; Hardware-independent REAL ray kernel for an extruded Atari Fuji.
;
; The logo is described as three curved vertical bands. Camera rays are
; transformed into logo space, where the shape occupies the slab from z=-8
; to z=8. A ray inside the near silhouette hits the front face. A ray outside
; the near silhouette but inside the far silhouette crosses a visible side
; wall; binary refinement locates that crossing for coherent lighting.
MODULE FUJI_SCENE

USE MATH AS FPP

PUBLIC CONST CARD WIDTH=320
PUBLIC CONST BYTE HEIGHT=192,
                  HIT_BACKGROUND=0,
                  HIT_FRONT=1,
                  HIT_SIDE=2

CONST BYTE SIDE_REFINEMENTS=5,
           MATERIAL_SKY=$00,
           MATERIAL_FRONT=$40,
           MATERIAL_SIDE=$80,
           MATERIAL_FLOOR=$C0

CONST REAL PROJECTION_SCALE=135.0,
           ROTATION_SIN=0.3420201433,
           ROTATION_COS=0.9396926208,
           CAMERA_LOCAL_X=34.20201433,
           CAMERA_LOCAL_Z=-93.96926208,
           LOGO_HALF_DEPTH=8.0,
           LOGO_TOP=45.0,
           LOGO_BOTTOM=-45.0,
           LOGO_HEIGHT=90.0,
           CENTER_HALF_WIDTH=6.25,
           WING_INNER_TOP=9.0,
           WING_OUTER_TOP=16.0,
           WING_TIP_X=56.0,
           WING_INNER_BEND=47.0,
           WING_OUTER_BEND=40.0,
           WING_TIP_START=77.0,
           INNER_SLOPE_SCALE=3.133333333,
           OUTER_SLOPE_SCALE=2.077922078,
           FLOOR_Y=-45.0,
           MIRROR_CENTER_Y=-90.0,
           LIGHT_X=-0.35,
           LIGHT_Y=0.55,
           LIGHT_Z=-0.75,
           LIGHT_LOCAL_X=-0.0723773098,
           LIGHT_LOCAL_Z=-0.8244765158

PUBLIC BYTE LastHitKind

; The classic Fuji has a straight center pillar and two narrow strokes which
; begin beside it, then sweep outward into rounded feet. The sixth- and
; fourth-power curves below closely follow that silhouette while keeping the
; geometry analytic and inexpensive to describe.
BYTE FUNC InsideFuji(REAL POINTER x,y)
  REAL localX,localY,absoluteX,fromTop,normalized,squared
  REAL wingInnerEdge,wingOuterEdge

  localX=x^
  localY=y^
  IF localY>LOGO_TOP THEN RETURN(0) FI
  IF localY<LOGO_BOTTOM THEN RETURN(0) FI

  absoluteX=localX
  IF absoluteX<0 THEN absoluteX=-absoluteX FI

  ; Unlike the earlier approximation, the center does not flare at the base.
  IF absoluteX<=CENTER_HALF_WIDTH THEN RETURN(1) FI

  fromTop=LOGO_TOP-localY

  ; The inner boundary stays nearly upright through most of the mark, then
  ; curls sharply outward near the foot.
  normalized=fromTop/LOGO_HEIGHT
  squared=normalized*normalized
  wingInnerEdge=WING_INNER_TOP+WING_INNER_BEND*squared*squared*squared

  ; The outer boundary begins wider and reaches the tip sooner. Its final
  ; vertical segment rounds off the outside of the foot.
  IF fromTop<WING_TIP_START THEN
    normalized=fromTop/WING_TIP_START
    squared=normalized*normalized
    wingOuterEdge=WING_OUTER_TOP+WING_OUTER_BEND*squared*squared
  ELSE
    wingOuterEdge=WING_TIP_X
  FI

  IF absoluteX>=wingInnerEdge THEN
    IF absoluteX<=wingOuterEdge THEN RETURN(1) FI
  FI
RETURN(0)

; Trace a directional-light ray from the floor through the logo's depth slab.
; Sampling the entry, middle, and exit points is sufficient for these broad
; analytic strokes and gives the ground plane a real cast shadow.
BYTE FUNC FujiShadowsFloor(REAL POINTER worldX,worldZ)
  REAL originX,originZ,nearT,farT,middleT,localX,localY

  originX=ROTATION_COS*worldX^-ROTATION_SIN*worldZ^
  originZ=ROTATION_SIN*worldX^+ROTATION_COS*worldZ^
  IF originZ<=LOGO_HALF_DEPTH THEN RETURN(0) FI

  nearT=(LOGO_HALF_DEPTH-originZ)/LIGHT_LOCAL_Z
  IF nearT<0 THEN RETURN(0) FI
  farT=(-LOGO_HALF_DEPTH-originZ)/LIGHT_LOCAL_Z

  localX=originX+nearT*LIGHT_LOCAL_X
  localY=FLOOR_Y+nearT*LIGHT_Y
  IF InsideFuji(@localX,@localY)#0 THEN RETURN(1) FI

  middleT=(nearT+farT)/2
  localX=originX+middleT*LIGHT_LOCAL_X
  localY=FLOOR_Y+middleT*LIGHT_Y
  IF InsideFuji(@localX,@localY)#0 THEN RETURN(1) FI

  localX=originX+farT*LIGHT_LOCAL_X
  localY=FLOOR_Y+farT*LIGHT_Y
  IF InsideFuji(@localX,@localY)#0 THEN RETURN(1) FI
RETURN(0)

; Recover an outward normal for whichever silhouette boundary the side ray
; crossed. The three curved bands make this more expressive than a box normal.
PROC FujiSideNormal(REAL POINTER x,y,normalX,normalY)
  REAL localX,localY,absoluteX,fromTop,normalized,squared
  REAL wingInnerEdge,wingOuterEdge,boundarySlope
  REAL innerDistance,outerDistance,lengthSquared,length

  localX=x^
  localY=y^
  IF localY>44 THEN
    normalX^=0
    normalY^=1
    RETURN
  ELSEIF localY<-44 THEN
    normalX^=0
    normalY^=-1
    RETURN
  FI

  absoluteX=localX
  IF absoluteX<0 THEN absoluteX=-absoluteX FI
  fromTop=LOGO_TOP-localY

  IF absoluteX<=CENTER_HALF_WIDTH THEN
    normalX^=1
    IF localX<0 THEN normalX^=-1 FI
    normalY^=0
  ELSE
    normalized=fromTop/LOGO_HEIGHT
    squared=normalized*normalized
    wingInnerEdge=WING_INNER_TOP+WING_INNER_BEND*squared*squared*squared

    IF fromTop<WING_TIP_START THEN
      normalized=fromTop/WING_TIP_START
      squared=normalized*normalized
      wingOuterEdge=WING_OUTER_TOP+WING_OUTER_BEND*squared*squared
    ELSE
      wingOuterEdge=WING_TIP_X
    FI

    innerDistance=absoluteX-wingInnerEdge
    outerDistance=wingOuterEdge-absoluteX

    IF innerDistance<outerDistance THEN
      ; d(9 + 47*(t/90)^6)/dt
      normalized=fromTop/LOGO_HEIGHT
      squared=normalized*normalized
      boundarySlope=INNER_SLOPE_SCALE*normalized*squared*squared
      normalX^=-1
      IF localX<0 THEN normalX^=1 FI
      normalY^=-boundarySlope
    ELSE
      ; d(16 + 40*(t/77)^4)/dt; the rounded tip is vertical.
      boundarySlope=0
      IF fromTop<WING_TIP_START THEN
        normalized=fromTop/WING_TIP_START
        squared=normalized*normalized
        boundarySlope=OUTER_SLOPE_SCALE*normalized*squared
      FI
      normalX^=1
      IF localX<0 THEN normalX^=-1 FI
      normalY^=boundarySlope
    FI
  FI

  lengthSquared=normalX^*normalX^+normalY^*normalY^
  FPP.Sqrt(@lengthSquared,@length)
  normalX^==/length
  normalY^==/length
RETURN

BYTE FUNC ShadeFuji(REAL POINTER localNormalX,localNormalY,localNormalZ,
                    BYTE material)
  REAL worldNormalX,worldNormalY,worldNormalZ,diffuse,levelReal
  INT level

  ; Transform the object-space normal back through the logo's Y rotation.
  worldNormalX=ROTATION_COS*localNormalX^+ROTATION_SIN*localNormalZ^
  worldNormalY=localNormalY^
  worldNormalZ=-ROTATION_SIN*localNormalX^+ROTATION_COS*localNormalZ^

  diffuse=worldNormalX*LIGHT_X+
          worldNormalY*LIGHT_Y+
          worldNormalZ*LIGHT_Z
  IF diffuse<0 THEN diffuse=0 FI
  levelReal=12+48*diffuse
  level=INT(levelReal)
  IF level<0 THEN level=0 FI
  IF level>63 THEN level=63 FI
RETURN(material+BYTE(level))

BYTE FUNC Background(CARD col,BYTE row)
  BYTE hash,level

  hash=BYTE(col)
  hash=hash*17
  hash==+row
  hash=hash XOR (hash RSH 3)
  hash=hash*29
  hash==+BYTE(col RSH 1)
  IF row<150 AND hash>253 THEN RETURN(60+(hash AND 3)) FI

  level=4+(row RSH 2)
  IF level>59 THEN level=59 FI
RETURN(level)

; Intersect the camera ray with a warm checkerboard ground plane. This is kept
; separate from the object trace so their REAL temporaries are not live at the
; same time on the small 6502 runtime stack.
BYTE FUNC TraceFloor(CARD col,BYTE row)
  INT screenX,screenY,tileX,tileZ
  REAL rayX,rayY,floorT,worldX,worldZ,tileCoordinate
  BYTE level

  screenX=INT(col)-160
  screenY=96-INT(row)
  rayX=screenX
  rayY=screenY
  rayX==/PROJECTION_SCALE
  rayY==/PROJECTION_SCALE

  floorT=FLOOR_Y/rayY
  worldX=floorT*rayX
  worldZ=-100+floorT

  level=16+((row-97) RSH 2)
  IF level>47 THEN level=47 FI

  ; Suppress tiny distant checks near the horizon, where they would alias.
  IF row>108 THEN
    tileCoordinate=worldX/18
    tileX=INT(tileCoordinate)
    tileCoordinate=worldZ/18
    tileZ=INT(tileCoordinate)
    IF ((BYTE(tileX) XOR BYTE(tileZ)) AND 1)#0 THEN level==-6 FI
  FI

  IF FujiShadowsFloor(@worldX,@worldZ)#0 THEN level=level/3 FI
RETURN(MATERIAL_FLOOR+level)

; Trace only the physical extruded logo. Zero is safe as the miss sentinel
; because both logo material families start above palette index 63.
BYTE FUNC TraceObject(CARD col,BYTE row)
  INT screenX,screenY
  BYTE refinement
  REAL rayX,rayY,localDirectionX,localDirectionY,localDirectionZ
  REAL nearT,farT,outsideT,insideT,middleT,hitT
  REAL localX,localY,normalX,normalY,normalZ

  IF col<40 OR col>280 OR row<18 OR row>178 THEN RETURN(0) FI

  screenX=INT(col)-160
  screenY=96-INT(row)
  rayX=screenX
  rayY=screenY
  rayX==/PROJECTION_SCALE
  rayY==/PROJECTION_SCALE

  ; Inverse Y rotation places the camera ray in the logo's local space.
  localDirectionX=ROTATION_COS*rayX-ROTATION_SIN
  localDirectionY=rayY
  localDirectionZ=ROTATION_SIN*rayX+ROTATION_COS

  nearT=(-LOGO_HALF_DEPTH-CAMERA_LOCAL_Z)/localDirectionZ
  farT=(LOGO_HALF_DEPTH-CAMERA_LOCAL_Z)/localDirectionZ

  localX=CAMERA_LOCAL_X+nearT*localDirectionX
  localY=nearT*localDirectionY
  IF InsideFuji(@localX,@localY)#0 THEN
    normalX=0
    normalY=0
    normalZ=-1
    LastHitKind=HIT_FRONT
    RETURN(ShadeFuji(@normalX,@normalY,@normalZ,MATERIAL_FRONT))
  FI

  ; If only the far silhouette contains the ray, it entered through a side.
  localX=CAMERA_LOCAL_X+farT*localDirectionX
  localY=farT*localDirectionY
  IF InsideFuji(@localX,@localY)=0 THEN RETURN(0) FI

  outsideT=nearT
  insideT=farT
  refinement=0
  WHILE refinement<SIDE_REFINEMENTS
  DO
    middleT=(outsideT+insideT)/2
    localX=CAMERA_LOCAL_X+middleT*localDirectionX
    localY=middleT*localDirectionY
    IF InsideFuji(@localX,@localY)#0 THEN
      insideT=middleT
    ELSE
      outsideT=middleT
    FI
    refinement==+1
  OD

  hitT=insideT
  localX=CAMERA_LOCAL_X+hitT*localDirectionX
  localY=hitT*localDirectionY
  FujiSideNormal(@localX,@localY,@normalX,@normalY)
  normalZ=0
  LastHitKind=HIT_SIDE
RETURN(ShadeFuji(@normalX,@normalY,@normalZ,MATERIAL_SIDE))

; A planar reflection can be traced as an upside-down virtual object centered
; at twice the floor height. It is deliberately dimmer than the physical Fuji.
BYTE FUNC TraceReflection(CARD col,BYTE row)
  INT screenX,screenY
  REAL rayX,rayY,localDirectionX,localDirectionZ
  REAL nearT,farT,localX,localY

  IF col<40 OR col>280 OR row<154 THEN RETURN(0) FI

  screenX=INT(col)-160
  screenY=96-INT(row)
  rayX=screenX
  rayY=screenY
  rayX==/PROJECTION_SCALE
  rayY==/PROJECTION_SCALE

  localDirectionX=ROTATION_COS*rayX-ROTATION_SIN
  localDirectionZ=ROTATION_SIN*rayX+ROTATION_COS
  nearT=(-LOGO_HALF_DEPTH-CAMERA_LOCAL_Z)/localDirectionZ
  farT=(LOGO_HALF_DEPTH-CAMERA_LOCAL_Z)/localDirectionZ

  localX=CAMERA_LOCAL_X+nearT*localDirectionX
  localY=MIRROR_CENTER_Y-nearT*rayY
  IF InsideFuji(@localX,@localY)#0 THEN RETURN(MATERIAL_FRONT+24) FI

  localX=CAMERA_LOCAL_X+farT*localDirectionX
  localY=MIRROR_CENTER_Y-farT*rayY
  IF InsideFuji(@localX,@localY)#0 THEN RETURN(MATERIAL_SIDE+14) FI
RETURN(0)

PUBLIC BYTE FUNC Trace(CARD col,BYTE row)
  BYTE color

  LastHitKind=HIT_BACKGROUND
  color=TraceObject(col,row)
  IF color#0 THEN RETURN(color) FI

  IF row>96 THEN
    color=TraceReflection(col,row)
    IF color#0 THEN RETURN(color) FI
    RETURN(TraceFloor(col,row))
  FI
RETURN(Background(col,row))

ENDMODULE
