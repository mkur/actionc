; Hardware-independent ray kernel for the VBXE ray tracer sample.
;
; This is a structured translation of the geometry in the Atari BASIC
; ten-liner. It traces one of the 320x192 VBXE pixels and returns an 8-bit
; luminance palette index.
MODULE RAY

USE MATH AS FPP

PUBLIC CONST CARD WIDTH=320

PUBLIC CONST BYTE HEIGHT=192,
                  REFERENCE_MAX_REFLECTIONS=4,
                  REFLECTION_LIMIT=8

; Graphics 9 pixels are four times as wide as SR320 pixels. The BASIC camera
; divides its 80 columns by 20*1.7, so the equivalent SR320 divisor is
; 4*20*1.7. This also makes the horizontal and vertical projection scales
; equal at 320x192.
CONST REAL HORIZONTAL_SCALE=136.0,
           VERTICAL_SCALE=136.0,
           HALF_WIDTH=162.0,
           HALF_HEIGHT=96.5

PUBLIC BYTE LastReflections

; Native REAL-to-INT conversion follows Atari FPI and rounds to the nearest
; integer. Atari BASIC INT rounds down, so adjust a rounded result when needed.
INT FUNC FloorR(REAL POINTER value)
  REAL original,wholeReal
  INT whole

  original=value^
  whole=INT(original)
  wholeReal=whole
  IF wholeReal>original THEN
    whole==-1
  FI
RETURN(whole)

PUBLIC BYTE FUNC Trace(CARD col, BYTE row)
  REAL x,y,z,u,v,w,e,f,g,p,disc,t
  REAL rootArg,root,floorX,floorZ,checkerReal,shadeReal
  INT sphere,checker,level
  BYTE parity,shade

  x=0
  y=-0.1
  z=3
  u=(col-HALF_WIDTH)/HORIZONTAL_SCALE
  v=(row-HALF_HEIGHT)/VERTICAL_SCALE
  rootArg=u*u+v*v+1
  FPP.Sqrt(@rootArg,@root)
  w=1/root
  u=u*w
  v=v*w

  IF u<0 THEN
    sphere=-1
  ELSE
    sphere=1
  FI

  LastReflections=0
  WHILE LastReflections<REFLECTION_LIMIT
  DO
    e=x-sphere
    f=y-sphere
    p=u*e+v*f-w*z
    disc=p*p-e*e-f*f-z*z+1
    IF disc<=0 THEN
      EXIT
    FI

    FPP.Sqrt(@disc,@root)
    t=-p-root
    IF t<=0 THEN
      EXIT
    FI

    x=x+t*u
    y=y+t*v
    z=z-t*w
    e=x-sphere
    f=y-sphere
    g=z
    p=2*(u*e+v*f-w*g)
    u=u-p*e
    v=v-p*f
    w=w+p*g
    sphere=-sphere
    LastReflections==+1
  OD

  IF v<0 THEN
    p=(y+2)/v
    floorX=x-u*p
    floorZ=z-w*p
    checker=FloorR(@floorX)+FloorR(@floorZ)
    parity=checker&1
    checkerReal=parity
    v=-v*(checkerReal/2+0.3)+0.2
  FI

  ; The BASIC reference quantizes this value to 16 Graphics 9 shades. VBXE
  ; has a 256-entry palette, so preserve the same contrast range without the
  ; ordered dither or 16-level quantization. The screen module maps the index
  ; through a monotonic color ramp.
  IF v<0 THEN
    v=0
  FI
  FPP.Sqrt(@v,@root)
  shadeReal=238*root
  level=FloorR(@shadeReal)
  IF level>255 THEN
    RETURN(0)
  FI
  shade=255-level
RETURN(shade)

ENDMODULE
