; Progressive VBXE rendering of a neon ringed planet and reflective grid.
;
; Compile with:
;   actionc --profile modern --runtime standalone samples/vbxe/neon_planet.act
MODULE VBXE_NEON_PLANET

USE ATARI.GTIA
USE ATARI.OS
USE NEON_PALETTE AS COLORS
USE NEON_SCENE AS SCENE
USE SCREEN AS VIDEO
USE SYS

CONST CARD OUTPUT_WIDTH=320
CONST BYTE LAST_ROW=191

BYTE ARRAY line(OUTPUT_WIDTH)

STRING missing(0)="VBXE FX 1.2x is required."
STRING rendering(0)="Rendering the VBXE neon planet..."
STRING keyText(0)="Press any key to continue."

PROC AnimateUntilKey()
  BYTE frame,phase

  OS.CH=OS.NO_KEY
  frame=OS.RTCLOK_LO
  phase=0
  WHILE OS.CH=OS.NO_KEY
  DO
    OS.ATRACT=0
    IF OS.RTCLOK_LO#frame THEN
      frame=OS.RTCLOK_LO
      phase==+1
      COLORS.Animate(phase)
    FI
  OD
RETURN

PROC TraceLine(BYTE row)
  CARD col

  col=0
  WHILE col<SCENE.WIDTH
  DO
    OS.ATRACT=0
    line(col)=SCENE.Trace(col,row)
    col==+1
  OD
RETURN

PROC CopyLine(BYTE row)
  CARD x
  BYTE POINTER destination

  destination=VIDEO.RowAddress(row)
  x=0
  WHILE x<OUTPUT_WIDTH
  DO
    destination(x)=line(x)
    x==+1
  OD
RETURN

PROC ShowSpan(BYTE sourceRow,height)
  BYTE lastRow,row

  lastRow=sourceRow+height
  IF lastRow>LAST_ROW THEN lastRow=LAST_ROW FI
  row=sourceRow
  WHILE row<=lastRow
  DO
    CopyLine(row)
    row==+1
  OD
RETURN

PROC Render()
  BYTE gap,offset,height,row

  gap=64
  offset=0
  height=63
  DO
    row=offset
    WHILE row<SCENE.HEIGHT
    DO
      TraceLine(row)
      ShowSpan(row,height)
      row==+gap
    OD

    IF offset=0 THEN
      offset=gap RSH 1
      height=offset-1
    ELSE
      gap=gap RSH 1
      IF gap<=1 THEN EXIT FI
      offset=gap RSH 1
      height=offset-1
    FI
  OD
RETURN

PROC Main()
  SYS.Graphics(0)
  SYS.PrintE(rendering)
  IF VIDEO.Init()=0 THEN
    SYS.PrintE(missing)
    SYS.PrintE(keyText)
    AnimateUntilKey()
    RETURN
  FI

  COLORS.Install()
  GTIA.COLBAK=0
  OS.COLOR4=0
  Render()
  AnimateUntilKey()
  VIDEO.Shutdown()
  SYS.Graphics(0)
RETURN

ENDMODULE
