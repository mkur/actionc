; Progressive VBXE ray tracer based on the Atari BASIC ten-liner.
;
; Compile with:
;   actionc --profile modern --runtime standalone samples/vbxe/raytracer.act
MODULE VBXE_RAYTRACER

USE ATARI.GTIA
USE ATARI.OS
USE RAY
USE SCREEN AS VIDEO
USE SYS

CONST CARD OUTPUT_WIDTH=320

CONST BYTE LAST_ROW=191

BYTE ARRAY line(OUTPUT_WIDTH)

STRING missing(0)="VBXE FX 1.2x is required."
STRING rendering(0)="Rendering the VBXE ray tracer..."
STRING keyText(0)="Press any key to continue."

PROC WaitKey()
  OS.CH=OS.NO_KEY
  WHILE OS.CH=OS.NO_KEY
  DO
  OD
RETURN

PROC TraceLine(BYTE row)
  BYTE shade
  CARD col

  col=0
  WHILE col<RAY.WIDTH
  DO
    shade=RAY.Trace(col,row)
    line(col)=shade
    col==+1
  OD
RETURN

PROC CopyLine(BYTE row)
  CARD x
  BYTE POINTER destination

  destination=VIDEO.RowAddress(row)
  x=0
  WHILE x<OUTPUT_WIDTH
  DO
    destination(x)=line(x)
    x==+1
  OD
RETURN

PROC ShowSpan(BYTE sourceRow,height)
  BYTE firstRow,lastRow,row

  lastRow=LAST_ROW-sourceRow
  firstRow=lastRow-height
  row=firstRow
  WHILE row<=lastRow
  DO
    CopyLine(row)
    row==+1
  OD
RETURN

PROC Render()
  BYTE gap,offset,height,row

  gap=64
  offset=0
  height=63
  DO
    row=offset
    WHILE row<RAY.HEIGHT
    DO
      TraceLine(row)
      ShowSpan(row,height)
      row==+gap
    OD

    IF offset=0 THEN
      ; The first refinement samples the midpoint of each 64-row span.
      offset=gap RSH 1
      height=offset-1
    ELSE
      gap=gap RSH 1
      IF gap<=1 THEN
        EXIT
      FI
      offset=gap RSH 1
      height=offset-1
    FI
  OD
RETURN

PROC Main()
  SYS.Graphics(0)
  SYS.PrintE(rendering)
  IF VIDEO.Init()=0 THEN
    SYS.PrintE(missing)
    SYS.PrintE(keyText)
    WaitKey()
    RETURN
  FI

  GTIA.COLBAK=0
  OS.COLOR4=0
  Render()
  WaitKey()
  VIDEO.Shutdown()
  SYS.Graphics(0)
RETURN

ENDMODULE
