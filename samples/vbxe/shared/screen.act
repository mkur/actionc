; Small SR320 framebuffer layer shared by the VBXE graphics samples.
;
; The 320x192 framebuffer has a 512-byte stride. Twelve 8KB VBXE banks each
; contain 16 rows, which keeps every mapped scanline inside the $A000-$BFFF
; MEMAC window. Programs using this layer must keep code and data below $A000.
MODULE SHARED.SCREEN

USE ATARI.PIA
USE ATARI.VBXE

PUBLIC CONST CARD WIDTH=320,
                  STRIDE=$0200,
                  WINDOW_BASE=$A000,
                  WINDOW_SIZE=$2000,
                  FRAMEBUFFER_LOCAL_BASE=$4000

PUBLIC CONST BYTE HEIGHT=192,
                  BAND_ROWS=16,
                  BAND_MASK=$0F,
                  BAND_COUNT=12

CONST BYTE XDL_BANK=$00,
           FRAMEBUFFER_FIRST_BANK=$04,
           MEMAC_CONTROL_VALUE=$A9,
           BASIC_ROM_DISABLE=$02,
           TOP_MARGIN_REPEAT=23,
           DISPLAY_REPEAT=191,
           BOTTOM_MARGIN_REPEAT=23,
           NO_BANK=$FF

BYTE ARRAY Window(8192)=WINDOW_BASE
BYTE currentBank,savedPortB

PROC MapLocal(BYTE bank)
  IF currentBank=bank THEN
    RETURN
  FI
  VBXE.Write(VBXE.REG_MEMAC_CONTROL,MEMAC_CONTROL_VALUE)
  VBXE.Write(VBXE.REG_MEMAC_BANK_SEL,VBXE.MEMAC_BANK_ENABLE%bank)
  currentBank=bank
RETURN

PROC Unmap()
  VBXE.Write(VBXE.REG_MEMAC_BANK_SEL,0)
  VBXE.Write(VBXE.REG_MEMAC_CONTROL,0)
  currentBank=NO_BANK
RETURN

PROC BuildXdl()
  MapLocal(XDL_BANK)

  ; Disable the overlay for the 24-line top margin.
  Window(0)=VBXE.XDLC_OVERLAY_OFF%VBXE.XDLC_REPEAT
  Window(1)=0
  Window(2)=TOP_MARGIN_REPEAT

  ; Display 192 SR320 rows from local address $04000 with a 512-byte stride.
  Window(3)=VBXE.XDLC_GRAPHICS%VBXE.XDLC_REPEAT%VBXE.XDLC_OVERLAY_ADDRESS
  Window(4)=VBXE.XDLC_STANDARD_RES%VBXE.XDLC_OVERLAY_ATTRIBUTES
  Window(5)=DISPLAY_REPEAT
  Window(6)=0
  Window(7)=$40
  Window(8)=0
  Window(9)=0
  Window(10)=2
  Window(11)=$11 ; overlay palette 1, normal width
  Window(12)=VBXE.OVERLAY_PRIORITY_ALL

  ; Disable the overlay for the remaining 24 lines and terminate the XDL.
  Window(13)=VBXE.XDLC_OVERLAY_OFF%VBXE.XDLC_REPEAT
  Window(14)=VBXE.XDLC_END
  Window(15)=BOTTOM_MARGIN_REPEAT
RETURN

BYTE FUNC Blend(BYTE lo,hi,pos,span)
  CARD value

  value=hi
  value=value-lo
  value=value*pos
  value=value/span
RETURN(lo+BYTE(value))

PROC SetSteelPalette()
  BYTE color,pos,red,green,blue

  VBXE.Write(VBXE.REG_PSEL,VBXE.PALETTE_1)
  VBXE.Write(VBXE.REG_CSEL,0)
  color=0
  DO
    IF color<64 THEN
      pos=color
      red=Blend(0,16,pos,64)
      green=Blend(4,29,pos,64)
      blue=Blend(10,42,pos,64)
    ELSEIF color<128 THEN
      pos=color-64
      red=Blend(16,78,pos,64)
      green=Blend(29,102,pos,64)
      blue=Blend(42,117,pos,64)
    ELSEIF color<192 THEN
      pos=color-128
      red=Blend(78,178,pos,64)
      green=Blend(102,195,pos,64)
      blue=Blend(117,204,pos,64)
    ELSE
      pos=color-192
      red=Blend(178,255,pos,63)
      green=Blend(195,255,pos,63)
      blue=Blend(204,255,pos,63)
    FI

    VBXE.Write(VBXE.REG_CR,red)
    VBXE.Write(VBXE.REG_CG,green)
    VBXE.Write(VBXE.REG_CB,blue)
    color==+1
  UNTIL color=0
  OD
RETURN

PUBLIC PROC MapBand(BYTE band)
  BYTE localBank

  localBank=FRAMEBUFFER_FIRST_BANK+(band LSH 1)
  MapLocal(localBank)
RETURN

PUBLIC CARD FUNC RowAddress(BYTE y)
  BYTE band,row
  CARD offset

  band=y RSH 4
  row=y&BAND_MASK
  MapBand(band)
  offset=row
  offset=offset LSH 9
RETURN(WINDOW_BASE+offset)

PUBLIC PROC FillRow(BYTE y,value)
  CARD x
  BYTE POINTER row

  row=RowAddress(y)
  x=0
  WHILE x<WIDTH
  DO
    row(x)=value
    x==+1
  OD
RETURN

PUBLIC PROC Clear()
  BYTE band
  CARD offset

  band=0
  WHILE band<BAND_COUNT
  DO
    MapBand(band)
    offset=0
    WHILE offset<WINDOW_SIZE
    DO
      Window(offset)=0
      offset==+1
    OD
    band==+1
  OD
RETURN

PUBLIC BYTE FUNC Init()
  currentBank=NO_BANK
  IF VBXE.Detect()=VBXE.NO_VBXE THEN
    RETURN(0)
  FI
  IF VBXE.Is20Family()=0 THEN
    RETURN(0)
  FI

  ; MEMAC has lower bus priority than the built-in BASIC ROM. Altirra keeps
  ; BASIC enabled when an XEX does not itself load into $A000-$BFFF, so expose
  ; RAM in that range before selecting the VBXE window there.
  savedPortB=PIA.PORTB
  PIA.PORTB=savedPortB%BASIC_ROM_DISABLE

  VBXE.Write(VBXE.REG_VIDEO_CONTROL,0)
  BuildXdl()
  SetSteelPalette()
  Clear()

  VBXE.Write(VBXE.REG_XDL_ADR0,0)
  VBXE.Write(VBXE.REG_XDL_ADR1,0)
  VBXE.Write(VBXE.REG_XDL_ADR2,0)
  VBXE.Write(VBXE.REG_VIDEO_CONTROL,
             VBXE.VIDEO_XDL_ENABLE%VBXE.VIDEO_NO_TRANSPARENCY)
RETURN(1)

PUBLIC PROC Shutdown()
  VBXE.Write(VBXE.REG_VIDEO_CONTROL,0)
  Unmap()
  PIA.PORTB=savedPortB
RETURN

ENDMODULE
