; Cycling four-buffer unlimited-bobs showcase with a live bottom status line.
;
; The original, asymmetric braid, four-petal, and two-harmonic-orb paths run
; in sequence.  Each path receives a new random hue and a fresh set of four
; persistent bitmaps.  Palette-only fades hide buffer clearing between paths.
;
; Ten shaded software sprites are added to one persistent bitmap per frame.
; The four bitmaps are displayed in rotation, so every bitmap contains one
; phase of the same growing trail.  Old bobs are never erased or redrawn.
;
; The foreground owns all rendering.  A short immediate-VBI routine only
; publishes a completed display list, so a slow frame repeats safely instead
; of exposing a bitmap while it is being changed.
;
; Press any key to restore the previous display.
; Compile with --runtime standalone. ORG keeps code above the screen buffers.
; ANIMATION_SECONDS is the total slot length; FADE_SECONDS is included at both
; ends of that slot. Timing follows the OS clock on both PAL and NTSC systems.
;
; Memory map (inclusive ranges):
; $1010-$2E0F  screen0  7,680-byte ANTIC mode-E bitmap
; $3010-$4E0F  screen1  7,680-byte ANTIC mode-E bitmap
; $5010-$6E0F  screen2  7,680-byte ANTIC mode-E bitmap
; $7010-$8E0F  screen3  7,680-byte ANTIC mode-E bitmap
; $9000-$93FF  dlist0   1 KiB display-list window
; $9400-$97FF  dlist1   1 KiB display-list window
; $9800-$9BFF  dlist2   1 KiB display-list window
; $9C00-$9FFF  dlist3   1 KiB display-list window
; $A000-...    program data, generated code, and standalone runtime
;
; Each bitmap sits in its own $2000-byte window.  The four display-list
; windows end immediately below the source-controlled program origin.

ORG $A000

MODULE UNLIMITED_BOBS_COMBINED_STATUS

USE SYS
USE ATARI.ANTIC
USE ATARI.GTIA
USE ATARI.OS
USE ATARI.POKEY

CONST BYTE SCREEN_BYTES=40,
           SCREEN_HEIGHT=192,
           TOP_BLANK_ROWS=3,
           SECOND_LMS_ROW=102,
           BOB_WIDTH_BYTES=3,
           BOB_HEIGHT=16,
           BOBS_PER_FRAME=10,
           FIRST_RENDER_BUFFER=1,
           STATUS_WIDTH=40,
           STATUS_ANIMATION_DIGIT=17,
           STATUS_BOBS_FIRST_DIGIT=30,
           SCREEN_ZERO=$10,
           STATUS_TEXT_COLOR=$0E,
           STATUS_BACKGROUND_COLOR=$00,
           ANIMATION_SECONDS=20,
           FADE_SECONDS=1,
           EFFECT_COUNT=4,
           EFFECT_ORIGINAL=0,
           EFFECT_ASYMMETRIC_BRAID=1,
           EFFECT_FOUR_PETAL=2,
           EFFECT_TWO_HARMONIC_ORB=3,
           SPRITE_BYTES=BOB_WIDTH_BYTES*BOB_HEIGHT,
           SPRITE_VARIANTS=4,
           SPRITE_VARIANT_STRIDE=64,
           BOB_DARK_LUMA=$04,
           BOB_MIDDLE_LUMA=$08,
           BOB_LIGHT_LUMA=$0C

CONST CARD SCREEN_SIZE=SCREEN_BYTES*SCREEN_HEIGHT,
           DLIST_SIZE=$400,
           ; ANTIC's playfield address counter wraps inside each 4 KiB bank.
           ; Starting 16 bytes into the bank leaves $0FF0=4080 bytes, exactly
           ; 102 rows at 40 bytes each.  Row 102 can therefore begin at the
           ; next bank boundary and the second LMS reloads it without a row
           ; crossing the boundary: $1010+102*40=$2000.
           SCREEN_0_BASE=$1010,
           SCREEN_1_BASE=$3010,
           SCREEN_2_BASE=$5010,
           SCREEN_3_BASE=$7010,
           DLIST_0_BASE=$9000,
           DLIST_1_BASE=$9400,
           DLIST_2_BASE=$9800,
           DLIST_3_BASE=$9C00

; The four 7,680-byte screens leave the conventional low-memory workspace and
; the program segment at $A000 untouched.
BYTE ARRAY screen0(SCREEN_SIZE)=SCREEN_0_BASE
BYTE ARRAY screen1(SCREEN_SIZE)=SCREEN_1_BASE
BYTE ARRAY screen2(SCREEN_SIZE)=SCREEN_2_BASE
BYTE ARRAY screen3(SCREEN_SIZE)=SCREEN_3_BASE

; The status row does not need the bitmaps' 4 KiB layout.  It lives in normal
; compiler-managed storage, and every display list loads its actual address.
; The foreground prepares changing digits and the VBI commits them without
; text tearing.
BYTE ARRAY status(STATUS_WIDTH)
VOLATILE BYTE statusAnimationCell=status+STATUS_ANIMATION_DIGIT,
              statusBobThousandsCell=status+STATUS_BOBS_FIRST_DIGIT,
              statusBobHundredsCell=status+STATUS_BOBS_FIRST_DIGIT+1,
              statusBobTensCell=status+STATUS_BOBS_FIRST_DIGIT+2,
              statusBobOnesCell=status+STATUS_BOBS_FIRST_DIGIT+3

; Each list is on a separate 1 KiB boundary.  The lists use only about 200
; bytes, but the fixed windows make their placement obvious and independent.
BYTE ARRAY dlist0(DLIST_SIZE)=DLIST_0_BASE
BYTE ARRAY dlist1(DLIST_SIZE)=DLIST_1_BASE
BYTE ARRAY dlist2(DLIST_SIZE)=DLIST_2_BASE
BYTE ARRAY dlist3(DLIST_SIZE)=DLIST_3_BASE

; Action strings store their length in element zero.  The following 40 bytes
; are emitted as ANTIC screen codes and copied verbatim into the status row.
CHAR ARRAY statusTemplate(STATUS_WIDTH+1)="\{SCREEN:      Animation #1/4    Bobs: 0000     }"

CARD ARRAY rowOffsets(SCREEN_HEIGHT)

; The buffers are rendered in a strict round-robin cycle and reset together,
; so the buffer being published always belongs to the same ten-bob generation.
; Keep that shared count directly as decimal screen codes, avoiding DIV and
; MOD helpers.  The ones digit is always SCREEN_ZERO.
BYTE bobThousands,bobHundreds,bobTens

; The unshifted 12 by 16 bob.  Pixel values 1, 2, and 3 select its dark,
; middle, and light playfield shades.  A mask value of 3 preserves a
; transparent two-bit pixel.
BYTE ARRAY bobMask(SPRITE_BYTES)=[
  $FC $3F $FF $F0 $0F $FF $C0 $03 $FF $C0 $03 $FF $00 $00 $FF $00
  $00 $FF $00 $00 $FF $00 $00 $FF $00 $00 $FF $00 $00 $FF $00 $00
  $FF $C0 $03 $FF $C0 $03 $FF $F0 $0F $FF $FC $3F $FF $FF $FF $FF]

BYTE ARRAY bobPixels(SPRITE_BYTES)=[
  $01 $40 $00 $06 $90 $00 $1B $E4 $00 $2F $A4 $00 $7E $95 $00 $6E
  $65 $00 $BA $51 $00 $69 $95 $00 $96 $51 $00 $65 $51 $00 $59 $41
  $00 $15 $44 $00 $15 $04 $00 $04 $10 $00 $01 $40 $00 $00 $00 $00]

; The effect selects a pre-shifted variant with x AND 3, avoiding shifts in
; the per-bob compositor.  Each variant occupies a 64-byte slot although only
; its first 48 bytes contain image data.
BYTE ARRAY shiftedMasks(SPRITE_VARIANTS*SPRITE_VARIANT_STRIDE)
BYTE ARRAY shiftedPixels(SPRITE_VARIANTS*SPRITE_VARIANT_STRIDE)

; Two unsigned sine cycles with different amplitudes.  Adding two X samples
; gives 0..148; adding two Y samples gives 0..176.  The 12 by 16 bob therefore
; always remains inside the 160 by 192 bitmap.
BYTE ARRAY sineX(256)=[
  $25 $25 $26 $27 $28 $29 $2A $2B $2C $2D $2D $2E $2F $30 $31 $32
  $33 $33 $34 $35 $36 $37 $38 $38 $39 $3A $3B $3B $3C $3D $3D $3E
  $3F $3F $40 $41 $41 $42 $42 $43 $43 $44 $44 $45 $45 $46 $46 $46
  $47 $47 $47 $48 $48 $48 $48 $49 $49 $49 $49 $49 $49 $49 $49 $49
  $4A $49 $49 $49 $49 $49 $49 $49 $49 $49 $48 $48 $48 $48 $47 $47
  $47 $46 $46 $46 $45 $45 $44 $44 $43 $43 $42 $42 $41 $41 $40 $3F
  $3F $3E $3D $3D $3C $3B $3B $3A $39 $38 $38 $37 $36 $35 $34 $34
  $33 $32 $31 $30 $2F $2E $2E $2D $2C $2B $2A $29 $28 $27 $26 $25
  $25 $24 $23 $22 $21 $20 $1F $1E $1D $1C $1C $1B $1A $19 $18 $17
  $16 $16 $15 $14 $13 $12 $12 $11 $10 $0F $0F $0E $0D $0C $0C $0B
  $0A $0A $09 $09 $08 $07 $07 $06 $06 $05 $05 $04 $04 $03 $03 $03
  $02 $02 $02 $01 $01 $01 $01 $00 $00 $00 $00 $00 $00 $00 $00 $00
  $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $01 $01 $01 $01 $02 $02
  $02 $03 $03 $03 $04 $04 $05 $05 $06 $06 $07 $07 $08 $08 $09 $0A
  $0A $0B $0C $0C $0D $0E $0E $0F $10 $11 $11 $12 $13 $14 $15 $15
  $16 $17 $18 $19 $1A $1B $1B $1C $1D $1E $1F $20 $21 $22 $23 $23]

BYTE ARRAY sineY(256)=[
  $2C $2D $2E $2F $30 $31 $32 $34 $35 $36 $37 $38 $39 $3A $3B $3C
  $3D $3E $3F $40 $41 $42 $43 $44 $44 $45 $46 $47 $48 $49 $4A $4A
  $4B $4C $4D $4D $4E $4F $4F $50 $51 $51 $52 $52 $53 $53 $54 $54
  $55 $55 $55 $56 $56 $56 $57 $57 $57 $57 $58 $58 $58 $58 $58 $58
  $58 $58 $58 $58 $58 $58 $58 $57 $57 $57 $57 $56 $56 $56 $55 $55
  $55 $54 $54 $53 $53 $52 $52 $51 $51 $50 $4F $4F $4E $4D $4D $4C
  $4B $4A $4A $49 $48 $47 $46 $45 $44 $44 $43 $42 $41 $40 $3F $3E
  $3D $3C $3B $3A $39 $38 $37 $36 $35 $34 $33 $31 $30 $2F $2E $2D
  $2C $2B $2A $29 $28 $27 $26 $25 $23 $22 $21 $20 $1F $1E $1D $1C
  $1B $1A $19 $18 $17 $16 $15 $15 $14 $13 $12 $11 $10 $0F $0F $0E
  $0D $0C $0B $0B $0A $09 $09 $08 $07 $07 $06 $06 $05 $05 $04 $04
  $03 $03 $03 $02 $02 $02 $01 $01 $01 $01 $00 $00 $00 $00 $00 $00
  $00 $00 $00 $00 $00 $00 $00 $01 $01 $01 $01 $02 $02 $02 $03 $03
  $03 $04 $04 $05 $05 $06 $06 $07 $07 $08 $09 $09 $0A $0B $0B $0C
  $0D $0E $0E $0F $10 $11 $12 $13 $13 $14 $15 $16 $17 $18 $19 $1A
  $1B $1C $1D $1E $1F $20 $21 $22 $23 $24 $25 $26 $28 $29 $2A $2B]

; One packed record describes the complete path generator state for an effect.
; Keeping the four parameter sets in one table makes adding or reordering an
; effect a data change; SelectEffect only copies the selected record's fields.
TYPE EffectParams=[
  BYTE phaseXA,phaseXB,phaseYA,phaseYB,
       bobStepXA,bobStepXB,bobStepYA,bobStepYB,
       frameStepXA,frameStepXB,frameStepYA,frameStepYB]

EffectParams ARRAY effectTable(EFFECT_COUNT)=[
  ; Original: independent equal-step phases make the broad woven orbit.
  $30 $B2 $F2 $69  $19 $19 $19 $19  $01 $02 $02 $01
  ; Asymmetric braid: a precessing 1:2 pinwheel.
  $00 $00 $40 $C0  $19 $32 $19 $32  $01 $03 $01 $03
  ; Four-petal: a slowly rotating counter-directional 1:-3 clover.
  $00 $00 $40 $40  $19 $B5 $19 $B5  $01 $FE $01 $FE
  ; Two-harmonic orb: a co-rotating 1:2 woven shell.
  $00 $00 $40 $40  $19 $32 $19 $32  $01 $03 $01 $03]

; Runtime path parameters copied from the selected table entry.
BYTE currentEffect,phaseXA,phaseXB,phaseYA,phaseYB,
     bobStepXA,bobStepXB,bobStepYA,bobStepYB,
     frameStepXA,frameStepXB,frameStepYA,frameStepYB

; Foreground-to-VBI handoff.  pendingDList is written completely before
; frameReady becomes nonzero, so the interrupt never sees a partial pointer.
VOLATILE CARD pendingDList
VOLATILE BYTE frameReady,pendingColor0,pendingColor1,pendingColor2,
              pendingAnimationDigit,pendingBobThousands,pendingBobHundreds,
              pendingBobTens,pendingBobOnes

VOLATILE CARD immediateVbiVector=$0222

CARD savedDList,savedImmediateVbi,savedDliVector
CARD bobDestination
BYTE savedDmaControl,savedPriority,savedCharBase,
     savedColor0,savedColor1,savedColor2,savedColor3,savedColor4
BYTE bobHue,bobSpriteIndex,bobRows


PROC BuildRowOffsets()
  CARD offset
  BYTE row

  offset=0
  row=0
  WHILE row<SCREEN_HEIGHT DO
    rowOffsets(row)=offset
    offset==+SCREEN_BYTES
    row==+1
  OD
RETURN


PROC BuildShiftedBobs()
  BYTE variant,index,sourceBase,targetBase,
       value,maskCarry,pixelCarry

  SYS.SetBlock(shiftedMasks,SPRITE_VARIANTS*SPRITE_VARIANT_STRIDE,$FF)
  SYS.Zero(shiftedPixels,SPRITE_VARIANTS*SPRITE_VARIANT_STRIDE)

  index=0
  WHILE index<SPRITE_BYTES DO
    shiftedMasks(index)=bobMask(index)
    shiftedPixels(index)=bobPixels(index)
    index==+1
  OD

  variant=1
  WHILE variant<SPRITE_VARIANTS DO
    sourceBase=(variant-1) LSH 6
    targetBase=variant LSH 6
    maskCarry=$C0
    pixelCarry=0
    index=0

    WHILE index<SPRITE_BYTES DO
      value=shiftedMasks(sourceBase+index)
      shiftedMasks(targetBase+index)=(value RSH 2) OR maskCarry
      maskCarry=(value AND 3) LSH 6

      value=shiftedPixels(sourceBase+index)
      shiftedPixels(targetBase+index)=(value RSH 2) OR pixelCarry
      pixelCarry=(value AND 3) LSH 6
      index==+1
    OD
    variant==+1
  OD
RETURN


PROC BuildDList(BYTE ARRAY dl,CARD screenBase,listBase)
  CARD pos,screenAddress
  BYTE row,blank

  pos=0
  blank=0
  WHILE blank<TOP_BLANK_ROWS DO
    dl(pos)=ANTIC.BLANK_8
    pos==+1
    blank==+1
  OD

  screenAddress=screenBase
  row=0
  WHILE row<SCREEN_HEIGHT DO
    IF row=0 OR row=SECOND_LMS_ROW THEN
      dl(pos)=ANTIC.MODE_E+ANTIC.DL_LMS
      pos==+1
      dl(pos)=screenAddress
      pos==+1
      dl(pos)=screenAddress RSH 8
      pos==+1
    ELSEIF row=SCREEN_HEIGHT-1 THEN
      ; This DLI finishes the graphics palette and establishes the status
      ; palette on the first scanline of the following mode-2 row.
      dl(pos)=ANTIC.MODE_E+ANTIC.DL_DLI
      pos==+1
    ELSE
      dl(pos)=ANTIC.MODE_E
      pos==+1
    FI

    screenAddress==+SCREEN_BYTES
    row==+1
  OD

  dl(pos)=ANTIC.MODE_2+ANTIC.DL_LMS
  pos==+1
  dl(pos)=status
  pos==+1
  dl(pos)=status RSH 8
  pos==+1

  dl(pos)=ANTIC.JVB
  pos==+1
  dl(pos)=listBase
  pos==+1
  dl(pos)=listBase RSH 8
RETURN


PROC BuildDisplayLists()
  BuildDList(dlist0,SCREEN_0_BASE,DLIST_0_BASE)
  BuildDList(dlist1,SCREEN_1_BASE,DLIST_1_BASE)
  BuildDList(dlist2,SCREEN_2_BASE,DLIST_2_BASE)
  BuildDList(dlist3,SCREEN_3_BASE,DLIST_3_BASE)
RETURN


PROC ClearScreens()
  SYS.Zero(screen0,SCREEN_SIZE)
  SYS.Zero(screen1,SCREEN_SIZE)
  SYS.Zero(screen2,SCREEN_SIZE)
  SYS.Zero(screen3,SCREEN_SIZE)
RETURN


PROC WriteStatusLabel()
  SYS.MoveBlock(status,BYTE POINTER(statusTemplate+1),STATUS_WIDTH)
RETURN


PROC ResetBobCount()
  bobThousands=SCREEN_ZERO
  bobHundreds=SCREEN_ZERO
  bobTens=SCREEN_ZERO
RETURN


CARD FUNC ScreenAddress(BYTE buffer)
  CARD address

  IF buffer=0 THEN
    address=SCREEN_0_BASE
  ELSEIF buffer=1 THEN
    address=SCREEN_1_BASE
  ELSEIF buffer=2 THEN
    address=SCREEN_2_BASE
  ELSE
    address=SCREEN_3_BASE
  FI
RETURN(address)


PROC AdvanceBobCount()
  bobTens==+1
  IF bobTens=SCREEN_ZERO+10 THEN
    bobTens=SCREEN_ZERO
    bobHundreds==+1
    IF bobHundreds=SCREEN_ZERO+10 THEN
      bobHundreds=SCREEN_ZERO
      bobThousands==+1
      IF bobThousands=SCREEN_ZERO+10 THEN
        bobThousands=SCREEN_ZERO
      FI
    FI
  FI
RETURN


PROC PrepareStatusLine(BYTE effect)
  pendingAnimationDigit=SCREEN_ZERO+effect+1
  pendingBobThousands=bobThousands
  pendingBobHundreds=bobHundreds
  pendingBobTens=bobTens
  pendingBobOnes=SCREEN_ZERO
RETURN


CARD FUNC DisplayListAddress(BYTE buffer)
  CARD address

  IF buffer=0 THEN
    address=DLIST_0_BASE
  ELSEIF buffer=1 THEN
    address=DLIST_1_BASE
  ELSEIF buffer=2 THEN
    address=DLIST_2_BASE
  ELSE
    address=DLIST_3_BASE
  FI
RETURN(address)


; This is the only assembly rendering code.  Action! computes the destination
; and shifted-sprite index; the kernel performs the measured hot operation:
; merge three bytes, move down one 40-byte scan line, repeat sixteen times.
; Its two absolute operands are patched because that is substantially faster
; on a 6502 than repeatedly setting up an indirect pointer.
PROC CompositeBob=*()
ASM
    lda bobDestination
    sta compositeRead+1
    sta compositeWrite+1
    lda bobDestination+1
    sta compositeRead+2
    sta compositeWrite+2

    ldx bobSpriteIndex
    lda #16
    sta bobRows

compositeRow:
    ldy #0
compositeColumn:
compositeRead:
    lda $FFFF,y
    and shiftedMasks,x
    ora shiftedPixels,x
compositeWrite:
    sta $FFFF,y
    inx
    iny
    cpy #3
    bne compositeColumn

    clc
    lda compositeRead+1
    adc #40
    sta compositeRead+1
    sta compositeWrite+1
    bcc compositeNextRow
    inc compositeRead+2
    inc compositeWrite+2

compositeNextRow:
    dec bobRows
    bne compositeRow
    rts
ENDASM


PROC StampBob(CARD screenBase BYTE x,y)
  bobDestination=screenBase+rowOffsets(y)+(x RSH 2)
  bobSpriteIndex=(x AND 3) LSH 6
  CompositeBob()
RETURN


PROC DrawFrame(BYTE buffer)
  BYTE bob,x,y,localXA,localXB,localYA,localYB
  CARD screenBase

  screenBase=ScreenAddress(buffer)
  localXA=phaseXA
  localXB=phaseXB
  localYA=phaseYA
  localYB=phaseYB
  bob=0

  WHILE bob<BOBS_PER_FRAME DO
    x=sineX(localXA)+sineX(localXB)
    y=sineY(localYA)+sineY(localYB)
    StampBob(screenBase,x,y)

    localXA==+bobStepXA
    localXB==+bobStepXB
    localYA==+bobStepYA
    localYB==+bobStepYB
    bob==+1
  OD

  ; FIRST_RENDER_BUFFER begins each four-buffer generation.  Advance the
  ; shared count once, then publish that value with every buffer in the cycle.
  IF buffer=FIRST_RENDER_BUFFER THEN AdvanceBobCount() FI
  PrepareStatusLine(currentEffect)

  phaseXA==+frameStepXA
  phaseXB==+frameStepXB
  phaseYA==+frameStepYA
  phaseYB==+frameStepYB
RETURN


; The DLI is requested by the final mode-E row.  It arrives near that row's
; end; WSYNC moves both color changes to the first scanline of the status row.
PROC StatusDli=*()
ASM OPAQUE
    pha
    lda #STATUS_BACKGROUND_COLOR
    sta ANTIC.WSYNC
    sta GTIA.COLBAK
    sta GTIA.COLPF2
    lda #STATUS_TEXT_COLOR
    sta GTIA.COLPF1
    pla
    rti
ENDASM


PROC FrameVbi=*()
ASM
    lda frameReady
    beq frameVbiDone

    ; Update both the OS shadow and ANTIC's live pointer.  Low-byte-first
    ; stores match the hardware DLIST register pair.
    lda pendingDList
    sta OS.SDLST
    sta ANTIC.DLIST
    lda pendingDList+1
    sta OS.SDLST+1
    sta ANTIC.DLIST+1

    ; Commit the fade palette at the same VBI boundary as the bitmap.
    lda pendingColor0
    sta OS.COLOR0
    sta GTIA.COLPF0
    lda pendingColor1
    sta OS.COLOR1
    sta GTIA.COLPF1
    lda pendingColor2
    sta OS.COLOR2
    sta GTIA.COLPF2

    ; Every display list shares one status row.  Commit its prepared digits
    ; during VBI so ANTIC never fetches a partly updated counter.
    lda pendingAnimationDigit
    sta statusAnimationCell
    lda pendingBobThousands
    sta statusBobThousandsCell
    lda pendingBobHundreds
    sta statusBobHundredsCell
    lda pendingBobTens
    sta statusBobTensCell
    lda pendingBobOnes
    sta statusBobOnesCell

    lda #0
    sta frameReady

frameVbiDone:
    jmp $E45F          ; SYSVBV: continue the normal OS VBI
ENDASM


PROC InstallFrameVbi()
  savedImmediateVbi=immediateVbiVector
ASM
    lda #6
    ldx #>FrameVbi
    ldy #<FrameVbi
    jsr $E45C          ; SETVBV: install an immediate VBI
ENDASM
RETURN


PROC RestoreImmediateVbi()
ASM
    lda #6
    ldx savedImmediateVbi+1
    ldy savedImmediateVbi
    jsr $E45C
ENDASM
RETURN


PROC InstallStatusDli()
  ANTIC.NMIEN=ANTIC.NMI_VBI
  OS.VDSLST=StatusDli
  ANTIC.NMIRES=0
  ANTIC.NMIEN=ANTIC.NMI_VBI+ANTIC.NMI_DLI
RETURN


PROC RestoreStatusDli()
  ANTIC.NMIEN=ANTIC.NMI_VBI
  OS.VDSLST=savedDliVector
RETURN


PROC PublishFrame(BYTE buffer)
  pendingDList=DisplayListAddress(buffer)
  frameReady=1

  WHILE frameReady#0 DO
    OS.ATRACT=0
  OD
RETURN


PROC SaveDisplayState()
  savedDList=OS.SDLST
  savedDliVector=OS.VDSLST
  savedDmaControl=OS.SDMCTL
  savedPriority=OS.GPRIOR
  savedCharBase=OS.CHBAS
  savedColor0=OS.COLOR0
  savedColor1=OS.COLOR1
  savedColor2=OS.COLOR2
  savedColor3=OS.COLOR3
  savedColor4=OS.COLOR4
RETURN


PROC StopDisplay()
  OS.SDMCTL=0
  ANTIC.DMACTL=0
RETURN


PROC SelectRandomHue()
  bobHue=POKEY.RANDOM AND GTIA.COLOR_HUE_MASK
  IF bobHue=0 THEN bobHue=$10 FI
RETURN


PROC SetBobLuminance(BYTE light)
  BYTE dark,middle

  dark=light
  IF dark>BOB_DARK_LUMA THEN dark=BOB_DARK_LUMA FI
  middle=light
  IF middle>BOB_MIDDLE_LUMA THEN middle=BOB_MIDDLE_LUMA FI

  pendingColor0=bobHue+dark
  pendingColor1=bobHue+middle
  pendingColor2=bobHue+light
RETURN


PROC StartBobDisplay()
  pendingColor0=0
  pendingColor1=0
  pendingColor2=0

  OS.SDLST=DLIST_0_BASE
  ANTIC.DLIST=DLIST_0_BASE
  OS.GPRIOR=0
  GTIA.PRIOR=0
  OS.CHBAS=$E0
  ANTIC.CHBASE=$E0

  OS.COLOR0=0
  OS.COLOR1=0
  OS.COLOR2=0
  OS.COLOR3=0
  OS.COLOR4=0
  GTIA.COLPF0=0
  GTIA.COLPF1=0
  GTIA.COLPF2=0
  GTIA.COLPF3=0
  GTIA.COLBAK=0

  OS.SDMCTL=ANTIC.NORMAL_PLAYFIELD_DMA
  ANTIC.DMACTL=ANTIC.NORMAL_PLAYFIELD_DMA
RETURN


PROC RestoreDisplayState()
  StopDisplay()
  OS.SDLST=savedDList
  ANTIC.DLIST=savedDList
  OS.GPRIOR=savedPriority
  GTIA.PRIOR=savedPriority
  OS.CHBAS=savedCharBase
  ANTIC.CHBASE=savedCharBase

  OS.COLOR0=savedColor0
  OS.COLOR1=savedColor1
  OS.COLOR2=savedColor2
  OS.COLOR3=savedColor3
  OS.COLOR4=savedColor4
  GTIA.COLPF0=savedColor0
  GTIA.COLPF1=savedColor1
  GTIA.COLPF2=savedColor2
  GTIA.COLPF3=savedColor3
  GTIA.COLBAK=savedColor4

  OS.SDMCTL=savedDmaControl
  ANTIC.DMACTL=savedDmaControl
  ANTIC.NMIRES=0
  ANTIC.NMIEN=ANTIC.NMI_VBI+ANTIC.NMI_DLI
RETURN


PROC SelectEffect(BYTE effect)
  phaseXA=effectTable(effect).phaseXA
  phaseXB=effectTable(effect).phaseXB
  phaseYA=effectTable(effect).phaseYA
  phaseYB=effectTable(effect).phaseYB
  bobStepXA=effectTable(effect).bobStepXA
  bobStepXB=effectTable(effect).bobStepXB
  bobStepYA=effectTable(effect).bobStepYA
  bobStepYB=effectTable(effect).bobStepYB
  frameStepXA=effectTable(effect).frameStepXA
  frameStepXB=effectTable(effect).frameStepXB
  frameStepYA=effectTable(effect).frameStepYA
  frameStepYB=effectTable(effect).frameStepYB
RETURN


CARD FUNC ReadClock16()
  BYTE middle,low

  DO
    middle=OS.RTCLOK_MID
    low=OS.RTCLOK_LO
  UNTIL middle=OS.RTCLOK_MID
  OD
RETURN((CARD(middle) LSH 8)+low)


PROC UpdateFade(CARD elapsed,effectTicks,fadeTicks)
  CARD scaled
  BYTE light

  IF elapsed<fadeTicks THEN
    scaled=elapsed*BOB_LIGHT_LUMA
    light=BYTE(scaled/fadeTicks)
  ELSEIF elapsed>=effectTicks-fadeTicks THEN
    scaled=(effectTicks-elapsed)*BOB_LIGHT_LUMA
    light=BYTE(scaled/fadeTicks)
  ELSE
    light=BOB_LIGHT_LUMA
  FI

  ; Atari playfield luminance uses the even low-nibble values 0..14.
  SetBobLuminance(light AND GTIA.COLOR_LUMINANCE_MASK)
RETURN


PROC InitBobs()
  pendingDList=DLIST_0_BASE
  frameReady=0

  BuildRowOffsets()
  BuildShiftedBobs()
  BuildDisplayLists()
  ClearScreens()
  WriteStatusLabel()
  ResetBobCount()
  PrepareStatusLine(EFFECT_ORIGINAL)
RETURN


PROC RunAnimation()
  BYTE buffer,ticksPerSecond
  CARD startTick,elapsed,effectTicks,fadeTicks

  buffer=FIRST_RENDER_BUFFER
  ticksPerSecond=60
  IF GTIA.PAL=GTIA.TV_PAL THEN ticksPerSecond=50 FI

  effectTicks=CARD(ANIMATION_SECONDS)*ticksPerSecond
  fadeTicks=CARD(FADE_SECONDS)*ticksPerSecond
  IF fadeTicks>(effectTicks RSH 1) THEN fadeTicks=effectTicks RSH 1 FI
  IF fadeTicks=0 THEN fadeTicks=1 FI

  startTick=ReadClock16()
  WHILE OS.CH=OS.NO_KEY DO
    elapsed=ReadClock16()-startTick
    IF elapsed>=effectTicks THEN EXIT FI

    UpdateFade(elapsed,effectTicks,fadeTicks)
    DrawFrame(buffer)
    PublishFrame(buffer)
    buffer=(buffer+1) AND 3
  OD

  ; Make the final transition fully black before clearing any bitmap.
  SetBobLuminance(0)
  PublishFrame(buffer)
RETURN


PROC RunBobs()
  BYTE effect

  effect=EFFECT_ORIGINAL
  OS.CH=OS.NO_KEY
  WHILE OS.CH=OS.NO_KEY DO
    SelectRandomHue()
    currentEffect=effect
    SelectEffect(effect)
    ClearScreens()
    ResetBobCount()
    RunAnimation()

    effect==+1
    IF effect=EFFECT_COUNT THEN effect=EFFECT_ORIGINAL FI
  OD
RETURN


PROC Main()
  SaveDisplayState()
  StopDisplay()
  InitBobs()
  InstallFrameVbi()
  InstallStatusDli()
  StartBobDisplay()
  RunBobs()
  RestoreImmediateVbi()
  RestoreStatusDli()
  RestoreDisplayState()
RETURN

ENDMODULE
