; One-line ANTIC mode 2 fine scroller.
;
; The display list enables horizontal fine scrolling for a single text
; line. An immediate vertical-blank routine advances HSCROL once per frame
; and advances the LMS address after one character width.

CARD sdlstl=$230       ; OS display-list shadow pointer

BYTE hscrol=$D404,     ; ANTIC horizontal fine-scroll register
     fine=[2],         ; first VBI follows the initial HSCROL=3 frame
     coarse=[0]

; Action strings keep their length in element zero. The remaining 150 bytes
; are ANTIC screen codes: 50 leading spaces, the 33-character message, and
; 67 trailing spaces. Both fetch windows at the loop boundary are blank.
CHAR ARRAY scrollText(151)="\{SCREEN:                                                  Hello from ACTIONC INLINE ASM!!!!                                                                   }"

; Three blank lines, Mode 2 + LMS + HSCROL, then a complete JVB. Both
; addresses are relocated into the static display list at compile time.
BYTE ARRAY dlist(9)=[$70 $70 $70 $52 <scrollText+1 >scrollText+1 $41 <dlist >dlist]


PROC FineScrollVbi=*()
ASM
    ; Apply this frame's fine-scroll value immediately. When fine has wrapped
    ; back to three, commit the coarse step queued by the preceding frame.
    ; This keeps HSCROL and the live LMS address in the same display state.
    lda fine
    sta hscrol
    cmp #3
    bne stepFine

    lda coarse
    beq stepFine
    ; This 150-byte buffer has enough trailing padding for the complete
    ; 48-byte ANTIC fetch window at offsets 102..149. The leading window
    ; is padding too, so the reset from offset 102 to zero is invisible.
    cmp #103
    bcc advance

    ; Restart the repeating message.
    lda #0
    sta coarse
    lda #<scrollText+1
    sta dlist+4
    lda #>scrollText+1
    sta dlist+5
    jmp stepFine

advance:
    inc dlist+4
    bne stepFine
    inc dlist+5

stepFine:
    ; A Mode 2 character is four color clocks wide. Decreasing HSCROL moves
    ; the window left by one color clock per frame. Wrapping queues the next
    ; coarse position; it is committed when fine=3 on the following VBI.
    dec fine
    bpl finish
    lda #3
    sta fine
    inc coarse

finish:
    jmp $E45F          ; SYSVBV: continue the normal OS VBI
ENDASM


PROC StartFineScroll()
  Graphics(0)

  ASM
    ; Publish the fully relocated custom list through the OS display-list
    ; shadow. Its LMS points directly at the static screen-code buffer.
    lda #<dlist
    sta sdlstl
    lda #>dlist
    sta sdlstl+1

    lda #3
    sta hscrol

    ; Install FineScrollVbi as the immediate VBI so HSCROL changes at the same
    ; stable point near the beginning of every vertical blank.
    lda #6
    ldx #>FineScrollVbi
    ldy #<FineScrollVbi
    jsr $E45C          ; SETVBV
  ENDASM
RETURN


PROC Main()
  StartFineScroll()

  ; The VBI owns the display until the machine is reset.
  DO
  OD
RETURN
