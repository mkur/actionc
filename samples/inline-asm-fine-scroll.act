; One-line ANTIC mode 2 fine scroller.
;
; The display list enables horizontal fine scrolling for a single text
; line. An immediate vertical-blank routine advances HSCROL once per frame
; and advances the LMS address after one character width.

CARD savmsc=$58,       ; OS screen-memory pointer
     sdlstl=$230       ; OS display-list shadow pointer

BYTE hscrol=$D404,     ; ANTIC horizontal fine-scroll register
     fine=[3],
     coarse=[0]

; Three blank lines, Mode 2 + LMS + HSCROL, then a complete JVB whose
; destination is relocated to the display list itself at compile time.
BYTE ARRAY dlist(9)=[$70 $70 $70 $52 0 0 $41 <dlist >dlist]


PROC FineScrollVbi=*()
ASM
    ; A Mode 2 character is four color clocks wide. Decreasing
    ; HSCROL moves the window left by one color clock per frame.
    dec fine
    bpl apply

    lda #3
    sta fine
    inc coarse
    lda coarse
    ; This 150-byte message has enough trailing padding for the complete
    ; 48-byte ANTIC fetch window at offsets 102..149. The leading window
    ; is padding too, so the reset from offset 102 to zero is invisible.
    cmp #103
    bcc advance

    ; Restart the repeating message.
    lda #0
    sta coarse
    lda savmsc
    sta dlist+4
    lda savmsc+1
    sta dlist+5
    jmp apply

advance:
    inc dlist+4
    bne apply
    inc dlist+5

apply:
    lda fine
    sta hscrol
    jmp $E45F          ; SYSVBV: continue the normal OS VBI
ENDASM


PROC StartFineScroll()
  Graphics(0)
  Print("                                           Hello from ACTIONC INLINE ASM!!!!                                                                   ")

  ASM
    ; Point the LMS instruction at the text written by Print.
    lda savmsc
    sta dlist+4
    lda savmsc+1
    sta dlist+5

    ; Publish the custom list through the OS display-list shadow. The JVB
    ; target is already complete in dlist's static initializer.
    lda #<dlist
    sta sdlstl
    lda #>dlist
    sta sdlstl+1

    lda #3
    sta hscrol

    ; Install FineScrollVbi as the immediate VBI so HSCROL changes at the same
    ; stable point near the beginning of every vertical blank.
    lda #6
    ldx #>FineScrollVbi
    ldy #<FineScrollVbi
    jsr $E45C          ; SETVBV
  ENDASM
RETURN


PROC Main()
  StartFineScroll()

  ; The VBI owns the display until the machine is reset.
  DO
  OD
RETURN
