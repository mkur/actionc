;
; IO.ACT - routines which implement advanced I/O functions.
; The device specifier is required in the file name string.
;
; Copyright (c) 1984 OSS, Inc.
;
; This maintained copy keeps Toolkit demos self-contained under samples/.

PROC Rename(BYTE ARRAY filename)
  XIO(5,0,32,0,0,filename)
RETURN

PROC Erase(BYTE ARRAY filename)
  XIO(5,0,33,0,0,filename)
RETURN

PROC Protect(BYTE ARRAY filename)
  XIO(5,0,35,0,0,filename)
RETURN

PROC UnProtect(BYTE ARRAY filename)
  XIO(5,0,36,0,0,filename)
RETURN

PROC Format(BYTE ARRAY driveSpec)
  XIO(5,0,254,0,0,driveSpec)
RETURN

; Burst I/O addresses an IOCB directly and invokes the operating-system CIO
; entry point. BGet and BPut retain the original Toolkit calling interface.
PROC CIO=$E456(BYTE areg,xreg)

CARD FUNC Burst(BYTE chan,mode CARD addr,buflen)
  TYPE IOCB=[BYTE id,num,cmd,stat
             CARD badr,padr,blen
             BYTE a1,a2,a3,a4,a5,a6]
  IOCB POINTER iptr

  chan==&$07
  iptr=$340+(chan LSH 4)
  iptr.cmd=mode
  iptr.blen=buflen
  iptr.badr=addr
  CIO(0,chan LSH 4)
RETURN(iptr.blen)

CARD FUNC BGet(BYTE chan CARD addr,len)
  CARD transferred

  transferred=Burst(chan,7,addr,len)
RETURN(transferred)

PROC BPut(BYTE chan CARD addr,len)
  Burst(chan,11,addr,len)
RETURN

MODULE
