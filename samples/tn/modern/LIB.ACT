
DEFINE nil  = "0",    
       true = "1",
       false = "0",
       EOL  = "155",
       ESC  = "27"

BYTE i=$E0,j=$E1,r0=$70
BYTE kx=$FF,ky=$FE

BYTE zx=$5A,zy=zx+1,zdx=zx+2,zdy=zx+3

SET $E=$E6
SET $F=$00
SET $491=$E6
SET $492=$00

BYTE POINTER screen
BYTE scl=screen,
     sch=screen+1
CARD POINTER allocp

SET $E=$2C00
SET $491=$2C00


PROC r_1=*()
ASM
  sta $86
  stx $87
  sec
  lda #$00
  sbc $86
  tay
  lda #$00
  sbc $87
  tax
  tya
  rts
ENDASM

PROC r_2=*()
ASM
  beq done
  dex
  stx $C1
  tax
  beq done
  stx $C0
  lda #$00
  ldx #$08
loop:
  asl a
  asl $C0
  bcc no_add
  adc $C1
no_add:
  dex
  bne loop
  clc
  adc $87
  sta $87
done:
  lda $86
  ldx $87
  rts
ENDASM

PROC r_3=*()
ASM
  stx $C2
  cpx #$00
  bpl x_positive
  jsr r_1
x_positive:
  sta $82
  stx $83
  lda $85
  bpl y_positive
  tax
  eor $C2
  sta $C2
  lda $84
  jsr r_1
  sta $84
  stx $85
y_positive:
  lda #$00
  sta $87
  rts
ENDASM

PROC r_Mul=*()
ASM
  jsr r_3
  ldx $82
  beq multiply_done
  stx $C0
  ldx $84
  beq multiply_done
  dex
  stx $C1
  ldx #$08
multiply_loop:
  asl a
  rol $87
  asl $C0
  bcc no_add
  adc $C1
  bcc no_add
  inc $87
no_add:
  dex
  bne multiply_loop
multiply_done:
  sta $86
  lda $82
  ldx $85
  jsr r_2
  lda $83
  ldx $84
  jsr r_2
  ldy $C2
  bpl positive
  jmp r_1
positive:
  rts
ENDASM

PROC r_Div=*()
ASM
  jsr r_3
  lda $85
  beq byte_divisor
  ldx #$08
word_loop:
  rol $82
  rol $83
  rol $87
  sec
  lda $83
  sbc $84
  tay
  lda $87
  sbc $85
  bcc word_no_subtract
  sta $87
  sty $83
word_no_subtract:
  dex
  bne word_loop
  lda $82
  rol a
  ldx #$00
  ldy $83
  sty $86
  clc
  bcc finish
byte_divisor:
  ldx #$10
byte_loop:
  rol $82
  rol $83
  rol a
  bcs byte_subtract
  cmp $84
  bcc byte_no_subtract
byte_subtract:
  sbc $84
  sec
byte_no_subtract:
  dex
  bne byte_loop
  rol $82
  rol $83
  sta $86
  lda $82
  ldx $83
finish:
  ldy $C2
  bpl positive
  sta $84
  stx $85
  sec
  lda #$00
  sbc $84
  tay
  lda #$00
  sbc $85
  tax
  tya
positive:
  rts
ENDASM

PROC r_Mod=*()
ASM
  jsr r_Div
  lda $86
  ldx $87
  rts
ENDASM

PROC r_Lsh=*()
ASM
  ldy $84
  beq done_return
  stx $85
loop:
  asl a
  rol $85
  dey
  bne loop
done:
  ldx $85
done_return:
  rts
ENDASM

PROC r_Rsh=*()
ASM
  ldy $84
  beq done_return
  stx $85
loop:
  lsr $85
  ror a
  dey
  bne loop
done:
  ldx $85
done_return:
  rts
ENDASM

PROC r_Par=*()
ASM
  sta $A0
  stx $A1
  sty $A2
  clc
  pla
  sta $84
  adc #$03
  tay
  pla
  sta $85
  adc #$00
  pha
  tya
  pha
  ldy #$01
  lda ($84),y
  sta $82
  iny
  lda ($84),y
  sta $83
  iny
  lda ($84),y
  tay
copy_args:
  lda $A0,y
  sta ($82),y
  dey
  bpl copy_args
  rts
ENDASM

SET $4E4=r_Lsh
SET $4E6=r_Rsh
SET $4E8=r_Mul
SET $4EA=r_Div
SET $4EC=r_Mod
SET $4EE=r_Par


;\{INV:                     }
;\{INV: memory allocation   }
;\{INV:                     }

MODULE
  
BYTE ARRAY allocbuf($800)=$2000

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers $A0-$A2
;@actionc writes $0100-$FFFF

PROC MovePage=*(CARD dst, src BYTE len)
ASM
  sta $A0
  stx $A1
  sty $A2
  ldy $A4
  dey
loop:
  lda ($A2),y
  sta ($A0),y
  dey
  cpy #$FF
  bne loop
  rts
ENDASM


CARD FUNC Alloc(CARD n)

  allocp==+n
RETURN(allocp-n)


PROC Free(CARD adr)

  allocp = adr
RETURN


PROC Push(CARD data)

  allocp^ = data  
  allocp==+2
RETURN


CARD FUNC Pull=*()

  allocp==-2
RETURN(allocp^)


;\{INV:                     }
;\{INV:    gfx routines     }
;\{INV:                     }

MODULE
  
DEFINE  CLEAR="$00",
         FILL="$40",
       INVERT="$80"

BYTE ARRAY quickmul(48)

;@actionc preserves Y $AC/$AD $AE/$AF
;@actionc clobbers $E6/$E7
PROC CalcAdr=*()
ASM
  ldx.z ky
  lda $58
  clc
  adc quickmul,x
  sta.z scl
  lda $59
  adc quickmul+24,x
  sta.z sch
  lda.z scl
  adc.z kx
  sta.z scl
  bcc done
  inc.z sch
done:
  rts
ENDASM


;@actionc preserves A X Y $AC/$AD $AE/$AF
;@actionc clobbers kx/ky
PROC Position=*(BYTE x, y)
ASM
  sta.z kx
  stx.z ky
  rts
ENDASM


;@actionc preserves X Y $AC/$AD $AE/$AF
;@actionc clobbers kx/ky
PROC Relpos=*(BYTE x, y)
ASM
  clc
  adc.z zx
  sta.z kx
  txa
  adc.z zy
  sta.z ky
  rts
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers $A0
;@actionc returns A=$A0
BYTE FUNC Internal=*(CHAR ch)
ASM
  tay
  rol a
  rol a
  rol a
  rol a
  and #$03
  tax
  tya
  and #$9F
  ora $FB49,x
  sta $A0
  rts
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers $A0
;@actionc returns A=$A0
BYTE FUNC Ascii=*(CHAR ch)
ASM
  tay
  rol a
  rol a
  rol a
  rol a
  and #$03
  tax
  tya
  and #$9F
  ora $FB4D,x
  sta $A0
  rts
ENDASM

;@actionc clobbers $A0
;@actionc returns A=$A0
CHAR FUNC Getchar=*()
ASM
  jsr $F2F8
  sta $A0
  rts
ENDASM


PROC Putchar(CHAR ch)

  CalcAdr()
  Screen^ = Internal(ch)
  kx==+1
RETURN


PROC Print(CHAR ARRAY s)

  BYTE i

  FOR i=1 TO s(0) DO
    Putchar(s(i))
  OD
RETURN 


PROC PrintE(CHAR ARRAY s)

  Print(s)
  kx=zx ky==+1
RETURN


;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y r0 $A0 scl/sch
;@actionc writes $0100-$FFFF
PROC Block=*(BYTE mode, dx, dy)
ASM
  pha
  stx $A0
  jsr CalcAdr
  tya
  tax
  pla
  cmp #$80
  beq invert
  cmp #$40
  beq fill_row
  lda #$00
mode_ready:
  sta.z r0
fill_row:
  ldy $A0
  lda.z r0
fill_column:
  sta (screen),y
  dey
  bpl fill_column
  clc
  lda.z scl
  adc #$28
  sta.z scl
  bcc fill_next
  inc.z sch
fill_next:
  dex
  bpl fill_row
  rts
invert:
  ldy $A0
invert_column:
  lda (screen),y
  eor #$80
  sta (screen),y
  dey
  bpl invert_column
  clc
  lda.z scl
  adc #$28
  sta.z scl
  bcc invert_next
  inc.z sch
invert_next:
  dex
  bpl invert
  rts
ENDASM


;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A0-$A4 scl/sch
;@actionc writes $0100-$FFFF
PROC GetImage=*(CARD adr BYTE dx, dy)
ASM
  sta $A0
  stx $A1
  sty $A2
  iny
  sty $A4
  jsr CalcAdr
  ldx $A3
get_row:
  ldy $A2
get_column:
  lda (screen),y
  sta ($A0),y
  dey
  bpl get_column
  clc
  lda.z scl
  adc #$28
  sta.z scl
  bcc screen_ready
  inc.z sch
  clc
screen_ready:
  lda $A0
  adc $A4
  sta $A0
  bcc destination_ready
  inc $A1
destination_ready:
  dex
  bpl get_row
  rts
ENDASM


;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A0-$A4 scl/sch
;@actionc writes $0100-$FFFF
PROC PutImage=*(CARD adr BYTE dx, dy)
ASM
  sta $A0
  stx $A1
  sty $A2
  iny
  sty $A4
  jsr CalcAdr
  ldx $A3
put_row:
  ldy $A2
put_column:
  lda ($A0),y
  sta (screen),y
  dey
  bpl put_column
  clc
  lda.z scl
  adc #$28
  sta.z scl
  bcc screen_ready
  inc.z sch
  clc
screen_ready:
  lda $A0
  adc $A4
  sta $A0
  bcc source_ready
  inc $A1
source_ready:
  dex
  bpl put_row
  rts
ENDASM


;\{INV:                  }
;\{INV:     files        }
;\{INV:                  }

MODULE

BYTE Ioerr 
PROC POINTER ErrorHandler

PROC Error()

;@actionc writes Ioerr $0340-$03BF
PROC _Cio=*()
ASM
  jsr $E456
  sty Ioerr
  bpl done
  jmp (ErrorHandler)
done:
  rts
ENDASM

;@actionc preserves Y $AC/$AD $AE/$AF
;@actionc clobbers A X
PROC _LodChn=*()
ASM
  asl a
  asl a
  asl a
  asl a
  tax
  rts
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A Y $86-$88
;@actionc writes fnam $0340-$03BF
PROC _StrNam()
 CHAR ARRAY fnam(40) CARD r=$86
ASM
  sta $86
  sty $87
  ldy #$00
  lda ($86),y
  sta $88
copy_name:
  iny
  lda ($86),y
  sta fnam-1,y
  cpy $88
  bne copy_name
  iny
  lda #$9B
  sta fnam-1,y
ENDASM
 r=fnam
ASM
  sta $0344,x
  lda.z r+1
  sta $0345,x
  rts
ENDASM
 
;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A0
;@actionc writes Ioerr $0340-$03BF
;@actionc returns A=$A0
CHAR FUNC GetD=*(BYTE chn)
ASM
  jsr _LodChn
  lda #$00
  sta $0348,x
  sta $0349,x
  lda #$07
  sta $0342,x
  jsr _Cio
  sta $A0
  rts
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A0
;@actionc writes Ioerr $0340-$03BF
PROC PutD=*(BYTE chn, ch)
ASM
  stx $A0
  jsr _LodChn
  lda #$00
  sta $0348,x
  sta $0349,x
  lda #$0B
  sta $0342,x
  lda $A0
  jmp _Cio
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $86-$88 $A1 $A3/$A4
;@actionc writes $0100-$FFFF
PROC Open=*(BYTE chn CARD s BYTE aux1,aux2)
ASM
  stx $A1
  jsr _LodChn
  lda $A1
  jsr _StrNam
  lda $A3
  sta $034A,x
  lda $A4
  sta $034B,x
  lda #$03
  sta $0342,x
  jmp _Cio
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y
;@actionc writes Ioerr $0340-$03BF
PROC Close=*(BYTE chn)
ASM
  jsr _LodChn
  lda #$0C
  sta $0342,x
  jmp _Cio
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A1 $A3
;@actionc writes $0100-$FFFF
PROC Input=*(BYTE chn CARD buf BYTE len)
ASM
  stx $A1
  jsr _LodChn
  lda $A1
  sta $0344,x
  tya
  sta $0345,x
  lda $A3
  sta $0348,x
  lda #$00
  sta $0349,x
  lda #$05
  sta $0342,x
  jmp _Cio
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A1 $A3/$A4
;@actionc writes $0100-$FFFF
PROC Bget=*(BYTE chn CARD buf, len)
ASM
  stx $A1
  jsr _LodChn
  lda $A1
  sta $0344,x
  tya
  sta $0345,x
  lda $A3
  sta $0348,x
  lda $A4
  sta $0349,x
  lda #$07
  sta $0342,x
  jmp _Cio
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A1 $A3/$A4
;@actionc writes Ioerr $0340-$03BF
PROC Bput=*(BYTE chn CARD buf, len)
ASM
  stx $A1
  jsr _LodChn
  lda $A1
  sta $0344,x
  tya
  sta $0345,x
  lda $A3
  sta $0348,x
  lda $A4
  sta $0349,x
  lda #$0B
  sta $0342,x
  jmp _Cio
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $86-$88 $A1 $A3-$A5
;@actionc writes $0100-$FFFF
PROC Xio=*(BYTE chn, cmd, aux1, aux2 CARD s)
ASM
  stx $A1
  jsr _LodChn
  lda $A1
  sta $0342,x
  tya
  sta $034A,x
  lda $A3
  sta $034B,x
  lda $A4
  ldy $A5
  jsr _StrNam
  jmp _Cio
ENDASM

