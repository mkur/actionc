
CONST BYTE TRUE=1, FALSE=0, EOL=155, ESC=27
CONST CARD NO_ITEM=0

; Shared text-screen geometry and window save area.
CONST BYTE SCREEN_COLS=40, SCREEN_ROWS=24
CONST BYTE LAST_SCREEN_ROW=SCREEN_ROWS-1
CONST CARD SCREEN_BYTES=SCREEN_COLS*SCREEN_ROWS
CONST CARD WINDOW_ARENA=$2000, WINDOW_ARENA_BYTES=$800
CONST CARD WINDOW_ARENA_END=WINDOW_ARENA+WINDOW_ARENA_BYTES
CONST BYTE ARENA_INVALID_CURSOR=1, ARENA_EXHAUSTED=2,
           ARENA_BAD_MARK=3, ARENA_UNDERFLOW=4, ARENA_BAD_CONFIG=5

; CIO commands, open modes and status bytes are separate values.
CONST BYTE CIO_OPEN=3, CIO_GET_RECORD=5, CIO_GET_CHARS=7,
           CIO_PUT_CHARS=11, CIO_CLOSE=12
CONST BYTE OPEN_READ=4, OPEN_DIRECTORY=6, OPEN_WRITE=8
CONST BYTE IO_SUCCESS=1, IO_EOF=136

CONST BYTE FILL_BYTE_ADDR=$70
BYTE i=$E0,j=$E1,r0=FILL_BYTE_ADDR
CONST BYTE CURSOR_X_ADDR=$FF,CURSOR_Y_ADDR=$FE
BYTE kx=CURSOR_X_ADDR,ky=CURSOR_Y_ADDR

BYTE zx=$5A,zy=zx+1,zdx=zx+2,zdy=zx+3

; Place screen/scl/sch at $E6/$E7 and allocp at $E8/$E9.
; Keep these allocator controls for both compiler backends.
CONST CARD SCREEN_LO_ADDR=$E6
CONST BYTE SCREEN_HI_ADDR=SCREEN_LO_ADDR+1
SET $E=SCREEN_LO_ADDR
SET $F=$00
SET $491=SCREEN_LO_ADDR
SET $492=$00

BYTE POINTER screen
BYTE scl=screen,
     sch=screen+1
CARD POINTER allocp

; Restore normal allocation after the zero-page pointer cells.
; The root program also declares its load origin with ORG.
SET $E=$2C00
SET $491=$2C00

; Arithmetic, shift, and large-argument helpers come from the selected runtime.
; Standalone links only the helpers TN actually uses; cart mode binds the same
; compiler operations to the resident library.

;\{INV:                     }
;\{INV: memory allocation   }
;\{INV:                     }

MODULE
  
BYTE ARRAY allocbuf(WINDOW_ARENA_BYTES)=WINDOW_ARENA
BYTE ArenaFault=[0]
; =* entries keep their existing storage-free entry layout on classic.
CARD POINTER arenaPullCursor, arenaRestoreCursor

;@actionc reviewed-6502 f06f7fefd8b58f29
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc reads-only $A0-$A4
;@actionc reads-buffer 2 3 zero=256
;@actionc writes-only $A0-$A2
;@actionc writes-buffer 1 3 zero=256
PROC MovePage=*(CARD dst, src BYTE len)
ASM
  sta $A0
  stx $A1
  sty $A2
  ldy $A4
  dey
loop:
  lda ($A2),y
  sta ($A0),y
  dey
  cpy #$FF
  bne loop
  rts
ENDASM


; The arena checks in Push and Alloc cover every byte passed to this entry.
; MovePage also serves unrestricted destinations elsewhere in TN.
;@actionc reviewed-6502 6f204a03de8c356c
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc requires indirect-writes $2000-$27FF
;@actionc writes-only $A0-$A2
PROC MoveToArena=*(CARD dst, src BYTE len)
ASM
  jsr MovePage
  rts
ENDASM


PROC ArenaStop(BYTE reason)

  ArenaFault=reason
  DO OD
RETURN


CARD FUNC ArenaCursor()

  CARD captured

  captured=CARD(allocp)
  IF captured<WINDOW_ARENA THEN ArenaStop(ARENA_INVALID_CURSOR) FI
  IF captured>WINDOW_ARENA_END THEN ArenaStop(ARENA_INVALID_CURSOR) FI
RETURN(captured)


CARD FUNC Alloc(CARD n)

  CARD captured, request

  request=n
  captured=ArenaCursor()
  IF request>WINDOW_ARENA_END-captured THEN ArenaStop(ARENA_EXHAUSTED) FI
  allocp=CARD POINTER(captured+request)
RETURN(captured)


PROC Free(CARD adr)

  CARD captured, mark

  mark=adr
  captured=ArenaCursor()
  IF mark<WINDOW_ARENA THEN ArenaStop(ARENA_BAD_MARK) FI
  IF mark>captured THEN ArenaStop(ARENA_BAD_MARK) FI
  allocp=CARD POINTER(mark)
RETURN


PROC Push(CARD data)

  CARD POINTER captured
  CARD pushedWord

  pushedWord=data
  captured=CARD POINTER(ArenaCursor())
  IF WINDOW_ARENA_END-captured<2 THEN ArenaStop(ARENA_EXHAUSTED) FI
  MoveToArena(captured, @pushedWord, 2)
  allocp=captured+2
RETURN


CARD FUNC Pull=*()

  arenaPullCursor=CARD POINTER(ArenaCursor())
  IF arenaPullCursor-WINDOW_ARENA<2 THEN ArenaStop(ARENA_UNDERFLOW) FI
  arenaPullCursor==-2
  allocp=arenaPullCursor
RETURN(arenaPullCursor^)


;\{INV:                     }
;\{INV:    gfx routines     }
;\{INV:                     }

MODULE
  
CONST BYTE CLEAR=$00, FILL=$40, INVERT=$80

BYTE ARRAY quickmul(SCREEN_ROWS*2)

; ky is an unchecked byte, so indexed reads can extend beyond quickmul.
;@actionc reviewed-6502 c90e0cc387ca90eb
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc writes-only $E6-$E7
;@actionc defines-on-return $E6-$E7
;@actionc preserves Y $AC/$AD $AE/$AF
;@actionc clobbers $E6/$E7
PROC CalcAdr=*()
ASM
  ldx.z CURSOR_Y_ADDR
  lda $58
  clc
  adc quickmul,x
  sta.z SCREEN_LO_ADDR
  lda $59
  adc quickmul+24,x ; SCREEN_ROWS; relocation addends must be numeric
  sta.z SCREEN_HI_ADDR
  lda.z SCREEN_LO_ADDR
  adc.z CURSOR_X_ADDR
  sta.z SCREEN_LO_ADDR
  bcc done
  inc.z SCREEN_HI_ADDR
done:
  rts
ENDASM


PROC Position(BYTE x, y)
  kx=x
  ky=y
RETURN


PROC Relpos(BYTE x, y)
  kx=x+zx
  ky=y+zy
RETURN

BYTE ARRAY internalMap(4)=[$40 $00 $20 $60],
           asciiMap(4)=[$20 $40 $00 $60]

;@actionc reviewed-6502 123577df7c98c094
;@actionc abi-inputs-only
;@actionc reads-only internalMap[0..3]
;@actionc writes-only $A0
;@actionc preserves $AC/$AD $AE/$AF
;@actionc returns A=$A0
BYTE FUNC Internal=*(CHAR ch)
ASM
  tay
  rol a
  rol a
  rol a
  rol a
  and #$03
  tax
  tya
  and #$9F
  ora internalMap,x
  sta $A0
  rts
ENDASM

; Four ROLs shift incoming carry into bit 3. AND #$03 discards it.
;@actionc reviewed-6502 eef75a2b0cd709fd
;@actionc abi-inputs-only
;@actionc reads-only asciiMap[0..3]
;@actionc writes-only $A0
;@actionc preserves $AC/$AD $AE/$AF
;@actionc returns A=$A0
BYTE FUNC Ascii=*(CHAR ch)
ASM
  tay
  rol a
  rol a
  rol a
  rol a
  and #$03
  tax
  tya
  and #$9F
  ora asciiMap,x
  sta $A0
  rts
ENDASM

; TN keyboard ABI: K: GET preserves Range.len ($A1) and the $E0-$EF home pool.
;@actionc reviewed-6502 d380e27dbe70296f
;@actionc abi-inputs-only
;@actionc preserves $A1 $E0-$EF
;@actionc clobbers $A0
;@actionc returns A=$A0
CHAR FUNC Getchar=*()
ASM OPAQUE
  ; Preserve the old $F2F8 behavior: discard a pending key before reading.
  lda #$FF
  sta $02FC

  ; The K: GET vector contains the handler address minus one. Arrange two
  ; stacked returns: first into the handler, then back here with the character.
  lda #>gotchar-1
  pha
  lda #<gotchar-1
  pha
  lda $E425
  pha
  lda $E424
  pha
  rts

gotchar:
  sta $A0
  rts
ENDASM


PROC Putchar(CHAR ch)

  CalcAdr()
  Screen^ = Internal(ch)
  kx==+1
RETURN


PROC Print(CHAR ARRAY s)

  BYTE i

  FOR i=1 TO s(0) DO
    Putchar(s(i))
  OD
RETURN 


PROC PrintE(CHAR ARRAY s)

  Print(s)
  kx=zx ky==+1
RETURN


; The selected screen rectangle must stay outside ZP. FILL takes its byte from r0.
;@actionc reviewed-6502 114874afaebf874e
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc requires indirect-writes $0100-$FFFF
;@actionc writes-only $70 $A0 $E6-$E7
;@actionc preserves $AC/$AD $AE/$AF
PROC Block=*(BYTE mode, dx, dy)
ASM
  pha
  stx $A0
  jsr CalcAdr
  tya
  tax
  pla
  cmp #INVERT
  beq invert_mode
  cmp #FILL
  beq fill_row
  lda #$00
mode_ready:
  sta.z FILL_BYTE_ADDR
fill_row:
  ldy $A0
  lda.z FILL_BYTE_ADDR
fill_column:
  sta (SCREEN_LO_ADDR),y
  dey
  bpl fill_column
  clc
  lda.z SCREEN_LO_ADDR
  adc #SCREEN_COLS
  sta.z SCREEN_LO_ADDR
  bcc fill_next
  inc.z SCREEN_HI_ADDR
fill_next:
  dex
  bpl fill_row
  rts
invert_mode:
  ldy $A0
invert_column:
  lda (SCREEN_LO_ADDR),y
  eor #$80
  sta (SCREEN_LO_ADDR),y
  dey
  bpl invert_column
  clc
  lda.z SCREEN_LO_ADDR
  adc #SCREEN_COLS
  sta.z SCREEN_LO_ADDR
  bcc invert_next
  inc.z SCREEN_HI_ADDR
invert_next:
  dex
  bpl invert_mode
  rts
ENDASM


; Internal entry. The image routines supply both pointers and the row width at $A4.
;@actionc reviewed-6502 d71ab3d94ade6478
;@actionc reads-only $A0/$A1 $A4 $E6-$E7
;@actionc writes-only $A0/$A1 $E6-$E7
;@actionc preserves X Y $AC/$AD $AE/$AF
PROC _ImageAdvance=*()
ASM
  clc
  lda.z SCREEN_LO_ADDR
  adc #SCREEN_COLS
  sta.z SCREEN_LO_ADDR
  bcc screen_ready
  inc.z SCREEN_HI_ADDR
  clc
screen_ready:
  lda $A0
  adc $A4
  sta $A0
  bcc buffer_ready
  inc $A1
buffer_ready:
  rts
ENDASM

; The entire destination buffer, including every indexed row, must stay outside ZP.
;@actionc reviewed-6502 f92a0c0556d0ec51
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc requires indirect-writes $0100-$FFFF
;@actionc writes-only $A0-$A2 $A4 $E6-$E7
;@actionc preserves $AC/$AD $AE/$AF
PROC GetImage=*(CARD adr BYTE dx, dy)
ASM
  sta $A0
  stx $A1
  sty $A2
  iny
  sty $A4
  jsr CalcAdr
  ldx $A3
get_row:
  ldy $A2
get_column:
  lda (SCREEN_LO_ADDR),y
  sta ($A0),y
  dey
  bpl get_column
  jsr _ImageAdvance
  dex
  bpl get_row
  rts
ENDASM


; The selected screen rectangle must stay outside ZP. adr supplies the source.
;@actionc reviewed-6502 310721a72eafd0d1
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc requires indirect-writes $0100-$FFFF
;@actionc writes-only $A0-$A2 $A4 $E6-$E7
;@actionc preserves $AC/$AD $AE/$AF
PROC PutImage=*(CARD adr BYTE dx, dy)
ASM
  sta $A0
  stx $A1
  sty $A2
  iny
  sty $A4
  jsr CalcAdr
  ldx $A3
put_row:
  ldy $A2
put_column:
  lda ($A0),y
  sta (SCREEN_LO_ADDR),y
  dey
  bpl put_column
  jsr _ImageAdvance
  dex
  bpl put_row
  rts
ENDASM


;\{INV:                  }
;\{INV:     files        }
;\{INV:                  }

MODULE

BYTE Ioerr 
PROC POINTER ErrorHandler

PROC Error()

; CIOV uses OS scratch. A returning application error handler has its own effects.
;@actionc reviewed-6502 7cb4806d79a6801f
PROC _Cio=*()
ASM OPAQUE
  jsr $E456
  sty Ioerr
  bpl done
  jmp (ErrorHandler)
done:
  rts
ENDASM

; A holds the channel on entry. A and X return the byte offset of its IOCB.
;@actionc reviewed-6502 7862b9362f71c385
;@actionc reads-only none
;@actionc writes-only none
;@actionc preserves Y $AC/$AD $AE/$AF
;@actionc clobbers A X
PROC _LodChn=*()
ASM OPAQUE
  asl a
  asl a
  asl a
  asl a
  tax
  rts
ENDASM

; A/Y point to a counted filename of 1..39 bytes. X is the IOCB offset.
; The private buffer also holds the trailing ATASCII EOL.
;@actionc reviewed-6502 20e0bd9c73ca4831
;@actionc preserves X
PROC _StrNam()
 CHAR ARRAY fnam(40)
ASM OPAQUE
  sta $86
  sty $87
  ldy #$00
  lda ($86),y
  sta $88
copy_name:
  iny
  lda ($86),y
  sta fnam-1,y
  cpy $88
  bne copy_name
  iny
  lda #EOL
  sta fnam-1,y
  lda #<fnam
  sta $86
  sta $0344,x
  lda #>fnam
  sta $87
  sta $0345,x
  rts
ENDASM
 
;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A0
;@actionc writes Ioerr $0340-$03BF
;@actionc returns A=$A0
CHAR FUNC GetD=*(BYTE chn)
ASM
  jsr _LodChn
  lda #$00
  sta $0348,x
  sta $0349,x
  lda #CIO_GET_CHARS
  sta $0342,x
  jsr _Cio
  sta $A0
  rts
ENDASM

;@actionc preserves $AC/$AD $AE/$AF
;@actionc clobbers A X Y $A0
;@actionc writes Ioerr $0340-$03BF
PROC PutD=*(BYTE chn, ch)
ASM
  stx $A0
  jsr _LodChn
  lda #$00
  sta $0348,x
  sta $0349,x
  lda #CIO_PUT_CHARS
  sta $0342,x
  lda $A0
  jmp _Cio
ENDASM

;@actionc reviewed-6502 6d165f441bf111c2
;@actionc abi-inputs-only
PROC Open=*(BYTE chn CARD s BYTE aux1,aux2)
ASM OPAQUE
  stx $A1
  jsr _LodChn
  lda $A1
  jsr _StrNam
  lda $A3
  sta $034A,x
  lda $A4
  sta $034B,x
  lda #CIO_OPEN
  sta $0342,x
  jmp _Cio
ENDASM

;@actionc reviewed-6502 34453d526302e71a
;@actionc abi-inputs-only
;@actionc preserves-via ErrorHandler $A0-$A3 $AA-$AB $AE-$AF $E0-$EF
PROC Close=*(BYTE chn)
ASM OPAQUE
  jsr _LodChn
  lda #CIO_CLOSE
  sta $0342,x
  jmp _Cio
ENDASM

; A selects the channel, X/Y supply the buffer and $A3 supplies its byte length.
; GET RECORD goes through _Cio and can invoke the installed error handler.
;@actionc reviewed-6502 b2efc672a7353507
;@actionc abi-inputs-only
PROC Input=*(BYTE chn CARD buf BYTE len)
ASM OPAQUE
  stx $A1
  jsr _LodChn
  lda $A1
  sta $0344,x
  tya
  sta $0345,x
  lda $A3
  sta $0348,x
  lda #$00
  sta $0349,x
  lda #CIO_GET_RECORD
  sta $0342,x
  jmp _Cio
ENDASM

; X selects the IOCB, Y/$A1 hold the buffer, and $A3/$A4 hold length.
; Restore A from ICCOM: CIO uses A when the requested length is zero.
;@actionc reviewed-6502 188ef9cdf6fe6f91
PROC _BlockIO=*()
ASM OPAQUE
  lda $A1
  sta $0344,x
  tya
  sta $0345,x
  lda $A3
  sta $0348,x
  lda $A4
  sta $0349,x
  lda $0342,x
  jmp _Cio
ENDASM

;@actionc reviewed-6502 d19b79041d42ff1f
;@actionc abi-inputs-only
PROC Bget=*(BYTE chn CARD buf, len)
ASM OPAQUE
  stx $A1
  jsr _LodChn
  lda #CIO_GET_CHARS
  sta $0342,x
  jmp _BlockIO
ENDASM

;@actionc reviewed-6502 bb4a7e67e3a48413
;@actionc abi-inputs-only
PROC Bput=*(BYTE chn CARD buf, len)
ASM OPAQUE
  stx $A1
  jsr _LodChn
  lda #CIO_PUT_CHARS
  sta $0342,x
  jmp _BlockIO
ENDASM

;@actionc reviewed-6502 bc218fa78abb5693
;@actionc abi-inputs-only
PROC Xio=*(BYTE chn, cmd, aux1, aux2 CARD s)
ASM OPAQUE
  stx $A1
  jsr _LodChn
  lda $A1
  sta $0342,x
  tya
  sta $034A,x
  lda $A3
  sta $034B,x
  lda $A4
  ldy $A5
  jsr _StrNam
  jmp _Cio
ENDASM

;PROC Note=*(BYTE chn CARD sectorptr, offsetptr)
;[$86$A1$84$A2$20 _LodChn $A9$26$9D$342$20 _Cio $A0$00$BD$34C$91$A1$BD$34E $91$A3$BD$34D$C8$91$A1$60]

;PROC Point=*(BYTE chn CARD sector BYTE offset)
;[$86$A1$20 _LodChn $A5$A1$9D$34C$98$9D$34D$A5$A3$9D$34E$A9$25$9D$342$4C _Cio]


;\{INV:                  }
;\{INV:    windows       }
;\{INV:                  }

MODULE

 BYTE openwindows
 CHAR ARRAY frame(8)="\{$11}\{$12}\{$05}||\{$1A}\{$12}\{$03}"


PROC SavePos()

 CARD adr
  
  adr = Alloc(4)
  MoveToArena(adr, @zx, 4)
RETURN


PROC RestorePos=*()

  arenaRestoreCursor=CARD POINTER(ArenaCursor())
  IF arenaRestoreCursor-WINDOW_ARENA<4 THEN ArenaStop(ARENA_UNDERFLOW) FI
  arenaRestoreCursor==-4
  allocp=arenaRestoreCursor
  MovePage(@zx, arenaRestoreCursor, 4)
RETURN



PROC Window(BYTE x, y, dx, dy)

 CARD buf BYTE h
 
  SavePos()

  openwindows==+1

  zx = x      zy = y
  zdx = dx    zdy = dy

  Relpos(0,0)
 
  buf = Alloc((zdx+1)*(zdy+1))
  Push(buf)
  GetImage(buf, zdx, zdy)
  SavePos()

  Block(CLEAR, zdx, zdy)

  CalcAdr()

  screen^ = frame(0)
  h = SCREEN_COLS-zdx
 
  FOR i=2 TO zdx DO
    screen==+1
    screen^=frame(1)
  OD

  screen==+1
  screen^ = frame(2)

  FOR i=2 TO zdy DO
    screen==+h
    screen^ = frame(3)
    screen==+zdx   
    screen^ = frame(4)
  OD

  screen==+h
  screen^ = frame(5)
  screen==+1
  FOR i=2 TO zdx DO
    screen^ = frame(6)
    screen==+1
  OD

  screen^ = frame(7)

  zx==+1  zy==+1
  zdx==-1 zdy==-1

  Relpos(0,0)
RETURN


PROC CloseWindow()
   
 CARD buf

  RestorePos()

  openwindows==-1

  Relpos(0,0)
  buf = Pull()
  Free(buf)
  PutImage(buf, zdx, zdy)
  RestorePos()
RETURN


CHAR FUNC Range(CHAR ARRAY s, BYTE max, BYTE POINTER c)

 BYTE i=$A0,len=$A1,f=$A2
 CHAR ch=$A3

  len=s(0)
  DO
    ch=getchar() f=true
    FOR i=1 TO len STEP 2 DO
      IF s(i)=ch THEN
        IF c^#0 THEN c^==-1 ELSE f=false FI
      ELSEIF s(i+1)=ch THEN
        IF c^<max THEN c^==+1 ELSE f=false FI
      FI
    OD
    UNTIL f
  OD
RETURN(ch)


BYTE FUNC InputLine(CHAR ARRAY string, BYTE maxlen, curpos)

 CHAR ch

  SavePos()
  zx=kx zy=ky
 
  DO
    Relpos(curpos,0)
    Block(INVERT,0,0)
    ch=Getchar()
    Block(INVERT,0,0)
  
    IF ch=126 THEN
      IF curpos#0 THEN
        curpos==-1
        Relpos(curpos,0)
        Putchar(32)
      FI
    ELSEIF ch=156 THEN
      curpos=0
      Relpos(0,0)
      Block(CLEAR,MaxLen-1,0)
    ELSEIF ch=ESC OR ch=EOL THEN EXIT
    ELSEIF curpos<MaxLen THEN
      string(curpos+1)=ch
      Putchar(ch)
      curpos==+1
    FI
  OD
  string(0)=curpos
  RestorePos()
  IF ch=ESC OR curpos=0 THEN RETURN(0) FI
RETURN(1)


MODULE

BYTE spaces

BYTE FUNC Key( BYTE POINTER menu )

  menu ==+ menu^ + 3
RETURN( menu^ )



CARD FUNC Next( BYTE POINTER menu )
RETURN( menu + menu^ + 5 )



BYTE FUNC Ord( BYTE POINTER menu, item )

 BYTE c

  c = 0

  WHILE menu^ DO
    IF menu = item THEN
      EXIT
    FI
    c ==+ 1
    menu = Next( menu )
  OD
RETURN( c )



BYTE FUNC Items(BYTE POINTER menu)
               
 BYTE c

  c = 0

  WHILE menu^ DO
    c ==+ 1
    menu = Next( menu )
  OD
RETURN( c )


CARD FUNC FindItem( BYTE POINTER menu CHAR ch )

  WHILE menu^ DO
    IF Key( menu ) = ch THEN RETURN( menu ) FI
    menu = Next( menu )
  OD
RETURN( NO_ITEM )


PROC DrawMenu( BYTE POINTER menu )

  zx = kx
  zy = ky 

  WHILE menu^ DO
    Print( CHAR POINTER(menu) )
    kx ==+ spaces
    menu = Next( menu )
  OD
RETURN


CARD FUNC MoveMenuBar( BYTE POINTER menu BYTE c )

 BYTE p, a

  p = 0

  WHILE c DO
    a = menu^ + spaces
    p ==+ a
    c ==- 1
    menu = Next( menu )
  OD

  Relpos( p, 0 )
  Block( INVERT, menu^-1, 0 )

RETURN( menu )



CHAR FUNC PopUp( BYTE POINTER mp BYTE c, spc )

 CHAR ch, value BYTE d, limit CARD menu
 
  Push( menu )
  SavePos()

  menu = mp
  spaces = spc
  limit = Items( menu ) - 1

  DrawMenu( menu )
  mp = MoveMenuBar( menu, c )
          
  DO
    d = c
    ch = Range( "+*\{$1E}\{$1F}", limit, @c )

    BEGIN
      LET CARD item = FindItem( menu, ch )
      IF item # NO_ITEM THEN
        mp = item
        c = Ord( menu, mp )
        ch = EOL
      FI
    END

    IF c # d THEN
      MoveMenuBar( menu, d )
      mp = MoveMenuBar( menu, c )
    FI   

  UNTIL ch = ESC OR ch = EOL OD

  RestorePos()
  menu = Pull()

  IF ch = EOL THEN
    RETURN( Key( mp ) )
  ELSE
    RETURN( ESC )
  FI

PROC Init()
 
 CARD h

  IF WINDOW_ARENA_BYTES=0 OR WINDOW_ARENA_END<=WINDOW_ARENA THEN
    ArenaStop(ARENA_BAD_CONFIG)
  FI
 
  h = 0
  FOR i = 0 TO LAST_SCREEN_ROW DO
    quickmul(i) = h
    quickmul(i + SCREEN_ROWS) = h rsh 8
    h ==+ SCREEN_COLS
  OD

  FOR i = 0 TO 8 DO
    frame(i) = Internal(frame(i + 1))
  OD    

  allocp = CARD POINTER(@allocbuf)
  openwindows = 0
RETURN
