; Shared panel-directory boundary. Included after TN's panel declarations.
; Only ReadWindow and ResolveEntry need a different directory source later.

PROC DirectoryFailure(BYTE reason)
  directoryError=reason
  currentBatch.valid=0 active.files=0
  ; Keep the established nonlocal error recovery and its stack reset.
  ; A local directory-format error has no OS status to report.
  IF reason#DIR_IO_ERROR THEN ioerr=0 FI
ASM OPAQUE
  jmp (ErrorHandler)
ENDASM
RETURN

BYTE FUNC ReadWindow(CARD first)
  ; The production MyDOS listing is already complete. A future source fills
  ; currentBatch here, in its established global order, without publishing it.
RETURN(DIR_RANGE)

PROC InvalidateListing()
  BatchBegin(currentBatch,0) TagsReset(currentTags)
  active.files=0 active.selected=0 active.row=0
RETURN

BYTE FUNC FetchWindow(CARD first)
  BYTE result,count,ended
  CARD actual
  BatchBegin(currentBatch,first)
  result=ReadWindow(first)
  IF result=DIR_CHANGED THEN InvalidateListing() FI
  IF result#DIR_OK THEN
    currentBatch.valid=0 directoryError=result RETURN(result)
  FI
  actual=currentBatch.first
  IF actual#first THEN RETURN(DIR_INVALID) FI
  count=currentBatch.count ended=currentBatch.ended
  result=BatchPublish(currentBatch,currentTags,count,ended)
  IF result=DIR_OK THEN active.files=currentTags.extent FI
RETURN(result)

; Discover the end using only the existing cache. Selection bits persist.
BYTE FUNC ListingEnd()
  CARD first,extent
  BYTE result
  WHILE currentTags.complete=0 DO
    first=currentTags.extent
    result=FetchWindow(first)
    IF result#DIR_OK THEN RETURN(result) FI
    extent=currentTags.extent
    IF extent<=first AND currentTags.complete=0 THEN RETURN(DIR_INVALID) FI
  OD
RETURN(DIR_OK)

CARD FUNC EntryAddress(CARD ordinal)
  CARD address,first
  BYTE result
  address=CachedEntry(currentBatch,ordinal)
  IF address=0 THEN
    first=BatchStart(ordinal)
    result=FetchWindow(first)
    IF result#DIR_OK THEN RETURN(0) FI
    address=CachedEntry(currentBatch,ordinal)
  FI
RETURN(address)

BYTE FUNC EnsureView(CARD top)
  CARD last,first,address
  IF active.files=0 THEN RETURN(DIR_OK) FI
  IF top>=active.files THEN RETURN(DIR_RANGE) FI
  last=top+LAST_VISIBLE_FILE
  IF last<top OR last>=active.files THEN last=active.files-1 FI
  address=CachedEntry(currentBatch,top)
  IF address THEN address=CachedEntry(currentBatch,last) FI
  IF address THEN RETURN(DIR_OK) FI
  first=BatchStart(top)
RETURN(FetchWindow(first))

BYTE FUNC ResolveEntry(CARD ordinal BYTE ARRAY output CARD capacity)
  DirEntry POINTER entry
  entry=EntryAddress(ordinal)
  IF entry=0 THEN RETURN(DIR_INVALID) FI
RETURN(MyDosName(entry,output,capacity))

PROC Convert(CARD ordinal)
  BYTE result
  result=ResolveEntry(ordinal,BYTE POINTER(fname),15)
  IF result#DIR_OK THEN DirectoryFailure(result) FI
RETURN

; Range remains the BYTE menu helper in LIB. File navigation uses CARD and
; keeps its previous behavior of ignoring movement keys at either boundary.
CHAR FUNC FileRange()
  CHAR ch
  BYTE accepted,result
  CARD extent
  DO
    ch=Getchar() accepted=true
    IF ch='- OR ch='\{$1C} THEN
      IF active.selected THEN active.selected==-1 ELSE accepted=false FI
    ELSEIF ch='= OR ch='\{$1D} THEN
      IF active.selected+1>=active.files AND currentTags.complete=0 THEN
        extent=currentTags.extent
        result=FetchWindow(extent)
        IF result#DIR_OK THEN DirectoryFailure(result) FI
      FI
      IF active.files#0 AND active.selected<active.files-1 THEN
        active.selected==+1
      ELSE
        accepted=false
      FI
    FI
  UNTIL accepted OD
RETURN(ch)

CARD FUNC PathName(BYTE level)
RETURN(MyDosPathName(currentLocation,level))

BYTE FUNC PrepareSelection()
  BYTE result
  CARD top
  top=active.selected-active.row
  result=TagsReady(currentTags)
  IF result=DIR_PENDING THEN
    result=ListingEnd()
    IF result#DIR_OK THEN RETURN(result) FI
    result=TagsReady(currentTags)
  FI
  IF result#DIR_OK THEN RETURN(result) FI
RETURN(EnsureView(top))
