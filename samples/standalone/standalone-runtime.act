; Standalone runtime-linking example using traditional unqualified Action!
; source. The standalone runtime now provides the audited system library, not
; only compiler arithmetic helpers. This sample links console I/O alongside
; the arithmetic routines and SArgs needed by SaveResults' argument frame.

CARD left,right
CARD product,quotient,remainder,shifted
BYTE shift

PROC SaveResults(CARD p,q,r,s)
  product=p
  quotient=q
  remainder=r
  shifted=s
RETURN

PROC Main()
  PrintE("Hello from standalone!")
  PrintE("No Action! cartridge required.")
  PutE()

  left=1234
  right=37
  shift=3

  SaveResults(left*right,
              left/right,
              left MOD right,
              left RSH shift)

  PrintE("inputs:")
  Print("left: ")
  PrintC(left)
  PutE()
  Print("right: ")
  PrintC(right)
  PutE()
  Print("shift: ")
  PrintB(shift)
  PutE()

  PrintE("results:")
  Print("product: ")
  PrintC(product)
  PutE()
  Print("quotient: ")
  PrintC(quotient)
  PutE()
  Print("remainder: ")
  PrintC(remainder)
  PutE()
  Print("shifted: ")
  PrintC(shifted)
  PutE()

  PutE()
  Print("Press any key to continue...")
  GetD(0)
RETURN
