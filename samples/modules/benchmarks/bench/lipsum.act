MODULE BENCH.LIPSUM

USE SYS
USE ATARI.OS

CONST CARD SYSTEM_CHARSET=$E000

CARD screenAddress
BYTE row

PROC WriteGraphics8(BYTE x,y, STRING text)
  BYTE glyphRow=$E0,textIndex=$E1,glyphByte
  CARD rowAddress=$E2,destination=$E4,glyphAddress=$E6

  destination=screenAddress+CARD(y)*320+x-1
  FOR textIndex=text(0) TO 1 STEP -1 DO
    glyphAddress=SYSTEM_CHARSET+CARD(text(textIndex))*8
    rowAddress=destination+textIndex
    FOR glyphRow=7 TO 0 STEP -1 DO
      glyphByte=SYS.Peek(glyphAddress+glyphRow)
      SYS.Poke(rowAddress+CARD(glyphRow)*40,glyphByte)
    OD
  OD
RETURN

PUBLIC PROC Run()
  SYS.Graphics(24)
  screenAddress=OS.SAVMSC
  FOR row=23 TO 0 STEP -1 DO
    WriteGraphics8(0,row,"Lorem ipsum dolor sit amet orci aliquam.")
  OD
RETURN

ENDMODULE
