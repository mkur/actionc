MODULE BENCH.FLAMES_ARRAY

USE SYS
USE ATARI.OS
USE ATARI.POKEY
USE BENCH.SUPPORT

CONST CARD FIRE_SCREEN=$A400

BYTE ARRAY workspace=$A000,
           row0(256)=FIRE_SCREEN-31,
           row1(256)=FIRE_SCREEN-31+$100,
           row2(256)=FIRE_SCREEN-31+$200,
           row3(256)=FIRE_SCREEN+$2E0

BYTE index=$E0
BYTE tenThousands=$CB,thousands=$CC,hundreds=$CD,tens=$CE,ones=$CF

PUBLIC PROC Run(BYTE resultIndex)
  SYS.Zero(workspace,$1000)
  tenThousands=0
  thousands=0
  hundreds=0
  tens=0
  ones=0
  OS.RTCLOK_LO=0

  WHILE OS.RTCLOK_LO<250 DO
    FOR index=0 TO 255 DO
      row1(index)=BYTE(row1(index+30)+row1(index+31)+
                       row1(index+32)+row1(index+63)) RSH 2
      row2(index)=BYTE(row2(index+30)+row2(index+31)+
                       row2(index+32)+row2(index+63)) RSH 2
      row0(index)=BYTE(row0(index+30)+row0(index+31)+
                       row0(index+32)+row0(index+63)) RSH 2
    OD

    FOR index=31 TO 0 STEP -1 DO
      row3(index)=POKEY.RANDOM&15
    OD

    ones==+1
    IF ones=10 THEN tens==+1 ones=0 FI
    IF tens=10 THEN hundreds==+1 tens=0 FI
    IF hundreds=10 THEN thousands==+1 hundreds=0 FI
    IF thousands=10 THEN tenThousands==+1 thousands=0 FI
  OD

  SUPPORT.SaveIterations(resultIndex,tenThousands,thousands,hundreds,tens,ones)
RETURN

ENDMODULE
