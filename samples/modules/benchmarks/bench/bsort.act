MODULE BENCH.BSORT

BYTE i=$F0,value=$F1,size=$F2
BYTE ARRAY sortTable(255)=$A000

PUBLIC PROC Run()
  FOR i=0 TO 254 DO
    sortTable(i)=255-i
  OD

  FOR size=253 TO 0 STEP -1 DO
    FOR i=0 TO 253 DO
      IF sortTable(i+1)<sortTable(i) THEN
        value=sortTable(i+1)
        sortTable(i+1)=sortTable(i)
        sortTable(i)=value
      FI
    OD
  OD
RETURN

ENDMODULE
