MODULE BENCH.COUNTDOWN_WHILE

CONST BYTE UNDERFLOW=$FF

BYTE za=$CB,zb=$CC,zc=$CD,zd=$CE,ze=$CF,zf=$D0,zg=$D1

PUBLIC PROC Run()
  za=1
  WHILE za#UNDERFLOW DO
    zb=9
    WHILE zb#UNDERFLOW DO
      zc=9
      WHILE zc#UNDERFLOW DO
        zd=9
        WHILE zd#UNDERFLOW DO
          ze=9
          WHILE ze#UNDERFLOW DO
            zf=9
            WHILE zf#UNDERFLOW DO
              zg=9
              WHILE zg#UNDERFLOW DO
                zg==-1
              OD
              zf==-1
            OD
            ze==-1
          OD
          zd==-1
        OD
        zc==-1
      OD
      zb==-1
    OD
    za==-1
  OD
RETURN

ENDMODULE
