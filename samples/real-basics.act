; A first native REAL program. Compile it with --mode optimized or --mode
; mir6502; native REAL is not enabled by compatibility mode.
MODULE REAL_BASICS

USE SYS
USE ATARI.OS

CONST REAL UnitPrice=1.25

BYTE quantity
REAL subtotal, total

PROC Main()
  SYS.Close(0)
  SYS.Open(0,"E:",12,0)

  quantity=4
  subtotal=UnitPrice*quantity
  total=subtotal+0.5

  SYS.PrintE("Total:")
  SYS.PrintRE(@total) ;  pass the address of total

  OS.CH=OS.NO_KEY
  SYS.PrintE("Press any key to continue.")
  DO
  UNTIL OS.CH#OS.NO_KEY
  OD
RETURN

ENDMODULE
