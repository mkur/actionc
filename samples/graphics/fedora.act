;@actionc profile modern
; Native REAL translation of the Atari BASIC sine-surface program, whose
; rendered surface resembles a fedora.
;
; The original used BASIC's SQR and SIN. MATH supplies pointer-oriented
; implementations built on native REAL and the target math provider.
MODULE FEDORA

USE ATARI.OS
USE SYS
USE MATH

PROC ProjectAndPlot(REAL POINTER surfaceX, surfaceY, surfaceZ)
  INT screenX, screenY
  CARD column
  BYTE row
  REAL projectedX, projectedY

  ; Project the three-dimensional point onto the screen.
  projectedX=surfaceX^+surfaceZ^+160
  projectedY=surfaceY^-surfaceZ^+100
  screenX=INT(projectedX)
  screenY=INT(projectedY)
  screenY=191-screenY

  IF screenX>=0 AND screenX<=319 AND screenY>=0 AND screenY<=191 THEN
    column=CARD(screenX)
    row=BYTE(screenY)

    ; Plot the visible surface, then shade everything below it.
    SYS.COLOR=1
    SYS.Plot(column,row)
    IF screenY<190 THEN
      row==+1
      SYS.COLOR=2
      SYS.Plot(column,row)
      SYS.DrawTo(column,191)
    FI
  FI
RETURN

PROC Main()
  INT zIndex, xIndex, xLimit
  REAL maximumAngle, angleScale, heightScale
  REAL scaledZ, surfaceZ, xLimitReal
  REAL radiusSquared, angle, surfaceX, surfaceY
  REAL fundamentalWave, thirdHarmonic, tripleAngle

  ; Graphics 24 is a full-screen 320 by 192 bitmap.
  SYS.Graphics(24)
  SYS.SetColor(2,2,4) ; background
  SYS.SetColor(4,2,4) ; outer frame
  SYS.COLOR=1

  maximumAngle=1.5*MATH.Pi
  angleScale=maximumAngle/144
  heightScale=56

  ; Draw the surface one depth slice at a time.
  zIndex=-100
  WHILE zIndex<100
  DO
    IF zIndex>=-64 AND zIndex<=64 THEN
      scaledZ=zIndex*144.0/64
      surfaceZ=zIndex

      ; Find the horizontal span of this slice inside a radius-144 circle.
      radiusSquared=144.0*144.0-scaledZ*scaledZ
      MATH.Sqr(@radiusSquared,@xLimitReal)
      xLimit=INT(xLimitReal+0.5)

      xIndex=-xLimit
      WHILE xIndex<=xLimit
      DO
        OS.ATRACT=0

        ; Combine a sine wave with its third harmonic to shape the surface.
        radiusSquared=xIndex*xIndex+scaledZ*scaledZ
        MATH.Sqr(@radiusSquared,@angle)
        angle==*angleScale
        surfaceX=xIndex

        MATH.Sin(@angle,@fundamentalWave)
        tripleAngle=3*angle
        MATH.Sin(@tripleAngle,@thirdHarmonic)
        surfaceY=(fundamentalWave+0.4*thirdHarmonic)*heightScale

        ProjectAndPlot(@surfaceX,@surfaceY,@surfaceZ)
        xIndex==+1
      OD
    FI
    zIndex==+1
  OD

  ; Keep the completed picture visible without entering attract mode.
  DO OS.ATRACT=0 OD
RETURN

ENDMODULE
