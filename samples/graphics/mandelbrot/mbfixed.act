; Native 160x192 sampling; see README.md for the original and display viewports.
MODULE MANDELBROT_ATARI
USE FRACTAL.MANDELBROT AS MB
USE SYS
USE ATARI.OS

; Original upper/lower two-bit dither patterns for eight iteration bands.
BYTE ARRAY colors(16)=[$FF $FF $EE $BB $AA $AA $88 $22
                      $44 $11 $55 $55 $DD $77 $33 $CC]

PROC DrawRow(BYTE py)
  CARD px
  INT cx,cy
  BYTE count,band,shiftCount,pattern
  cy=MB.ViewportY(CARD(py),192)
  FOR px=0 TO 159 DO
    cx=MB.ViewportX(px,160)
    count=MB.Iterate(cx,cy)
    IF count<32 THEN
      ; Dither phase follows physical rows, independently of the iteration band.
      band=2*(count&7)+(py&1)
      shiftCount=2*(3-(px&3))
      pattern=colors(band) RSH shiftCount
      SYS.COLOR=pattern&3
      SYS.Plot(px,py)
    FI
  OD
RETURN

PROC Main()
  BYTE py
  SYS.Graphics(31) ; full-screen 160x192, four colors
  SYS.SetColor(0,2,6)
  SYS.SetColor(1,1,12)
  SYS.SetColor(2,9,10)
  SYS.SetColor(4,0,0)
  FOR py=0 TO 191 DO
    OS.ATRACT=0
    DrawRow(py)
  OD
  DO OS.ATRACT=0 OD
RETURN
ENDMODULE
