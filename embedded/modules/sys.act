; Runtime-neutral Action system-library interface. Runtime-specific implementation
; addresses live in compiler-owned binding units, never in this public module.
MODULE SYS

PUBLIC EXTERNAL PROC Zero(BYTE POINTER address, CARD size)
PUBLIC EXTERNAL PROC SetBlock(BYTE POINTER address, CARD size, BYTE value)
PUBLIC EXTERNAL PROC MoveBlock(BYTE POINTER destination, source, CARD size)

PUBLIC EXTERNAL INT FUNC SCompare(STRING left, right)
PUBLIC EXTERNAL PROC SCopy(STRING destination, source)
PUBLIC EXTERNAL PROC SCopyS(STRING destination, source, BYTE first, last)
PUBLIC EXTERNAL PROC SAssign(STRING destination, source, BYTE first, last)
PUBLIC EXTERNAL PROC StrB(BYTE value, STRING destination)
PUBLIC EXTERNAL PROC StrC(CARD value, STRING destination)
PUBLIC EXTERNAL PROC StrI(INT value, STRING destination)

; Native REAL conversion and I/O are modern, qualified-only SYS extensions.
; REAL values remain pointer-based because native REAL has no by-value ABI.
PUBLIC EXTERNAL PROC StrR(REAL POINTER value STRING destination)
PUBLIC EXTERNAL PROC ValR(STRING source REAL POINTER destination)

PUBLIC EXTERNAL BYTE FUNC Rand(BYTE limit)
PUBLIC EXTERNAL PROC Sound(BYTE voice, pitch, distortion, volume)
PUBLIC EXTERNAL PROC SndRst()
PUBLIC EXTERNAL BYTE FUNC Paddle(BYTE port)
PUBLIC EXTERNAL BYTE FUNC PTrig(BYTE port)
PUBLIC EXTERNAL BYTE FUNC Stick(BYTE port)
PUBLIC EXTERNAL BYTE FUNC STrig(BYTE port)

PUBLIC EXTERNAL BYTE FUNC Peek(CARD address)
PUBLIC EXTERNAL CARD FUNC PeekC(CARD address)
PUBLIC EXTERNAL PROC Poke(CARD address, BYTE value)
PUBLIC EXTERNAL PROC PokeC(CARD address, value)

PUBLIC EXTERNAL PROC Error(BYTE code, x, y)
PUBLIC EXTERNAL PROC Break()

; Graphics color index consumed by Plot, DrawTo, and Fill.
PUBLIC VOLATILE BYTE COLOR=$02FD
PUBLIC EXTERNAL PROC Graphics(BYTE mode)
PUBLIC EXTERNAL PROC Position(CARD column, BYTE row)
PUBLIC EXTERNAL PROC DrawTo(CARD column, BYTE row)
PUBLIC EXTERNAL BYTE FUNC Locate(CARD column, BYTE row)
PUBLIC EXTERNAL PROC Plot(CARD column, BYTE row)
PUBLIC EXTERNAL PROC SetColor(BYTE register, hue, luminance)
PUBLIC EXTERNAL PROC Fill(CARD column, BYTE row)

PUBLIC EXTERNAL PROC Put(CHAR value)
PUBLIC EXTERNAL PROC PutE()
PUBLIC EXTERNAL PROC PutD(BYTE device, CHAR value)
PUBLIC EXTERNAL PROC PutDE(BYTE device)
PUBLIC EXTERNAL PROC Print(STRING value)
PUBLIC EXTERNAL PROC PrintE(STRING value)
PUBLIC EXTERNAL PROC PrintD(BYTE device, STRING value)
PUBLIC EXTERNAL PROC PrintDE(BYTE device, STRING value)
PUBLIC EXTERNAL PROC PrintF(STRING format, CARD a1, a2, a3, a4, a5)
PUBLIC EXTERNAL PROC PrintH(CARD value)
PUBLIC EXTERNAL CHAR FUNC GetD(BYTE device)

PUBLIC EXTERNAL PROC InputS(STRING destination)
PUBLIC EXTERNAL PROC InputSD(BYTE device, STRING destination)
PUBLIC EXTERNAL PROC InputMD(BYTE device, STRING destination, BYTE maximum)
PUBLIC EXTERNAL PROC InputD(BYTE device, STRING destination)
PUBLIC EXTERNAL PROC Open(BYTE device, STRING fileName, BYTE mode, auxiliary)
PUBLIC EXTERNAL PROC Close(BYTE device)
PUBLIC EXTERNAL PROC XIO(BYTE device, function, command, aux1, aux2, STRING value)
PUBLIC EXTERNAL PROC Note(BYTE device, CARD POINTER sector, BYTE POINTER offset)
PUBLIC EXTERNAL PROC Point(BYTE device, CARD sector, BYTE offset)

PUBLIC EXTERNAL PROC PrintB(BYTE value)
PUBLIC EXTERNAL PROC PrintBE(BYTE value)
PUBLIC EXTERNAL PROC PrintBD(BYTE device, value)
PUBLIC EXTERNAL PROC PrintBDE(BYTE device, value)
PUBLIC EXTERNAL PROC PrintC(CARD value)
PUBLIC EXTERNAL PROC PrintCE(CARD value)
PUBLIC EXTERNAL PROC PrintCD(BYTE device, CARD value)
PUBLIC EXTERNAL PROC PrintCDE(BYTE device, CARD value)
PUBLIC EXTERNAL PROC PrintI(INT value)
PUBLIC EXTERNAL PROC PrintIE(INT value)
PUBLIC EXTERNAL PROC PrintID(BYTE device, INT value)
PUBLIC EXTERNAL PROC PrintIDE(BYTE device, INT value)
PUBLIC EXTERNAL PROC PrintR(REAL POINTER value)
PUBLIC EXTERNAL PROC PrintRE(REAL POINTER value)
PUBLIC EXTERNAL PROC PrintRD(BYTE device REAL POINTER value)
PUBLIC EXTERNAL PROC PrintRDE(BYTE device REAL POINTER value)

PUBLIC EXTERNAL BYTE FUNC InputB()
PUBLIC EXTERNAL BYTE FUNC InputBD(BYTE device)
PUBLIC EXTERNAL CARD FUNC InputC()
PUBLIC EXTERNAL CARD FUNC InputCD(BYTE device)
PUBLIC EXTERNAL INT FUNC InputI()
PUBLIC EXTERNAL INT FUNC InputID(BYTE device)
PUBLIC EXTERNAL BYTE FUNC ValB(STRING value)
PUBLIC EXTERNAL CARD FUNC ValC(STRING value)
PUBLIC EXTERNAL INT FUNC ValI(STRING value)
PUBLIC EXTERNAL PROC InputR(REAL POINTER destination)
PUBLIC EXTERNAL PROC InputRD(BYTE device REAL POINTER destination)

ENDMODULE
