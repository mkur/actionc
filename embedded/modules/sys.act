; Runtime-neutral Action system-library interface. Runtime-specific implementation
; addresses live in compiler-owned binding units, never in this public module.
MODULE SYS

PUBLIC EXTERNAL PROC Zero(BYTE POINTER address, CARD size)
PUBLIC EXTERNAL PROC SetBlock(BYTE POINTER address, CARD size, BYTE value)
PUBLIC EXTERNAL PROC MoveBlock(BYTE POINTER destination, source, CARD size)

PUBLIC EXTERNAL INT FUNC SCompare(STRING left, right)
PUBLIC EXTERNAL PROC SCopy(STRING destination, source)
PUBLIC EXTERNAL PROC SCopyS(STRING destination, source, BYTE first, last)
PUBLIC EXTERNAL PROC SAssign(STRING destination, source, BYTE first, last)

PUBLIC EXTERNAL BYTE FUNC Rand(BYTE limit)
PUBLIC EXTERNAL PROC Sound(BYTE voice, pitch, distortion, volume)
PUBLIC EXTERNAL PROC SndRst()
PUBLIC EXTERNAL BYTE FUNC Paddle(BYTE port)
PUBLIC EXTERNAL BYTE FUNC PTrig(BYTE port)
PUBLIC EXTERNAL BYTE FUNC Stick(BYTE port)
PUBLIC EXTERNAL BYTE FUNC STrig(BYTE port)

PUBLIC EXTERNAL BYTE FUNC Peek(CARD address)
PUBLIC EXTERNAL CARD FUNC PeekC(CARD address)
PUBLIC EXTERNAL PROC Poke(CARD address, BYTE value)
PUBLIC EXTERNAL PROC PokeC(CARD address, value)

PUBLIC EXTERNAL PROC Graphics(BYTE mode)
PUBLIC EXTERNAL PROC Position(CARD column, BYTE row)
PUBLIC EXTERNAL PROC DrawTo(CARD column, BYTE row)
PUBLIC EXTERNAL BYTE FUNC Locate(CARD column, BYTE row)
PUBLIC EXTERNAL PROC Plot(CARD column, BYTE row)
PUBLIC EXTERNAL PROC SetColor(BYTE register, hue, luminance)
PUBLIC EXTERNAL PROC Fill(CARD column, BYTE row)

ENDMODULE
