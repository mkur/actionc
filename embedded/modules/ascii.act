; Character codes only: no runtime storage or imports.
MODULE ASCII

PUBLIC CONST NUL=0
PUBLIC CONST TAB=9
PUBLIC CONST LF=10
PUBLIC CONST VT=11
PUBLIC CONST FF=12
PUBLIC CONST CR=13
PUBLIC CONST SPACE=32
PUBLIC CONST DOUBLE_QUOTE=34
PUBLIC CONST ASTERISK=42
PUBLIC CONST DIGIT_ZERO=48
PUBLIC CONST DIGIT_NINE=57

; Atari extension, kept here for character handling alongside ASCII.
PUBLIC CONST ATASCII_EOL=$9b

ENDMODULE
