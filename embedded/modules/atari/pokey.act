; POKEY registers.  Read and write aliases at the same address retain their
; hardware-manual names so source code states which behavior it expects.
MODULE ATARI.POKEY

PUBLIC VOLATILE BYTE AUDF1=$D200,
                     AUDC1=$D201,
                     AUDF2=$D202,
                     AUDC2=$D203,
                     AUDF3=$D204,
                     AUDC3=$D205,
                     AUDF4=$D206,
                     AUDC4=$D207,
                     AUDCTL=$D208,
                     STIMER=$D209,
                     SKREST=$D20A,
                     POTGO=$D20B,
                     SEROUT=$D20D,
                     IRQEN=$D20E,
                     SKCTL=$D20F,
                     POT0=$D200,
                     POT1=$D201,
                     POT2=$D202,
                     POT3=$D203,
                     POT4=$D204,
                     POT5=$D205,
                     POT6=$D206,
                     POT7=$D207,
                     ALLPOT=$D208,
                     KBCODE=$D209,
                     RANDOM=$D20A,
                     SERIN=$D20D,
                     IRQST=$D20E,
                     SKSTAT=$D20F

PUBLIC CONST BYTE AUDC_VOLUME_MASK=$0F,
                  AUDC_VOLUME_ONLY=$10,
                  AUDC_PURE_TONE=$20,
                  AUDC_POLY4=$40,
                  AUDC_DIRECT_CLOCK=$80,
                  AUDCTL_POLY9=$80,
                  AUDCTL_CH1_FAST=$40,
                  AUDCTL_CH3_FAST=$20,
                  AUDCTL_JOIN_CH1_CH2=$10,
                  AUDCTL_JOIN_CH3_CH4=$08,
                  AUDCTL_HIGH_PASS_CH1=$04,
                  AUDCTL_HIGH_PASS_CH2=$02,
                  AUDCTL_CLOCK_15KHZ=$01,
                  IRQ_BREAK=$80,
                  IRQ_KEYBOARD=$40,
                  IRQ_SERIAL_INPUT=$20,
                  IRQ_SERIAL_OUTPUT_DATA=$10,
                  IRQ_SERIAL_OUTPUT_COMPLETE=$08,
                  IRQ_TIMER4=$04,
                  IRQ_TIMER2=$02,
                  IRQ_TIMER1=$01,
                  SKCTL_FORCE_BREAK=$80,
                  SKCTL_SERIAL_CLOCK_MASK=$60,
                  SKCTL_ASYNC_RECEIVE=$10,
                  SKCTL_TWO_TONE=$08,
                  SKCTL_FAST_POT=$04,
                  SKCTL_KEYBOARD_SCAN=$02,
                  SKCTL_KEYBOARD_DEBOUNCE=$01,
                  SKCTL_NORMAL=$03,
                  KBCODE_CONTROL=$80,
                  KBCODE_SHIFT=$40,
                  KBCODE_MASK=$3F,
                  POT_MAX=$E4

ENDMODULE
