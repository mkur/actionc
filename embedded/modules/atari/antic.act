; ANTIC hardware registers and display-list constants.
;
; CARD register pairs are declared only where the hardware exposes consecutive
; low-byte/high-byte registers.  A volatile CARD access is ordered, not atomic.
MODULE ATARI.ANTIC

PUBLIC VOLATILE BYTE DMACTL=$D400,
                     CHACTL=$D401,
                     HSCROL=$D404,
                     VSCROL=$D405,
                     PMBASE=$D407,
                     CHBASE=$D409,
                     WSYNC=$D40A,
                     VCOUNT=$D40B,
                     PENH=$D40C,
                     PENV=$D40D,
                     NMIEN=$D40E,
                     NMIST=$D40F,
                     NMIRES=$D40F

; DLISTL/DLISTH are a low-byte-first pair.
PUBLIC VOLATILE CARD DLIST=$D402

PUBLIC CONST BYTE PLAYFIELD_WIDTH_MASK=$03,
                  NO_PLAYFIELD_DMA=$00,
                  DISPLAY_LIST_DMA=$20,
                  PLAYFIELD_DMA=$20,
                  NARROW_PLAYFIELD_DMA=$21,
                  NORMAL_PLAYFIELD_DMA=$22,
                  WIDE_PLAYFIELD_DMA=$23,
                  PLAYER_DMA=$08,
                  MISSILE_DMA=$04,
                  ONE_LINE_PM_DMA=$10,
                  CHACTL_BLINK=$01,
                  CHACTL_INVERT=$02,
                  CHACTL_REFLECT=$04,
                  MODE_2=$02,
                  MODE_3=$03,
                  MODE_4=$04,
                  MODE_5=$05,
                  MODE_6=$06,
                  MODE_7=$07,
                  MODE_8=$08,
                  MODE_9=$09,
                  MODE_A=$0A,
                  MODE_B=$0B,
                  MODE_C=$0C,
                  MODE_D=$0D,
                  MODE_E=$0E,
                  MODE_F=$0F,
                  DL_MODE_MASK=$0F,
                  DL_HSCROL=$10,
                  DL_VSCROL=$20,
                  DL_LMS=$40,
                  DL_DLI=$80,
                  BLANK_1=$00,
                  BLANK_2=$10,
                  BLANK_3=$20,
                  BLANK_4=$30,
                  BLANK_5=$40,
                  BLANK_6=$50,
                  BLANK_7=$60,
                  BLANK_8=$70,
                  JUMP=$01,
                  MODE_F_LMS=$4F,
                  JVB=$41,
                  NMI_RESET=$20,
                  NMI_VBI=$40,
                  NMI_DLI=$80

ENDMODULE
