; Clean-room native REAL text, I/O, and transcendental helpers.
;
; All public entry points pass REAL values by pointer. The Action 2027 native
; type deliberately has no by-value call ABI yet. These routines use Atari OS
; FPP workspaces and ROM entry points directly and therefore require a
; compatible Atari OS.
MODULE ATARI.REAL

USE SYS

REAL FpAccumulator=$00D4
BYTE FpTextIndex=$00F2
CARD FpTextPointer=$00F3

PROC OsAsciiToFp=$D800()
PROC OsFpToAscii=$D8E6()
PROC OsExp=$DDC0()
PROC OsExp10=$DDCC()
PROC OsLog=$DECD()
PROC OsLog10=$DED1()

PUBLIC PROC StrR(REAL POINTER value STRING destination)
  CHAR POINTER source
  BYTE character, length

  FpAccumulator=value^
  OsFpToAscii()
  source=FpTextPointer
  length=0
  DO
    character=source^
    length==+1
    destination(length)=character&$7F
    source==+1
  UNTIL character&$80
  OD
  destination(0)=length
RETURN

PUBLIC PROC ValR(STRING source REAL POINTER destination)
  BYTE ARRAY buffer(256)
  BYTE index, length

  length=source(0)
  index=0
  WHILE index<length
  DO
    buffer(index)=source(index+1)
    index==+1
  OD
  buffer(length)=0
  FpTextPointer=buffer
  FpTextIndex=0
  OsAsciiToFp()
  destination^=FpAccumulator
RETURN

PUBLIC PROC Exp(REAL POINTER source, destination)
  FpAccumulator=source^
  OsExp()
  destination^=FpAccumulator
RETURN

PUBLIC PROC Exp10(REAL POINTER source, destination)
  FpAccumulator=source^
  OsExp10()
  destination^=FpAccumulator
RETURN

PUBLIC PROC Ln(REAL POINTER source, destination)
  FpAccumulator=source^
  OsLog()
  destination^=FpAccumulator
RETURN

PUBLIC PROC Log10(REAL POINTER source, destination)
  FpAccumulator=source^
  OsLog10()
  destination^=FpAccumulator
RETURN

PUBLIC PROC Power(REAL POINTER base, exponent, destination)
  REAL work

  FpAccumulator=base^
  OsLog()
  work=FpAccumulator*exponent^
  FpAccumulator=work
  OsExp()
  destination^=FpAccumulator
RETURN

; Square root using magnitude normalization followed by bounded Newton steps.
; Negative inputs produce zero. If packed-decimal rounding does not converge
; early, the result after ten Newton steps is returned.
PUBLIC PROC Sqrt(REAL POINTER source, destination)
  REAL value,scaled,scale,estimate,next
  BYTE iterations

  value=source^
  IF value<=0 THEN
    destination^=0
    RETURN
  FI

  scaled=value
  scale=1
  WHILE scaled>=100
  DO
    scaled=scaled/100
    scale=scale*10
  OD
  WHILE scaled<1
  DO
    scaled=scaled*100
    scale=scale/10
  OD

  estimate=(scaled+1)/2
  iterations=0
  WHILE iterations<10
  DO
    next=(estimate+scaled/estimate)/2
    IF next=estimate THEN
      destination^=next*scale
      RETURN
    FI
    estimate=next
    iterations==+1
  OD
  destination^=estimate*scale
RETURN

PUBLIC PROC PrintRD(BYTE device, REAL POINTER value)
  STRING text(20)

  StrR(value,text)
  SYS.PrintD(device,text)
RETURN

PUBLIC PROC PrintR(REAL POINTER value)
  STRING text(20)

  StrR(value,text)
  SYS.Print(text)
RETURN

PUBLIC PROC PrintRDE(BYTE device, REAL POINTER value)
  STRING text(20)

  StrR(value,text)
  SYS.PrintD(device,text)
  SYS.PutDE(device)
RETURN

PUBLIC PROC PrintRE(REAL POINTER value)
  STRING text(20)

  StrR(value,text)
  SYS.PrintE(text)
RETURN

PUBLIC PROC InputRD(BYTE device, REAL POINTER destination)
  STRING text(127)

  SYS.InputMD(device,text,126)
  ValR(text,destination)
RETURN

PUBLIC PROC InputR(REAL POINTER destination)
  STRING text(127)

  SYS.InputS(text)
  ValR(text,destination)
RETURN

ENDMODULE
