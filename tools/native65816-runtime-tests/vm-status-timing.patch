+mod status_timing_tests {
+    use super::*;
+    #[test]
+    fn rti_arms_irq_from_the_pulled_status_on_the_data_cycle() {
+        for (old, new) in [(4, 0), (0, 4)] {
+            let mut c = Cpu::start_at(Registers {
+                pc: 0x8000,
+                s: 0x4ff0,
+                p: old,
+                ..Default::default()
