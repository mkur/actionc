+
+#[test]
+fn sep_truncates_indexes_only_on_final_cycle_and_retains_hidden_b() {
+    let mut c = Cpu::start_at(Registers {
+        pc: 0x8000,
+        a: 0xabcd,
+        x: 0x1234,
+        y: 0x5678,
+        ..Default::default()
+    });
+    let p = c.tick(pins::with_data(c.pins(), 0xe2));
+    let p = c.tick(pins::with_data(p, 0x30));
+    assert_eq!(
+        (c.registers().x, c.registers().y, c.registers().p & 0x30),
+        (0x1234, 0x5678, 0)
+    );
+    c.tick(p);
+    assert_eq!(
+        (
+            c.registers().a,
+            c.registers().x,
+            c.registers().y,
+            c.registers().p & 0x30
+        ),
+        (0xabcd, 0x34, 0x78, 0x30)
+    );
+}
+#[test]
+fn corrected_core_passes_independent_instruction_rom() {
+    let mut c = Cpu::default();
+    let mut bus = vec![0u8; 1 << 24];
+    let rom = include_bytes!("data/cputest816.bin");
+    bus[0x8000..0x8000 + rom.len()].copy_from_slice(rom);
+    let mut p = c.pins();
+    let mut output = String::new();
+    for _ in 0..10_000_000 {
+        p = c.tick(p);
+        if pins::is_access(p) {
+            let a = pins::address(p) as usize;
+            if p & pins::RW != 0 {
+                p = pins::with_data(p, bus[a]);
+            } else {
+                bus[a] = pins::data(p);
+                if a == 0x7f01 {
+                    output.push(char::from(pins::data(p)));
+                }
+            }
+        }
+        if c.is_stopped() {
+            assert_eq!(bus[0x7f00], 0xff, "{output}");
+            assert!(output.contains("Success"));
+            return;
+        }
+    }
+    panic!("ROM budget exhausted");
+}
