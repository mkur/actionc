+            let mut p = c.tick(pins::with_data(c.pins(), 0x40));
+            p = c.tick(p);
+            p = c.tick(p);
+            assert_eq!(pins::address(p), 0x4ff1); // P pull, before either PC byte
+            c.tick(pins::with_data(p | pins::IRQ, new));
