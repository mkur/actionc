CARD FUNC CRC16(BYTE POINTER data CARD length)
  CARD crc
  BYTE extract,j
  CARD i
  crc=0
  i=0
  WHILE i<length DO
    extract=data^
    crc=crc XOR (CARD(extract) LSH 8)
    j=8
    WHILE j#0 DO
      IF (crc AND $8000)#0 THEN
        crc=(crc LSH 1) XOR $1021
      ELSE
        crc=crc LSH 1
      FI
      j==-1
    OD
    data==+1
    i==+1
  OD
RETURN(crc)
PROC Main() RETURN
