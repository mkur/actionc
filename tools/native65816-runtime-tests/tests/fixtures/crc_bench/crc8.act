BYTE FUNC CRC8(BYTE POINTER data CARD length)
  BYTE crc
  BYTE extract,j
  CARD i
  crc=0
  i=0
  WHILE i<length DO
    extract=data^
    crc=crc XOR (extract)
    j=8
    WHILE j#0 DO
      IF (crc AND $80)#0 THEN
        crc=(crc LSH 1) XOR $1D
      ELSE
        crc=crc LSH 1
      FI
      j==-1
    OD
    data==+1
    i==+1
  OD
RETURN(crc)
PROC Main() RETURN
