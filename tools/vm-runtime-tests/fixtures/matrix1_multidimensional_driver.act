CONST Rows=10,Inner=10,Columns=10,ElementBytes=4
BYTE command=$0600,done=$06FF
INT result=$0601
LONGINT checksum=$0605
LONGINT ARRAY matrixA(Rows,Inner)=$07FF
LONGINT ARRAY matrixB(Columns,Inner)=$0DFF
LONGINT ARRAY matrixC(Columns,Rows)=$13FF

INCLUDE "multidimensional.inc"

PROC Main()
  IF command=0 THEN Init() FI
  Multiply()
  result=CheckResult()
  done=$A5
RETURN
