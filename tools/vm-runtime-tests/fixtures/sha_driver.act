BYTE command=$0600,done=$06FF
CARD length=$0602
LONGCARD ARRAY digest(5)=$0701
LONGCARD countLo=$0715,countHi=$0719
LONGCARD ARRAY data(16)=$071D
BYTE ARRAY blockBytes(64)=$071D
LONGCARD ARRAY w(80)=$07FD
BYTE ARRAY message(1025)=$0A01

INCLUDE "kernel.inc"

PROC Main()
  IF command=1 THEN
    ; The host supplies all five chaining words and sixteen block words.
    Transform()
  ELSE
    IF command=0 THEN Init() FI
    ; Command 2 retains seeded state for counter carry and wrap tests.
    Update(message,length)
    Final()
  FI
  done=$A5
  DO OD
RETURN
