INCLUDE "statemate-kernel.inc"

; Command 0 is the original zero-initialized benchmark; others test individual steps.
PROC Main()
  signature=0
  IF command=0 THEN
    Init()
    Controller()
  ELSEIF command=1 THEN
    Interface()
  ELSEIF command=2 THEN
    ChildLock()
  ELSEIF command=3 THEN
    DoorControl()
  ELSEIF command=4 THEN
    AntiPinch()
  ELSEIF command=5 THEN
    BlockDetect()
  ELSEIF command=6 THEN
    Controller()
  FI
  signature=$A5
  DO OD
RETURN
