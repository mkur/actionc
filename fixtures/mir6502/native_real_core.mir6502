mir6502 program
global g0 x: REAL storage global+0 size=6
global g1 y: REAL storage global+6 size=6
global g2 result: REAL storage global+12 size=6
static s0 __nir_real_Main_0: REAL bytes [$40 $01 $25 $00 $00 $00] section=rodata align=1 mutable=false display="1.25"
static s1 __nir_real_Main_1: REAL bytes [$3F $50 $00 $00 $00 $00] section=rodata align=1 mutable=false display="0.5"

routine r0 Main
b0 bb0:
  packed_real_copy global g0+0+0, static s0+0+0
  store.b global g1+0, #$40
  store.b global g1+1, #$02
  store.b global g1+2, #$00
  store.b global g1+3, #$00
  store.b global g1+4, #$00
  store.b global g1+5, #$00
  packed_real_copy local l1+0+0, global g0+0+0
  packed_real_copy local l2+0+0, global g1+0+0
  packed_real_copy fixed_zp $D4+0, local l1+0+0
  packed_real_copy fixed_zp $E0+0, local l2+0+0
  call atari-fpp.FMULT@$DADB args=[] result=- clobbers=a|x|y|flags preserves=- effects=opaque,os,stack=0,reads=all,writes=all,clobbers=a|x|y|flags
  packed_real_copy local l0+0+0, fixed_zp $D4+0
  packed_real_copy local l3+0+0, static s1+0+0
  packed_real_copy fixed_zp $D4+0, local l0+0+0
  packed_real_copy fixed_zp $E0+0, local l3+0+0
  call atari-fpp.FADD@$DA66 args=[] result=- clobbers=a|x|y|flags preserves=- effects=opaque,os,stack=0,reads=all,writes=all,clobbers=a|x|y|flags
  packed_real_copy global g2+0+0, fixed_zp $D4+0
  return
