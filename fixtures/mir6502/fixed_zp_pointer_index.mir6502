mir6502 program
global g0 p: word absolute $00F0
global g1 i: byte absolute $00E0
global g2 x: byte storage global+0

routine r0 Main
b0 bb0:
  v0 =.w load global g0+0
  v1 =.b load global g1+0
  v2 =.b load computed v0[v1;1]+0
  store.b global g2+0, v2
  v3 =.w load global g0+0
  v4 =.b load global g1+0
  v5 =.b load global g2+0
  store.b computed v3[v4;1]+0, v5
  return
