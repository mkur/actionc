mir6502 program
global g0 a: byte absolute $00CF

routine r0 Main
b0 bb0:
  v0 =.b load global g0+0
  v1 =.b v0 add #$01 carry_in=- carry_out=ignore
  store.b global g0+0, v1
  v2 =.b load global g0+0
  v3 = cmp.b v2 eq #$0A
  branch bool v3 ? b1 : b2
b1 bb2:
  store.b global g0+0, #$00
  jump b2
b2 bb1:
  return
