mir6502 program
global g0 source: byte storage global+0 size=4 init bytes=[$01 $02 $03 $04] zero_fill=0 section=global mutable=true
global g1 result: byte storage global+4

routine r0 SumBytes
b0 bb0:
  store.b local l0+0, #$00
  jump b1(#$0000:word)
b1 bb1(v12:word):
  v2 =.w load param p1+0
  v3 = cmp.w v12 lt v2
  branch bool v3 ? b2 : b3
b2 bb2:
  v4 =.w load param p0+0
  v6 =.b load computed v4[v12;1]+0
  v7 =.b load local l0+0
  v8 =.b v7 add v6 carry_in=- carry_out=ignore
  store.b local l0+0, v8
  v10 =.w v12 add #$01 carry_in=- carry_out=ignore
  jump b1(v10:word)
b3 bb3:
  v11 =.b load local l0+0
  store.b fixed_zp $A0, v11
  return

routine r1 Main
b0 bb4:
  v0 =.w lea global g0+0
  call r0 args=[v0.w -> a:x, #$0004.w -> y:fixed_zp $A3] result=v2.b <- return+0 clobbers=a|x|y|flags preserves=- effects=stack=?,reads=none,writes=none,clobbers=a|x|y|flags
  store.b global g1+0, v2
  return
