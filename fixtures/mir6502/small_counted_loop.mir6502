mir6502 program
global g0 result: byte storage global+0

routine r0 ShiftEight
b0 bb0:
  store.b local l0+0, #$00
  jump b1
b1 bb1:
  v0 =.b load local l0+0
  v1 = cmp.b v0 le #$07
  branch bool v1 ? b2 : b6
b2 bb2:
  v2 =.b load param p0+0
  v3 =.b v2 and #$80 carry_in=- carry_out=ignore
  v4 = cmp.b v3 ne #$00
  branch bool v4 ? b3 : b4
b3 bb5:
  v5 =.b load param p0+0
  v6 =.b v5 lsh #$01 carry_in=- carry_out=ignore
  v7 =.b v6 xor #$1D carry_in=- carry_out=ignore
  store.b param p0+0, v7
  jump b5
b4 bb6:
  v8 =.b load param p0+0
  v9 =.b v8 lsh #$01 carry_in=- carry_out=ignore
  store.b param p0+0, v9
  jump b5
b5 bb4:
  v10 =.b load local l0+0
  v11 =.b v10 add #$01 carry_in=- carry_out=ignore
  store.b local l0+0, v11
  jump b1
b6 bb3:
  v12 =.b load param p0+0
  store.b fixed_zp $A0, v12
  return

routine r1 Main
b0 bb7:
  call r0 args=[#$01.b -> a] result=v0.b <- return+0 clobbers=a|x|y|flags preserves=- effects=stack=?,reads=none,writes=none,clobbers=a|x|y|flags
  store.b global g0+0, v0
  return
