nir program
global input: Byte
global output: LongInt

routine r0 Select signature=s2954775142 convention=target-public activation=classic-static entry=relocatable params=[value] locals=[scratch]
  inline prefer
  param p0 value: Scalar Byte duration=routine-static size=1 align=1
  local scratch: LongInt duration=routine-static size=4 align=1
bb0:
  %t0:Byte = load value
  %t1:condition = cmp %t0 Ne 0 operand_ty=Byte
  branch %t1 ? bb2 : bb3
bb2:
  %t2:Byte = load value
  %t3:LongInt = cast Byte -> LongInt %t2
  store scratch = %t3
  goto bb1
bb3:
  %t4:Int = cast Byte -> Int 1
  %t5:Int = Neg %t4
  %t6:LongInt = cast Int -> LongInt %t5
  store scratch = %t6
  goto bb1
bb1:
  %t7:LongInt = load scratch
  return %t7

routine r1 Main signature=s2726028260 convention=target-public activation=classic-static entry=program+relocatable params=[-] locals=[-]
bb4:
  %t0:Byte = load input
  %t1:LongInt = call Select(%t0) signature=s2954775142 convention=target-public
  store output = %t1
  return
