nir program
global input: Byte absolute $0600
global result: Byte absolute $0601
global calls: Byte absolute $0602

routine r0 Selector signature=s1079941742 convention=target-public activation=classic-static entry=relocatable params=[-] locals=[-]
bb0:
  %t0:Byte = load calls
  %t1:Byte = %t0 Add 1
  store calls = %t1
  %t2:Byte = load input
  return %t2

routine r1 Main signature=s2726028260 convention=target-public activation=classic-static entry=program+relocatable params=[-] locals=[-]
bb1:
  %t0:Byte = call Selector() signature=s1079941742 convention=target-public
  %t1:condition = cmp %t0 Eq 0 operand_ty=Byte
  branch %t1 ? bb3 : bb5
bb5:
  %t2:condition = cmp %t0 Eq 2 operand_ty=Byte
  branch %t2 ? bb3 : bb4
bb3:
  store result = 10
  goto bb2
bb4:
  %t3:condition = cmp %t0 Eq 255 operand_ty=Byte
  branch %t3 ? bb6 : bb7
bb6:
  store result = 20
  goto bb2
bb7:
  store result = 30
  goto bb2
bb2:
  return
