nir program
target motorola-68000 cpu=Motorola68000 endian=Big address_bits=32 data_pointer=4 code_pointer=4 abi=Motorola68kNative activation=native-reentrant
global words: array ArrayType { element: ValueType { base: Fund(Card), pointer: false }, length: Some(2) } length=2 storage=Array origin=global init descriptor size=6 backing=g0 bytes=[$00 $00 $00 $00] fragments=[0:int16=$1, 2:int16=$2] zero_fill=0 backing_section=global.backing size_word=$0000 section=global mutable=true
global result: Card

routine r0 Main signature=s2726028260 convention=target-public activation=native-reentrant entry=program+relocatable params=[-] locals=[-]
bb0:
  %t0:Card* = addr words
  %t1:Card = load %t0[0;2]
  store result = %t1
  return
