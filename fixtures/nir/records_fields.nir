nir program
global Pair: type RecordType { name: "Pair", fields: [RecordFieldType { id: Some(FieldId(0)), name: "tag", ty: ValueType { base: Fund(Byte), pointer: false }, storage: Value, offset: 0 }, RecordFieldType { id: Some(FieldId(1)), name: "word", ty: ValueType { base: Fund(Card), pointer: false }, storage: Value, offset: 1 }], size: 3 } fields=2
global rec: Pair
global gb: Byte
global gw: Card

routine r0 Touch signature=s2610349039 convention=target-public activation=classic-static entry=relocatable params=[rp] locals=[-]
  param p0 rp: Scalar Pair* duration=routine-static size=2 align=1
bb0:
  store rp.+0 = 17
  store rp.+1 = $2233
  %t0:Byte = load rp.+0
  store gb = %t0
  %t1:Card = load rp.+1
  store gw = %t1
  return

routine r1 Main signature=s2726028260 convention=target-public activation=classic-static entry=program+relocatable params=[-] locals=[-]
bb1:
  %t0:Pair* = addr rec
  call Touch(%t0) signature=s2610349039 convention=target-public
  return
