nir program
global Pair: type RecordType { name: "Pair", fields: [RecordFieldType { id: Some(FieldId(0)), name: "tag", ty: ValueType { base: Fund(Byte), pointer: false }, offset: 0 }, RecordFieldType { id: Some(FieldId(1)), name: "word", ty: ValueType { base: Fund(Card), pointer: false }, offset: 1 }], size: 3 } fields=2
global bytes: array ArrayType { element: ValueType { base: Fund(Byte), pointer: false }, length: Some(7) } length=7 storage=Array origin=global init zero_fill=7 section=global mutable=true
global byteSize: Card
global cardSize: Card
global pointerSize: Card
global recordPointerSize: Card
global recordSize: Card
global arraySize: Card
global elementCount: Card
global recordAlign: Card
global wordOffset: Card

routine Main params=[-] locals=[-]
  note Action program entry (last source PROC)
bb0:
  store byteSize = $1
  store cardSize = $2
  store pointerSize = $2
  store recordPointerSize = $2
  store recordSize = $3
  store arraySize = $7
  store elementCount = $7
  store recordAlign = $1
  store wordOffset = $1
  return
