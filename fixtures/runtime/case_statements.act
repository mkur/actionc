; Inputs are supplied by the VM, after loading. Guard bytes remain untouched.
VOLATILE BYTE input=$0600
BYTE result=$0602,calls=$0603,missing=$0604
INT signedInput=$0610
CARD unsignedInput=$0610
BYTE signedResult=$0620,unsignedResult=$0621,pointerResult=$0622
BYTE done=$06FF

BYTE FUNC Selector()
  calls==+1
RETURN(input)

PROC Main()
  BYTE POINTER ptr
  BYTE __actionc_case_0

  __actionc_case_0=71
  calls=0
  CASE Selector() OF
  WHEN 0 TO 2 THEN
    result=10
  WHEN 127 TO 129, 255 THEN
    result=20
  ELSE
    result=30
  ESAC
  missing=__actionc_case_0
  CASE input OF
  WHEN 255 THEN
    missing=72
  ESAC
  CASE signedInput OF
  WHEN -32768 TO -1 THEN
    signedResult=40
  WHEN 0 THEN
    signedResult=41
  WHEN 1 TO 32767 THEN
    signedResult=42
  ESAC
  CASE unsignedInput OF
  WHEN 0 TO 255 THEN
    unsignedResult=50
  WHEN 256 TO $FFFE THEN
    unsignedResult=51
  ELSE
    unsignedResult=52
  ESAC
  ptr=$0600
  CASE ptr^ OF
  WHEN 0 TO 127 THEN
    pointerResult=60
  ELSE
    pointerResult=61
  ESAC
  done=$A5
  DO OD
RETURN
