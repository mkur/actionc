; Host-fed call composition and Q8.8 motion, including a word across $6FF/$700.
MODULE FIXED_Q8_8_COMPOSITION
USE MATH.Q8_8 AS Q

INT a=$6E0,b=$6E2
INT ratio=$601,repeated=$603,position=$605,whole=$607
INT negative=$609,difference=$60B,sum=$60D
BYTE below=$60F,equal=$610,calls=$630,trace=$631,done=$6DF
INT ARRAY table(2)=$6FD

INT FUNC Left()
  calls==+1
  trace=trace*3+1
RETURN(a)

INT FUNC Right()
  calls==+1
  trace=trace*3+2
RETURN(b)

PROC Main()
  INT leftValue,rightValue,halfValue,velocity,increment,two
  INT POINTER destination
  BYTE i
  calls=0 trace=0
  destination=@table

  ; The modern VM companion also executes these two stores with nested calls.
  leftValue=Left()
  rightValue=Right()
  table(0)=Q.Mul(leftValue,rightValue)
  leftValue=Left()
  halfValue=Q.Mul(leftValue,Q.Half)
  rightValue=Right()
  destination(1)=Q.Div(halfValue,rightValue)

  repeated=Q.Mul(b,a)
  ratio=Q.FromRatio(a,b)
  velocity=Q.FromRatio(b,3)
  halfValue=Q.Mul(velocity,Q.Half)
  two=Q.FromInt(2)
  increment=Q.Div(halfValue,two)
  position=a
  FOR i=0 TO 2 DO position==+increment OD
  whole=Q.Trunc(position)
  negative=-a
  difference=a-b
  sum=a+b
  below=0 equal=0
  IF a<b THEN below=1 FI
  IF a=b THEN equal=1 FI
  done=$A5
  DO OD
RETURN
ENDMODULE
