; Exercise graphics helpers whose observable result is OS and GTIA state.
; No screen device or cartridge is needed for these two routines.

PROC Main()
  Position($1234,$56)
  SetColor(4,1,2)
  SetColor(5,1,2)
  SetColor(132,1,2)
  SetColor(133,1,2)
  SetColor(255,1,2)
  SetColor(2,$0A,$0C)

  DO
  OD
RETURN
