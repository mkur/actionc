BYTE ARRAY buffer(512)
BYTE observed

; This fixture isolates pointer retention across the call.
;@actionc reviewed-6502 ba2968aab09c5a80
;@actionc preserves A Y
;@actionc reads-only none
;@actionc writes-only none
PROC Touch=*()
ASM
  ldx #$55
  rts
ENDASM

PROC ReadFixed(BYTE POINTER p)
  BYTE index
  Touch()
  FOR index=0 TO 31 DO
    observed=p(index)
    Touch()
    observed=p(index)
  OD
RETURN

PROC Main()
  ReadFixed(buffer)
RETURN
