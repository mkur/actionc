; Ordinary pointee writes beside live invocation-owned source homes.
BYTE reserved=$E4
BYTE observedBefore=$E5, observedAfter=$E8
BYTE POINTER observed=$E6
BYTE observedValue
PROC POINTER vector
PROC POINTER dispatchVector=$E9
BYTE indexedBefore
BYTE ARRAY indexed(256)
BYTE indexedAfter
CARD targetsBefore
CARD ARRAY targets(128)
CARD targetsAfter
DATA menu=["Yes" 'Y "Abort" 'A $00]

PROC JumpTarget()
  observedValue==+1
RETURN

PROC JumpSymbolic=*()
ASM
  jmp (vector)
ENDASM

PROC DispatchIndexed=*()
ASM
  ldx #2
  lda targets-2,x
  sta dispatchVector
  lda targets-1,x
  sta dispatchVector+1
  jmp (dispatchVector)
ENDASM

PROC CopyIndexed()
  BYTE bufBefore
  BYTE ARRAY buf(256)
  BYTE bufAfter
ASM
  lda bufBefore
  lda bufAfter
  ldx #1
  lda indexed-1,x
  sta buf-1,x
  lda buf-1,x
  sta observedValue
ENDASM
RETURN

PROC ReadFixed=*()
ASM
  ldy #0
  lda (observed),y
  sta observedValue
  rts
ENDASM

BYTE FUNC MenuKey(BYTE index)
  BYTE POINTER p
  p=@menu
  WHILE index>0 DO
    p==+p^+5
    index==-1
  OD
  p==+p^+3
RETURN(p^)

BYTE FUNC Touch(BYTE x)
RETURN(x+1)

CARD FUNC SwapWords(CARD ARRAY v BYTE index)
  CARD saved
  BYTE other
  other=index RSH 1
  saved=v(other)
  v(other)=v(other+1)
  index=Touch(index)
  v(other+1)=saved
RETURN(saved)

BYTE FUNC SwapBytes(BYTE ARRAY v BYTE index)
  BYTE saved,other
  other=index RSH 1
  saved=v(other)
  v(other)=v(other+1)
  index=Touch(index)
  v(other+1)=saved
RETURN(saved XOR index)

BYTE FUNC ShiftZero(BYTE x,keep)
  x=x LSH 0
RETURN(x XOR keep)

BYTE FUNC ShiftEight(BYTE x,keep)
  x=x RSH 8
RETURN(x XOR keep)

PROC Main()
RETURN
