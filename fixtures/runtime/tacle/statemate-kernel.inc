; TACLeBench Statemate, originally generated by STARC for Friedhelm Stappert.
; Upstream revision: c6a0d73e47bbd2bc86e34637156fb26dd4d5cf08
; May be used, modified, and re-distributed freely; see statemate.c and README.md.
; Modern Action!: all 16 switches remain CASE; early C breaks become ELSE paths.
; C logical operands are explicitly compared with zero, including noncanonical flags.
; BYTE flags, INT measurements/counters, LONGCARD timestamps. No OS I/O.

; Update timestamps and expire the five 500-tick timers.
PROC Interface()
  IF bitlist(4) THEN
    tmRepeat=time
  FI
  IF ((bitlist(4)<>0) OR (bitlist(6)<>0)) THEN
    tmReady=time
  FI
  IF ((sc_DoorCtl_2375_2 <> 0) AND ((time - sc_DoorCtl_2375_2) >= 500)) THEN
    Door_MFHA_copy=0
    sc_DoorCtl_2375_2=0
  FI
  IF ((sc_DoorCtl_2352_1 <> 0) AND ((time - sc_DoorCtl_2352_1) >= 500)) THEN
    Door_MFHZ_copy=0
    sc_DoorCtl_2352_1=0
  FI
  IF ((sc_DoorCtl_2329_1 <> 0) AND ((time - sc_DoorCtl_2329_1) >= 500)) THEN
    Door_MFHZ_copy=0
    sc_DoorCtl_2329_1=0
  FI
  IF ((sc_DoorCtl_1781_10 <> 0) AND ((time - sc_DoorCtl_1781_10) >= 500)) THEN
    sc_DoorCtl_1781_10=0
  FI
  IF ((sc_DoorCtl_1739_10 <> 0) AND ((time - sc_DoorCtl_1739_10) >= 500)) THEN
    sc_DoorCtl_1739_10=0
  FI
  IF ((bitlist(0)<>0) OR (Block_N <> Block_N_old)) THEN
    tmMeasure=time
  FI
RETURN

; Reset the statechart control states, as in the upstream initializer.
PROC Init()
  tmMeasure=0
  tmReady=0
  tmRepeat=0
  UninitState=0
  ZENTRAL_ChildState=0
  MEC_ChildState=0
  ChildState=0
  B_DoorCtlState=0
  A_DoorCtlState=0
  Repeat_DoorCtlState=0
  Init_DoorCtlState=0
  TapClose_DoorCtlState=0
  ManualClose_DoorCtlState=0
  Open_DoorCtlState=0
  Close_DoorCtlState=0
  MotorState=0
  PinchState=0
  Motion_BlockState=0
  BlockState=0
  Interface()
RETURN

; Select central or mechanical window buttons, including edge detection.
PROC ChildLock()
  IF bitlist(10) THEN
    CASE ChildState OF
    WHEN 1 THEN
      IF (((Door_SFHA_ZENTRAL<>0) OR (Door_SFHZ_ZENTRAL<>0))=0) THEN
        stable=0
        Door_SFHZ_copy=0
        Door_SFHA_copy=0
        ChildState=3
        ZENTRAL_ChildState=0
      ELSE
        CASE ZENTRAL_ChildState OF
        WHEN 1 THEN
          IF ((Door_SFHA_ZENTRAL<>0) AND ((Door_SFHA_ZENTRAL_old=0)<>0)) THEN
            stable=0
            Door_SFHA_copy=1
            ZENTRAL_ChildState=1
          ELSE
            IF ((Door_SFHZ_ZENTRAL<>0) AND ((Door_SFHZ_ZENTRAL_old=0)<>0)) THEN
              stable=0
              Door_SFHZ_copy=1
              ZENTRAL_ChildState=1
            ELSE
              IF (((Door_SFHA_ZENTRAL=0)<>0) AND (Door_SFHA_ZENTRAL_old<>0)) THEN
                stable=0
                Door_SFHA_copy=0
                ZENTRAL_ChildState=1
              ELSE
                IF (((Door_SFHZ_ZENTRAL=0)<>0) AND (Door_SFHZ_ZENTRAL_old<>0)) THEN
                  stable=0
                  Door_SFHZ_copy=0
                  ZENTRAL_ChildState=1
                FI
              FI
            FI
          FI
        ELSE
          stable=0
        ESAC
      FI
    WHEN 2 THEN
      IF (((Door_SFHA_MEC<>0) OR (Door_SFHZ_MEC<>0))=0) THEN
        stable=0
        Door_SFHZ_copy=0
        Door_SFHA_copy=0
        ChildState=3
        MEC_ChildState=0
      ELSE
        CASE MEC_ChildState OF
        WHEN 1 THEN
          IF ((Door_SFHA_MEC<>0) AND ((Door_SFHA_MEC_old=0)<>0)) THEN
            stable=0
            Door_SFHA_copy=1
            MEC_ChildState=1
          ELSE
            IF ((Door_SFHZ_MEC<>0) AND ((Door_SFHZ_MEC_old=0)<>0)) THEN
              stable=0
              Door_SFHZ_copy=1
              MEC_ChildState=1
            ELSE
              IF (((Door_SFHA_MEC=0)<>0) AND (Door_SFHA_MEC_old<>0)) THEN
                stable=0
                Door_SFHA_copy=0
                MEC_ChildState=1
              ELSE
                IF (((Door_SFHZ_MEC=0)<>0) AND (Door_SFHZ_MEC_old<>0)) THEN
                  stable=0
                  Door_SFHZ_copy=0
                  MEC_ChildState=1
                FI
              FI
            FI
          FI
        ELSE
          stable=0
        ESAC
      FI
    WHEN 3 THEN
      IF (((Door_KL_50=0)<>0) AND ((Door_SFHZ_MEC<>0) AND (Door_SFHA_MEC<>0))) THEN
        stable=0
        Door_SFHZ_copy=1
        Door_SFHA_copy=1
        ChildState=2
      ELSE
        IF (((Door_KL_50=0)<>0) AND ((Door_SFHZ_MEC<>0) AND ((Door_SFHA_MEC=0)<>0))) THEN
          stable=0
          Door_SFHZ_copy=1
          ChildState=2
        ELSE
          IF (((Door_KL_50=0)<>0) AND (((Door_SFHZ_MEC=0)<>0) AND (Door_SFHA_MEC<>0))) THEN
            stable=0
            Door_SFHA_copy=1
            ChildState=2
          ELSE
            IF ((((Door_SFHZ_ZENTRAL=0)<>0) AND (Door_SFHA_ZENTRAL<>0)) AND ((Door_KL_50=0)<>0)) THEN
              stable=0
              Door_SFHA_copy=1
              ChildState=1
            ELSE
              IF ((Door_SFHZ_ZENTRAL<>0) AND (Door_SFHA_ZENTRAL<>0)) THEN
                stable=0
                Door_SFHA_copy=1
                Door_SFHZ_copy=1
                ChildState=1
              ELSE
                IF (((Door_SFHZ_ZENTRAL<>0) AND ((Door_SFHA_ZENTRAL=0)<>0)) AND ((Door_KL_50=0)<>0)) THEN
                  stable=0
                  Door_SFHZ_copy=1
                  ChildState=1
                FI
              FI
            FI
          FI
        FI
      FI
    ELSE
      stable=0
      ChildState=3
    ESAC
  FI
RETURN

; Window motion, nested opening/closing states, reversal, and repeat lockout.
PROC DoorControl()
  IF ((((bitlist(13)=0)<>0) AND (bitlist(15)<>0)) AND ((bitlist(14)=0)<>0)) THEN
    bitlist(4)=0
    bitlist(6)=0
  FI
  IF bitlist(13) THEN
    IF (bitlist(10)=0) THEN
      ChildState=3
    FI
    bitlist(11)=0
    IF (bitlist(19)=0) THEN
      bitlist(0)=0
      BlockState=1
    FI
    bitlist(20)=0
    bitlist(11)=1
    bitlist(20)=1
    CASE B_DoorCtlState OF
    WHEN 1 THEN
      IF ((DoorCtl_N = 59) AND (((DoorCtl_N_old = 59)=0)<>0)) THEN
        stable=0
        B_DoorCtlState=3
        Init_DoorCtlState=3
      FI
    WHEN 2 THEN
      IF (((Door_BLOCK<>0) AND ((Door_BLOCK_old=0)<>0)) AND (Door_MFHZ<>0)) THEN
        stable=0
        Door_MFHZ_copy=0
        sc_DoorCtl_2329_1=time
        B_DoorCtlState=3
        Init_DoorCtlState=3
      ELSE
        CASE UninitState OF
        WHEN 1 THEN
          IF (Door_SFHZ=0) THEN
            stable=0
            Door_MFHZ_copy=0
            UninitState=3
          FI
        WHEN 2 THEN
          IF (Door_SFHA=0) THEN
            stable=0
            Door_MFHA_copy=0
            UninitState=3
          FI
        WHEN 3 THEN
          IF Door_SFHA THEN
            stable=0
            Door_MFHA_copy=1
            UninitState=2
          ELSE
            IF Door_SFHZ THEN
              stable=0
              Door_MFHZ_copy=1
              UninitState=1
            FI
          FI
        ELSE
          stable=0
          UninitState=3
        ESAC
      FI
    WHEN 3 THEN
      IF (((DoorCtl_N > 60) AND (((DoorCtl_N_old > 60)=0)<>0)) AND ((((DoorCtl_INREVERS1<>0) OR (DoorCtl_INREVERS2<>0))=0)<>0)) THEN
        stable=0
        Door_MFHZ_copy=0
        Door_MFHA_copy=0
        B_DoorCtlState=1
      ELSE
        IF (((Door_BLOCK<>0) AND ((Door_BLOCK_old=0)<>0)) AND (Door_MFHA<>0)) THEN
          stable=0
          Door_MFHA_copy=0
          sc_DoorCtl_2375_2=time
          B_DoorCtlState=2
          UninitState=3
        ELSE
          IF (((Door_BLOCK<>0) AND ((Door_BLOCK_old=0)<>0)) AND (Door_MFHZ<>0)) THEN
            stable=0
            Door_MFHZ_copy=0
            sc_DoorCtl_2352_1=time
            B_DoorCtlState=2
            UninitState=3
          ELSE
            CASE Init_DoorCtlState OF
            WHEN 1 THEN
              IF (Door_POSITION >= 405) THEN
                stable=0
                Door_MFHA_copy=0
                Init_DoorCtlState=3
              ELSE
                CASE Open_DoorCtlState OF
                WHEN 1 THEN
                  IF (((Door_SFHZ<>0) AND ((Door_SFHZ_old=0)<>0)) OR ((Door_SFHA<>0) AND ((Door_SFHA_old=0)<>0))) THEN
                    stable=0
                    Door_MFHA_copy=0
                    Init_DoorCtlState=3
                    Open_DoorCtlState=0
                  FI
                WHEN 2 THEN
                  IF ((Door_SFHZ<>0) AND ((Door_SFHZ_old=0)<>0)) THEN
                    stable=0
                    Open_DoorCtlState=1
                  ELSE
                    IF (((Door_SFHA=0)<>0) AND (Door_SFHA_old<>0)) THEN
                      stable=0
                      Door_MFHA_copy=0
                      Init_DoorCtlState=3
                      Open_DoorCtlState=0
                    FI
                  FI
                ELSE
                  stable=0
                  Open_DoorCtlState=2
                ESAC
              FI
            WHEN 2 THEN
              IF (Door_POSITION <= 0) THEN
                stable=0
                Door_MFHZ_copy=0
                Init_DoorCtlState=3
              ELSE
                CASE Close_DoorCtlState OF
                WHEN 1 THEN
                  IF (((Door_SFHA<>0) AND ((Door_SFHA_old=0)<>0)) OR ((Door_SFHZ<>0) AND ((Door_SFHZ_old=0)<>0))) THEN
                    stable=0
                    Door_MFHZ_copy=0
                    Init_DoorCtlState=3
                  ELSE
                    CASE TapClose_DoorCtlState OF
                    WHEN 1 THEN
                      bitlist(23)=0
                      IF bitlist(22) THEN
                        stable=0
                        Door_MFHZ_copy=1
                        DoorCtl_INREVERS2_copy=0
                        TapClose_DoorCtlState=2
                        Door_MFHA_copy=0
                        bitlist(17)=1
                      FI
                    WHEN 2 THEN
                      IF bitlist(24) THEN
                        stable=0
                        DoorCtl_INREVERS2_copy=1
                        bitlist(23)=1
                        TapClose_DoorCtlState=1
                        bitlist(17)=0
                        Door_MFHZ_copy=0
                        sc_DoorCtl_1781_10=time
                        Door_MFHA_copy=1
                      FI
                    ELSE
                      stable=0
                      TapClose_DoorCtlState=2
                      bitlist(17)=1
                    ESAC
                  FI
                WHEN 2 THEN
                  IF (((Door_SFHZ=0)<>0) AND (Door_SFHZ_old<>0)) THEN
                    stable=0
                    Door_MFHZ_copy=0
                    Init_DoorCtlState=3
                  ELSE
                    CASE ManualClose_DoorCtlState OF
                    WHEN 1 THEN
                      bitlist(23)=0
                      IF bitlist(22) THEN
                        stable=0
                        DoorCtl_INREVERS1_copy=0
                        ManualClose_DoorCtlState=2
                        Door_MFHA_copy=0
                        bitlist(17)=1
                        Door_MFHZ_copy=1
                      FI
                    WHEN 2 THEN
                      IF bitlist(24) THEN
                        stable=0
                        Door_MFHZ_copy=0
                        DoorCtl_INREVERS1_copy=1
                        bitlist(23)=1
                        ManualClose_DoorCtlState=1
                        bitlist(17)=0
                        sc_DoorCtl_1739_10=time
                        Door_MFHA_copy=1
                      ELSE
                        IF ((Door_SFHA<>0) AND ((Door_SFHA_old=0)<>0)) THEN
                          stable=0
                          Close_DoorCtlState=1
                          ManualClose_DoorCtlState=0
                        FI
                      FI
                    ELSE
                      stable=0
                      ManualClose_DoorCtlState=2
                      bitlist(17)=1
                      Door_MFHZ_copy=1
                    ESAC
                  FI
                ELSE
                  stable=0
                  Close_DoorCtlState=2
                  ManualClose_DoorCtlState=2
                  bitlist(17)=1
                  Door_MFHZ_copy=1
                ESAC
              FI
            WHEN 3 THEN
              IF (((Door_SFHZ<>0) AND ((Door_SFHZ_old=0)<>0)) AND (Door_POSITION > 0)) THEN
                stable=0
                Init_DoorCtlState=2
                Close_DoorCtlState=2
                ManualClose_DoorCtlState=2
                bitlist(17)=1
                Door_MFHZ_copy=1
              ELSE
                IF (((Door_SFHA<>0) AND ((Door_SFHA_old=0)<>0)) AND (Door_POSITION < 405)) THEN
                  stable=0
                  Door_MFHA_copy=1
                  Init_DoorCtlState=1
                  Open_DoorCtlState=2
                FI
              FI
            ELSE
              stable=0
              Init_DoorCtlState=3
            ESAC
          FI
        FI
      FI
    ELSE
      stable=0
      B_DoorCtlState=2
    ESAC
    CASE A_DoorCtlState OF
    WHEN 1 THEN
      bitlist(5)=0
      IF ((((microstep = 1) AND (tmReady <> 0)) AND ((time - tmReady) = 1)) AND ((Door_MFHZ<>0) OR (Door_MFHA<>0))) THEN
        stable=0
        DoorCtl_N=(DoorCtl_N + 1)
        A_DoorCtlState=1
        bitlist(5)=1
        Repeat_DoorCtlState=1
      ELSE
        CASE Repeat_DoorCtlState OF
        WHEN 1 THEN
          IF ((((microstep = 1) AND (tmRepeat <> 0)) AND ((time - tmRepeat) = 3)) AND (((((Door_MFHZ<>0) OR (Door_MFHA<>0))=0)<>0) AND (DoorCtl_N > 0))) THEN
            stable=0
            DoorCtl_N=(DoorCtl_N - 1)
            Repeat_DoorCtlState=1
          FI
        ELSE
          stable=0
          bitlist(5)=1
          Repeat_DoorCtlState=1
        ESAC
      FI
    ELSE
      stable=0
      DoorCtl_N=0
      A_DoorCtlState=1
      bitlist(5)=1
      Repeat_DoorCtlState=1
    ESAC
    bitlist(5)=bitlist(4)
    bitlist(7)=bitlist(6)
  FI
RETURN

; Detect the rising/falling edge of the anti-pinch sensor.
PROC AntiPinch()
  IF bitlist(16) THEN
    CASE PinchState OF
    WHEN 1 THEN
      IF (((Door_EKS_LEISTE_AKTIV<>0) AND ((Door_EKS_LEISTE_AKTIV_old=0)<>0)) AND ((((Door_SFHZ<>0) AND (Door_SFHA<>0))=0)<>0)) THEN
        stable=0
        bitlist(24)=1
        PinchState=2
      FI
    WHEN 2 THEN
      bitlist(24)=0
      IF (((Door_EKS_LEISTE_AKTIV=0)<>0) AND (Door_EKS_LEISTE_AKTIV_old<>0)) THEN
        stable=0
        PinchState=1
      FI
    ELSE
      stable=0
      PinchState=1
    ESAC
  FI
RETURN

; Measure motor current, then detect a stalled window.
PROC BlockDetect()
  IF ((((bitlist(19)=0)<>0) AND (bitlist(21)<>0)) AND ((bitlist(20)=0)<>0)) THEN
    bitlist(0)=0
  FI
  IF bitlist(19) THEN
    CASE BlockState OF
    WHEN 1 THEN
      IF ((Door_I_EIN <> Door_I_EIN_old) AND (Door_I_EIN > 0)) THEN
        stable=0
        Door_BLOCK_copy=0
        BlockState=2
        Block_N=0
        Block_I_EIN_MAX=2
        Motion_BlockState=3
        bitlist(0)=1
      FI
    WHEN 2 THEN
      IF ((((Door_MFHA=0)<>0) AND (Door_MFHA_old<>0)) OR (((Door_MFHZ=0)<>0) AND (Door_MFHZ_old<>0))) THEN
        stable=0
        BlockState=1
        Motion_BlockState=0
      ELSE
        CASE Motion_BlockState OF
        WHEN 1 THEN
        WHEN 2 THEN
          IF (Door_I_EIN > (Block_I_EIN_MAX - 2)) THEN
            stable=0
            Door_BLOCK_copy=1
            Motion_BlockState=1
          FI
        WHEN 3 THEN
          bitlist(0)=0
          IF ((Block_N = 11) AND (((Block_N_old = 11)=0)<>0)) THEN
            stable=0
            Motion_BlockState=2
          ELSE
            IF (Motion_BlockState = 3) THEN
              IF (((microstep = 1) AND (tmMeasure <> 0)) AND ((time - tmMeasure) = 2)) THEN
                Block_N=(Block_N + 1)
                IF (Door_I_EIN > Block_I_EIN_MAX) THEN
                  Block_I_EIN_MAX=Door_I_EIN
                FI
              FI
            FI
          FI
        ELSE
          stable=0
          Block_N=0
          Block_I_EIN_MAX=2
          Motion_BlockState=3
          bitlist(0)=1
        ESAC
      FI
    ELSE
      stable=0
      BlockState=1
    ESAC
  FI
RETURN

; Upstream WCET driver: fixed clock 1 and exactly 100 microsteps.
; Preserve the original order of controller calls and old/copy signal transfers.
PROC Controller()
  BYTE i
  time=1
  stable=0
  microstep=0
  FOR i=0 TO 99 DO
    stable=1
    microstep==+1
    CASE MotorState OF
    WHEN 1 THEN
      IF (((Unit_MFHZ=0)<>0) AND (Unit_MFHZ_old<>0)) THEN
        stable=0
        Unit_MFH=0
        MotorState=2
      FI
    WHEN 2 THEN
      IF ((Unit_MFHZ<>0) AND ((Unit_MFHZ_old=0)<>0)) THEN
        stable=0
        Unit_MFH=(-100)
        MotorState=1
      ELSE
        IF ((Unit_MFHA<>0) AND ((Unit_MFHA_old=0)<>0)) THEN
          stable=0
          Unit_MFH=100
          MotorState=3
        FI
      FI
    WHEN 3 THEN
      IF (((Unit_MFHA=0)<>0) AND (Unit_MFHA_old<>0)) THEN
        stable=0
        Unit_MFH=0
        MotorState=2
      FI
    ELSE
      stable=0
      Unit_MFH=0
      MotorState=2
    ESAC
    IF (bitlist(10)=0) THEN
      ChildState=3
    FI
    bitlist(11)=0
    IF (bitlist(16)=0) THEN
      PinchState=1
    FI
    bitlist(17)=0
    IF (bitlist(19)=0) THEN
      bitlist(0)=0
      BlockState=1
    FI
    bitlist(20)=0
    IF (bitlist(13)=0) THEN
      bitlist(4)=0
      bitlist(6)=0
      B_DoorCtlState=2
      DoorCtl_N=0
      A_DoorCtlState=1
      bitlist(5)=1
      Repeat_DoorCtlState=1
    FI
    bitlist(14)=0
    bitlist(11)=1
    bitlist(17)=1
    bitlist(20)=1
    bitlist(14)=1
    IF (Unit_S_FH_TMBFZUCAN <> Unit_S_FH_TMBFZUCAN_old) THEN
      IF (Unit_DOOR_ID=0) THEN
        Unit_S_FH_FTZU=Unit_S_FH_TMBFZUCAN
      FI
    FI
    IF (Unit_S_FH_TMBFZUDISC <> Unit_S_FH_TMBFZUDISC_old) THEN
      IF Unit_DOOR_ID THEN
        Unit_S_FH_TMBFZUCAN=Unit_S_FH_TMBFZUDISC
      FI
    FI
    IF (Unit_S_FH_TMBFAUFCAN <> Unit_S_FH_TMBFAUFCAN_old) THEN
      IF (Unit_DOOR_ID=0) THEN
        Unit_S_FH_FTAUF=Unit_S_FH_TMBFAUFCAN
      FI
    FI
    IF (Unit_S_FH_TMBFAUFDISC <> Unit_S_FH_TMBFAUFDISC_old) THEN
      IF Unit_DOOR_ID THEN
        Unit_S_FH_TMBFAUFCAN=Unit_S_FH_TMBFAUFDISC
      FI
    FI
    bitlist(10)=bitlist(12)
    bitlist(13)=bitlist(15)
    bitlist(16)=bitlist(18)
    bitlist(19)=bitlist(21)
    Door_SFHA_MEC=Unit_S_FH_AUFDISC
    Door_SFHA_ZENTRAL=Unit_S_FH_FTAUF
    Door_SFHZ_MEC=Unit_S_FH_ZUDISC
    Door_SFHZ_ZENTRAL=Unit_S_FH_FTZU
    ChildLock()
    Unit_MFHA=Door_MFHA
    Unit_MFHZ=Door_MFHZ
    Unit_I_EIN=Door_I_EIN
    Unit_EKS_LEISTE_AKTIV=Door_EKS_LEISTE_AKTIV
    Unit_POSITION=Door_POSITION
    Unit_FT=Door_FT
    Unit_S_FH_AUFDISC=Door_SFHA_MEC
    Unit_S_FH_FTAUF=Door_SFHA_ZENTRAL
    Unit_S_FH_ZUDISC=Door_SFHZ_MEC
    Unit_S_FH_FTZU=Door_SFHZ_ZENTRAL
    Unit_KL_50=Door_KL_50
    Unit_BLOCK=Door_BLOCK
    Door_SFHA_MEC=Unit_S_FH_AUFDISC
    Door_SFHA_ZENTRAL=Unit_S_FH_FTAUF
    Door_SFHZ_MEC=Unit_S_FH_ZUDISC
    Door_SFHZ_ZENTRAL=Unit_S_FH_FTZU
    DoorControl()
    Unit_MFHA=Door_MFHA
    Unit_MFHZ=Door_MFHZ
    Unit_I_EIN=Door_I_EIN
    Unit_EKS_LEISTE_AKTIV=Door_EKS_LEISTE_AKTIV
    Unit_POSITION=Door_POSITION
    Unit_FT=Door_FT
    Unit_S_FH_AUFDISC=Door_SFHA_MEC
    Unit_S_FH_FTAUF=Door_SFHA_ZENTRAL
    Unit_S_FH_ZUDISC=Door_SFHZ_MEC
    Unit_S_FH_FTZU=Door_SFHZ_ZENTRAL
    Unit_KL_50=Door_KL_50
    Unit_BLOCK=Door_BLOCK
    Door_SFHA_MEC=Unit_S_FH_AUFDISC
    Door_SFHA_ZENTRAL=Unit_S_FH_FTAUF
    Door_SFHZ_MEC=Unit_S_FH_ZUDISC
    Door_SFHZ_ZENTRAL=Unit_S_FH_FTZU
    AntiPinch()
    Unit_MFHA=Door_MFHA
    Unit_MFHZ=Door_MFHZ
    Unit_I_EIN=Door_I_EIN
    Unit_EKS_LEISTE_AKTIV=Door_EKS_LEISTE_AKTIV
    Unit_POSITION=Door_POSITION
    Unit_FT=Door_FT
    Unit_S_FH_AUFDISC=Door_SFHA_MEC
    Unit_S_FH_FTAUF=Door_SFHA_ZENTRAL
    Unit_S_FH_ZUDISC=Door_SFHZ_MEC
    Unit_S_FH_FTZU=Door_SFHZ_ZENTRAL
    Unit_KL_50=Door_KL_50
    Unit_BLOCK=Door_BLOCK
    Door_SFHA_MEC=Unit_S_FH_AUFDISC
    Door_SFHA_ZENTRAL=Unit_S_FH_FTAUF
    Door_SFHZ_MEC=Unit_S_FH_ZUDISC
    Door_SFHZ_ZENTRAL=Unit_S_FH_FTZU
    BlockDetect()
    Unit_MFHA=Door_MFHA
    Unit_MFHZ=Door_MFHZ
    Unit_I_EIN=Door_I_EIN
