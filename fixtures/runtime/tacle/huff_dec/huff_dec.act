; Huffman decoder by David Bourgin (1994), from TACLeBench huff_dec.
; Action! adaptation, 2026. See README.md and huff_dec.c for attribution/terms.
; The host supplies valid streams and zeroed code/tree storage. No recursion.

INCLUDE "types.inc"

BYTE command,done
CARD inputLength,inputPos,outputPos
BYTE bitsLeft
LONGCARD reservoir
CARD request
LONGCARD result
Tree POINTER rootAddress
CARD nodeCount
BYTE ARRAY encoded(12288),decoded(1024)
Code ARRAY codes(257)
Tree ARRAY heap(514)

INCLUDE "kernel.inc"

; Test-only record queries; no native offsets are encoded in the host adapter.
LONGCARD layoutCodeSize,layoutCodeBits,layoutCodeLength,layoutCodePresent
LONGCARD layoutTreeSize,layoutTreeSymbol,layoutTreeLeft,layoutTreeRight
LONGCARD layoutCardSize,layoutPointerSize

PROC QueryLayout()
  layoutCodeSize=SIZEOF(Code)
  layoutCodeBits=OFFSETOF(Code,bits) layoutCodeLength=OFFSETOF(Code,length)
  layoutCodePresent=OFFSETOF(Code,present)
  layoutTreeSize=SIZEOF(Tree)
  layoutTreeSymbol=OFFSETOF(Tree,symbol) layoutTreeLeft=OFFSETOF(Tree,left)
  layoutTreeRight=OFFSETOF(Tree,right)
  layoutCardSize=SIZEOF(CARD) layoutPointerSize=SIZEOF(rootAddress)
RETURN

PROC Main()
  IF command=$FF THEN QueryLayout() RETURN FI
  IF command=0 THEN Decode()
  ELSEIF command=1 THEN result=ReadBits(request)
  ELSE result=ReadBit() FI
  done=$A5
RETURN
