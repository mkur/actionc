; TACLeBench/MiBench Dijkstra port. Upstream author unknown; GNU GPL.
; Revision c6a0d73e47bbd2bc86e34637156fb26dd4d5cf08. See README.md.
; The host supplies the graph and reads complete node/queue state from RAM.

INCLUDE "types.inc"

BYTE command,done
INT startNode,endNode,result,checksum
INT queueCount,queueNext
QueueItem POINTER headAddress
QueueItem POINTER head
INT argNode,argDist,argPrev
INT outNode,outDist,outPrev,seedNext
Node ARRAY nodes(NumNodes)
Row ARRAY matrix(NumNodes)
QueueItem ARRAY items(QueueSize)

INCLUDE "kernel.inc"

; Test-only layout queries keep host code independent of native record padding.
LONGCARD layoutNodeSize,layoutNodeDist,layoutNodePrev
LONGCARD layoutQueueSize,layoutQueueNode,layoutQueueDist,layoutQueuePrev,layoutQueueNext
LONGCARD layoutRowSize,layoutRowCost,layoutIntSize,layoutPointerSize

PROC QueryLayout()
  layoutNodeSize=SIZEOF(Node)
  layoutNodeDist=OFFSETOF(Node,dist) layoutNodePrev=OFFSETOF(Node,prev)
  layoutQueueSize=SIZEOF(QueueItem)
  layoutQueueNode=OFFSETOF(QueueItem,node) layoutQueueDist=OFFSETOF(QueueItem,dist)
  layoutQueuePrev=OFFSETOF(QueueItem,prev) layoutQueueNext=OFFSETOF(QueueItem,next)
  layoutRowSize=SIZEOF(Row) layoutRowCost=OFFSETOF(Row,cost)
  layoutIntSize=SIZEOF(INT) layoutPointerSize=SIZEOF(headAddress)
RETURN

PROC Main()
  IF command=$FF THEN QueryLayout() RETURN FI
  ; A numeric POINTER initializer is not a portable fixed-storage binding.
  ; Transfer the host's address explicitly into the typed queue pointer.
  head=headAddress
  IF command=0 THEN
    Init()
    Benchmark()
    result=ChecksumResult()
  ELSEIF command=1 THEN
    Init()
    queueNext=seedNext
    result=Find(startNode,endNode)
  ELSEIF command=2 THEN
    result=Enqueue(argNode,argDist,argPrev)
  ELSE
    Dequeue(@outNode,@outDist,@outPrev)
    result=0
  FI
  headAddress=head
  done=$A5
RETURN
