; Portable matrix state; see kernel.inc for the shared algorithm.
CONST Rows=10,Inner=10,Columns=10,ElementBytes=4
BYTE command
INT result
LONGINT checksum
LONGINT ARRAY matrixA(Rows*Inner)
LONGINT ARRAY matrixB(Inner*Columns)
LONGINT ARRAY matrixC(Rows*Columns)

INCLUDE "kernel.inc"

PROC Main()
  IF command=0 THEN Init() FI
  Multiply()
  result=CheckResult()
RETURN
