; Runtime coverage for direct byte-array indexing with a BYTE value carried
; around a loop. The unaligned absolute bases and boundary indices exercise
; ordinary 6502 absolute-indexed page crossing.

BYTE result0=$0600
BYTE result1=$0601
BYTE result127=$0602
BYTE result128=$0603
BYTE result255=$0604
BYTE sourceBeforeResult=$0605
BYTE sourceAfterResult=$0606
BYTE destinationBeforeResult=$0607
BYTE destinationAfterResult=$0608
BYTE signature=$0609

BYTE sourceBefore=$6000
BYTE ARRAY source(256)=$6001
BYTE sourceAfter=$6101

BYTE destinationBefore=$6202
BYTE ARRAY destination(256)=$6203
BYTE destinationAfter=$6303

PROC Main()
  BYTE i

  sourceBefore=$D1
  sourceAfter=$D2
  destinationBefore=$E1
  destinationAfter=$E2

  FOR i=0 TO 254
    DO
    source(i)=i!$A5
    destination(i)=source(i)
    OD
  i=255
  source(i)=i!$A5
  destination(i)=source(i)

  result0=destination(0)
  result1=destination(1)
  result127=destination(127)
  result128=destination(128)
  result255=destination(255)
  sourceBeforeResult=sourceBefore
  sourceAfterResult=sourceAfter
  destinationBeforeResult=destinationBefore
  destinationAfterResult=destinationAfter
  signature=$A5

  DO
  OD
RETURN
