BYTE ARRAY left="ABC"
BYTE ARRAY right="BC"
BYTE ARRAY destination(8)
INT comparison
BYTE byteValue
CARD cardValue
INT intValue

PROC Main()
  comparison=SCompare(left,right)
  IF comparison<0 THEN
    SCopy(destination,left)
  ELSE
    SCopy(destination,right)
  FI
  SCopyS(destination,left,1,2)
  SAssign(destination,right,1,2)
  StrB(byteValue,destination)
  StrC(cardValue,destination)
  StrI(intValue,destination)
RETURN
