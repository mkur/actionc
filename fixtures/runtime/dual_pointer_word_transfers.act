; Runtime regression for overlap-safe MIR6502 dual-pointer word transfers.
;
; Both transfer directions are exercised with disjoint storage and with the
; destination overlapping one source byte. The overlapping cases require both
; source bytes to be read before the first destination write.

TYPE WORDCELL=[CARD value]

CARD indexedToIndirectResult=$0600
CARD indirectToIndexedResult=$0602
CARD indexedToIndirectOverlapResult=$0604
CARD indirectToIndexedOverlapResult=$0606
CARD localPointerResult=$0608
CARD parameterPointerResult=$060A
CARD compoundDisjointResult=$060C
CARD compoundIdenticalResult=$060E
CARD compoundSourceAboveResult=$0610
CARD compoundSourceBelowResult=$0612
CARD compoundPageCrossingResult=$0614
CARD compoundWrapResult=$0616
CARD directCopyExactResult=$0618
CARD directCopyAboveResult=$061A
CARD directCopyBelowResult=$061C

CARD ARRAY indexedSource(256)=$6001
CARD ARRAY indexedDestination(256)=$6201
CARD POINTER transferPointer, transferDestinationPointer
WORDCELL POINTER compoundTargetPointer, compoundSourcePointer
BYTE directCopyBefore
WORDCELL directCopySource
BYTE directCopyAfter
BYTE index
BYTE compoundAbove0=$6920
BYTE compoundAbove1=$6921
BYTE compoundAbove2=$6922
BYTE compoundBelow0=$6930
BYTE compoundBelow1=$6931
BYTE compoundBelow2=$6932

PROC LocalPointerCopy()
  CARD POINTER sourcePointer, destinationPointer

  sourcePointer=$6821
  destinationPointer=$6831
  sourcePointer^=$1357
  destinationPointer^=sourcePointer^
  localPointerResult=destinationPointer^
RETURN

PROC ParameterPointerCopy(CARD POINTER destinationPointer, sourcePointer)
  destinationPointer^=sourcePointer^
RETURN

PROC Compound(WORDCELL POINTER targetPointer,sourcePointer)
  targetPointer.value=targetPointer.value+sourcePointer.value
RETURN

PROC DirectCopy(WORDCELL POINTER destination)
  destination.value=directCopySource.value
RETURN

PROC Main()
  ; Scaled indexed source to an unrelated indirect destination.
  index=3
  indexedSource(index)=$1234
  transferPointer=$6801
  transferPointer^=indexedSource(index)
  indexedToIndirectResult=transferPointer^

  ; Indirect source to an unrelated scaled indexed destination.
  transferPointer=$6811
  transferPointer^=$5678
  index=4
  indexedDestination(index)=transferPointer^
  indirectToIndexedResult=indexedDestination(index)

  ; indexedSource(127) occupies $60FF-$6100. The destination starts at
  ; $6100, so its low-byte write overwrites the source high byte.
  index=127
  indexedSource(index)=$BEEF
  transferPointer=$6100
  transferPointer^=indexedSource(index)
  indexedToIndirectOverlapResult=transferPointer^

  ; The source occupies $62FE-$62FF and indexedDestination(127) starts at
  ; $62FF, so the destination low byte overwrites the source high byte.
  transferPointer=$62FE
  transferPointer^=$CAFE
  index=127
  indexedDestination(index)=transferPointer^
  indirectToIndexedOverlapResult=indexedDestination(index)

  ; Direct indirect-to-indirect copies rematerialize private pointer cells
  ; into the two compiler-owned pointer pairs.
  LocalPointerCopy()

  transferPointer=$6841
  transferDestinationPointer=$6851
  transferPointer^=$2468
  ParameterPointerCopy(transferDestinationPointer,transferPointer)
  parameterPointerResult=transferDestinationPointer^

  ; Destination-aware word arithmetic uses separate compiler-owned pointer
  ; pairs and must read all four input bytes before its first target write.
  compoundTargetPointer=$6900
  compoundSourcePointer=$6910
  compoundTargetPointer.value=$00FF
  compoundSourcePointer.value=$0001
  Compound(compoundTargetPointer,compoundSourcePointer)
  compoundDisjointResult=compoundTargetPointer.value

  compoundTargetPointer=$6918
  compoundTargetPointer.value=$1234
  Compound(compoundTargetPointer,compoundTargetPointer)
  compoundIdenticalResult=compoundTargetPointer.value

  ; The source begins one byte above the target: [01 02] + [02 03].
  compoundAbove0=1
  compoundAbove1=2
  compoundAbove2=3
  compoundTargetPointer=$6920
  compoundSourcePointer=$6921
  Compound(compoundTargetPointer,compoundSourcePointer)
  compoundSourceAboveResult=compoundTargetPointer.value

  ; The source begins one byte below the target: [02 03] + [01 02].
  compoundBelow0=1
  compoundBelow1=2
  compoundBelow2=3
  compoundTargetPointer=$6931
  compoundSourcePointer=$6930
  Compound(compoundTargetPointer,compoundSourcePointer)
  compoundSourceBelowResult=compoundTargetPointer.value

  compoundTargetPointer=$69FF
  compoundSourcePointer=$6AFF
  compoundTargetPointer.value=$7FFF
  compoundSourcePointer.value=$0001
  Compound(compoundTargetPointer,compoundSourcePointer)
  compoundPageCrossingResult=compoundTargetPointer.value

  compoundTargetPointer=$6B00
  compoundSourcePointer=$6B10
  compoundTargetPointer.value=$FFFF
  compoundSourcePointer.value=$0001
  Compound(compoundTargetPointer,compoundSourcePointer)
  compoundWrapResult=compoundTargetPointer.value

  ; The direct source must be fully read before a possibly overlapping
  ; destination is written.
  directCopySource.value=$1234
  compoundTargetPointer=directCopySource
  DirectCopy(compoundTargetPointer)
  directCopyExactResult=compoundTargetPointer.value

  directCopySource.value=$0201
  directCopyAfter=3
  compoundTargetPointer=directCopySource
  compoundTargetPointer==+1
  DirectCopy(compoundTargetPointer)
  directCopyAboveResult=compoundTargetPointer.value

  directCopyBefore=3
  directCopySource.value=$0201
  compoundTargetPointer=directCopySource
  compoundTargetPointer==-1
  DirectCopy(compoundTargetPointer)
  directCopyBelowResult=compoundTargetPointer.value

  DO
  OD
RETURN
