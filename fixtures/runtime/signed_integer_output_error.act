; The VM rejects the minus sign and changes DEVICE to 4 in the returning handler.
MODULE SIGNED_OUTPUT_ERROR
USE SYS

BYTE choice=$0600,deviceAfter=$0601,done=$0602

PROC Main()
  SYS.Open(2,"D:CURRENT.TXT",8,0)
  SYS.Open(3,"D:EXPLICIT.TXT",8,0)
  SYS.Open(4,"D:AFTER.TXT",8,0)
  DEVICE=2
  IF choice=0 THEN SYS.PrintIE(-32768)
  ELSE SYS.PrintIDE(3,-32768)
  FI
  deviceAfter=DEVICE
  DEVICE=0
  SYS.Close(4) SYS.Close(3) SYS.Close(2)
  done=$A5
  DO OD
RETURN
ENDMODULE
