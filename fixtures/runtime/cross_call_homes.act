; Ordinary calls with live parameters, replaced pointers and source locals.
CARD FUNC AdvanceRecord(BYTE POINTER p)
RETURN(p+p^+3)

BYTE FUNC FindRecord(BYTE POINTER p,wanted)
  BYTE n
  n=0
  WHILE p^ DO
    IF p=wanted THEN EXIT FI
    n==+1
    p=AdvanceRecord(p)
  OD
RETURN(n)

BYTE FUNC CountRecords(BYTE POINTER p)
  BYTE n
  n=0
  WHILE p^ DO
    n==+1
    p=AdvanceRecord(p)
  OD
RETURN(n)

CARD FUNC AddOne(CARD value)
RETURN(value+1)

CARD FUNC KeepWord(CARD value,keep)
RETURN(AddOne(value)+keep)

BYTE FUNC Bump(BYTE value)
RETURN(value+1)

BYTE FUNC Conditional(BYTE value,enabled)
  IF enabled THEN value=Bump(value) FI
RETURN(value)

BYTE FUNC Persistent(BYTE reset)
  BYTE saved
  reset=Bump(reset)
  saved==+1
RETURN(saved)

PROC Main()
RETURN
