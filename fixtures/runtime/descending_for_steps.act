; Descending FOR loops are inclusive and must stop before the counter wraps.

BYTE byteRange=$0600
BYTE byteBoundary=$0601
BYTE byteStride=$0602
BYTE cardBoundary=$0603
BYTE intRange=$0604
BYTE intBoundary=$0605
BYTE signature=$0606

BYTE byteCounter
CARD cardCounter
INT intCounter

PROC Main()
  byteRange=0
  FOR byteCounter=3 TO 1 STEP -1
  DO
    byteRange==+1
  OD

  byteBoundary=0
  FOR byteCounter=1 TO 0 STEP -1
  DO
    byteBoundary==+1
  OD

  byteStride=0
  FOR byteCounter=5 TO 0 STEP -2
  DO
    byteStride==+1
  OD

  cardBoundary=0
  FOR cardCounter=1 TO 0 STEP -1
  DO
    cardBoundary==+1
  OD

  intRange=0
  FOR intCounter=1 TO -1 STEP -1
  DO
    intRange==+1
  OD

  intBoundary=0
  FOR intCounter=-32767 TO -32768 STEP -1
  DO
    intBoundary==+1
  OD

  signature=$A5
  DO
  OD
RETURN
