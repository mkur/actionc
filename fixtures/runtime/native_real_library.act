MODULE NATIVE_REAL_LIBRARY_TEST

USE ATARI.REAL AS FPP

REAL source=$0600,
     exp_result=$0606,
     exp10_result=$060C,
     ln_result=$0612,
     log10_result=$0618,
     parsed_result=$061E,
     sqrt_zero=$0700,
     sqrt_one=$0706,
     sqrt_two=$070C,
     sqrt_four=$0712,
     sqrt_small=$0718,
     sqrt_large=$071E
BYTE ARRAY text(20)=$0624
BYTE done=$0638

PROC Main()
  source=0
  FPP.Exp(@source,@exp_result)
  source=2
  FPP.Exp10(@source,@exp10_result)
  source=1
  FPP.Ln(@source,@ln_result)
  source=100
  FPP.Log10(@source,@log10_result)
  FPP.StrR(@log10_result,text)
  FPP.ValR(text,@parsed_result)
  source=0
  FPP.Sqrt(@source,@sqrt_zero)
  source=1
  FPP.Sqrt(@source,@sqrt_one)
  source=2
  FPP.Sqrt(@source,@sqrt_two)
  source=4
  FPP.Sqrt(@source,@sqrt_four)
  source=0.0001
  FPP.Sqrt(@source,@sqrt_small)
  source=10000
  FPP.Sqrt(@source,@sqrt_large)
  done=$A5
  DO OD
RETURN

ENDMODULE
