INT ARRAY results(60)=$0600
BYTE signature=$06FF

PROC CheckSLt()
  INT i
  INT a4,a5,a10,a14,a15
  a4=0 a5=0 a10=0 a14=0 a15=0
  i=5
  WHILE i<15 DO
    IF i<4 THEN a4==+1 FI
    IF i<5 THEN a5==+1 FI
    IF i<10 THEN a10==+1 FI
    IF i<14 THEN a14==+1 FI
    IF i<15 THEN a15==+1 FI
    i==+1
  OD
  results(0)=a4
  results(1)=a5
  results(2)=a10
  results(3)=a14
  results(4)=a15
RETURN

