PROC Main()
  signature=0
  CheckSLt()
  CheckSLe()
  CheckSGt()
  CheckSGe()
  CheckSEq()
  CheckSNe()
  CheckULt()
  CheckULe()
  CheckUGt()
  CheckUGe()
  CheckUEq()
  CheckUNe()

  signature=$A5
  DO OD
RETURN
