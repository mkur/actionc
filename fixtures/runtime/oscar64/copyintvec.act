INT original=$0600,count=$06F4
CARD sourceAddress=$06F0,destinationAddress=$06F2
INT POINTER source,destination
BYTE signature=$06FF

PROC Copy(INT POINTER a,b INT n)
  INT i
  i=0
  WHILE i<n DO b(i)=a(i) i==+1 OD
RETURN

PROC Main()
  INT ARRAY t(100),s(100)
  INT i,sum
  signature=0
  source=sourceAddress destination=destinationAddress
  i=0
  WHILE i<100 DO s(i)=i i==+1 OD
  Copy(s,t,100)
  sum=0 i=0
  WHILE i<100 DO sum==+t(i) i==+1 OD
  original=sum-4950
  Copy(source,destination,count)
  signature=$A5
  DO OD
RETURN
