TYPE Point=[INT x,y]
TYPE Mixed=[BYTE tag INT x CARD color INT y]
Point ARRAY tcorners(8)=$7001,pcorners(8)=$7103
INT original=$0600
CARD originalCalls=$0602,calls=$0604
CARD sourceAddress=$06F0,destinationAddress=$06F2
INT count=$06F4
Mixed POINTER source,destination
BYTE signature=$06FF

INT FUNC BmLine()
  calls==+1
RETURN(0)

PROC DrawCube()
  BYTE i
  i=0
  WHILE i<8 DO
    IF (i&1)=0 THEN BmLine() FI
    IF (i&2)=0 THEN BmLine() FI
    IF (i&4)=0 THEN BmLine() FI
    pcorners(i)=tcorners(i)
    i==+1
  OD
RETURN

PROC CopyRecords(Mixed POINTER d,s INT n)
  INT i
  i=0
  WHILE i<n DO
    IF (i&1)=0 THEN BmLine() FI
    IF (i&2)=0 THEN BmLine() FI
    IF (i&4)=0 THEN BmLine() FI
    d(i)=s(i)
    i==+1
  OD
RETURN

PROC Main()
  INT i,sum
  signature=0 calls=0
  i=0
  WHILE i<8 DO
    tcorners(i).x=(i+1)*3
    tcorners(i).y=(i+1)*7
    i==+1
  OD
  DrawCube()
  originalCalls=calls
  sum=0 i=0
  WHILE i<8 DO
    sum==+pcorners(i).x
    sum==-tcorners(i).y
    i==+1
  OD
  original=sum+144

  source=sourceAddress destination=destinationAddress
  calls=0
  CopyRecords(destination,source,count)
  CopyRecords(destination,source,count)
  signature=$A5
  DO OD
RETURN
