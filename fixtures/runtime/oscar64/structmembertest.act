; Adapted from Oscar64 autotest/structmembertest.c (drmortalwombat and contributors).
; Source revision: 8deb94c4d762bab3aa60c9565412691f01021bbb
; GPL-3.0; see README.md for provenance and semantic adaptations.
; Modern-only: the original x[100]/y[100] members remain inline, not pointers.

TYPE ARecord=[INT ARRAY x(100),y(100)]
TYPE Vector=[INT x,y,z]
TYPE Wide=[INT ARRAY x(257),y(257)]
TYPE Marked=[BYTE tag INT x,y,z]
CARD originalFailures=$0600
CARD arraysAddress=$06F0,vectorsAddress=$06F2
INT count=$06F4
Wide POINTER arrays
Marked POINTER vectors
BYTE signature=$06FF

PROC Copy(ARecord POINTER a)
  INT i
  i=0
  WHILE i<100 DO
    a.x(i)=a.y(i)
    i==+1
  OD
RETURN

PROC Shuffle(Vector POINTER v)
  INT i
  i=0
  WHILE i<100 DO
    v(i).x=v(i).y
    i==+1
  OD
RETURN

PROC CopyWide(Wide POINTER a INT n)
  INT i
  i=0
  WHILE i<n DO
    a.x(i)=a.y(i)
    i==+1
  OD
RETURN

PROC ShuffleMarked(Marked POINTER v INT n)
  INT i
  i=0
  WHILE i<n DO
    v(i).x=v(i).y
    i==+1
  OD
RETURN

PROC Main()
  ARecord a=$7001
  Vector ARRAY v(100)=$7403
  INT i
  signature=0 originalFailures=0
  i=0
  WHILE i<100 DO
    a.y(i)=i
    v(i).y=i
    i==+1
  OD
  Copy(@a)
  Shuffle(v)
  i=0
  WHILE i<100 DO
    IF a.x(i)#i THEN originalFailures==+1 FI
    IF v(i).x#i THEN originalFailures==+1 FI
    i==+1
  OD

  arrays=arraysAddress vectors=vectorsAddress
  CopyWide(arrays,count)
  ShuffleMarked(vectors,count)
  signature=$A5
  DO OD
RETURN
