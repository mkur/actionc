BYTE ARRAY a(20),fixed(257)=$5001,descriptor
BYTE original=$0600,signature=$06FF
CARD fixedSum=$0602,descriptorSum=$0604,count=$06F0

PROC Main()
  BYTE i,x
  CARD j
  signature=0
  i=0
  WHILE i<20 DO a(i)=i i==+1 OD
  x=0 i=0
  WHILE i<20 DO x==+a(i) i==+1 OD
  original=x

  descriptor=$5001
  fixedSum=0 descriptorSum=0 j=0
  WHILE j<count DO
    fixed(j)=BYTE(j)
    j==+1
  OD
  j=0
  WHILE j<count DO
    fixedSum==+fixed(j)
    descriptorSum==+descriptor(j)
    j==+1
  OD
  signature=$A5
  DO OD
RETURN
