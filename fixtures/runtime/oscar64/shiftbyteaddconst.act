PROC LiteralShiftAdd(BYTE a CARD amount,start)
  CARD index
  index=start
  literalShift(index)=(CARD(a) LSH 0)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 1)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 2)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 3)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 4)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 5)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 6)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 7)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 8)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 9)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 10)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 11)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 12)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 13)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 14)+amount
  index==+1
  literalShift(index)=(CARD(a) LSH 15)+amount
  index==+1
RETURN

PROC LiteralShiftSub(BYTE a CARD amount,start)
  CARD index
  index=start
  literalShift(index)=(CARD(a) LSH 0)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 1)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 2)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 3)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 4)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 5)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 6)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 7)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 8)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 9)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 10)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 11)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 12)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 13)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 14)-amount
  index==+1
  literalShift(index)=(CARD(a) LSH 15)-amount
  index==+1
RETURN

PROC Main()
  CARD group,s,count,index,amount
  signature=0
  FillLiterals(value,firstIndex)

  group=0
  WHILE group<8 DO
    amount=amounts(group)
    index=firstIndex+group*16
    IF group<5 THEN
      LiteralShiftAdd(value,amount,index)
    ELSE
      LiteralShiftSub(value,amount,index)
    FI
    s=0
    WHILE s<16 DO
      count=shiftCounts(s)
      IF group<5 THEN
        runtimeBoth(index)=(CARD(value) LSH count)+amount
      ELSE
        runtimeBoth(index)=(CARD(value) LSH count)-amount
      FI
      index==+1
      s==+1
    OD
    group==+1
  OD

  s=0
  WHILE s<16 DO
    count=shiftCounts(s)
    index=firstIndex+s
    literalAmount(index+0)=(CARD(value) LSH count)+CARD(15)
    literalAmount(index+16)=(CARD(value) LSH count)+CARD(16)
    literalAmount(index+32)=(CARD(value) LSH count)+CARD(111)
    literalAmount(index+48)=(CARD(value) LSH count)+CARD(4096)
    literalAmount(index+64)=(CARD(value) LSH count)+CARD(13421)
    literalAmount(index+80)=(CARD(value) LSH count)-CARD(15)
    literalAmount(index+96)=(CARD(value) LSH count)-CARD(16)
    literalAmount(index+112)=(CARD(value) LSH count)-CARD(4096)
    s==+1
  OD
  signature=$A5
  DO OD
RETURN
