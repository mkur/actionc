; Adapted from Oscar64 autotest/shiftbyteaddconst.cpp (drmortalwombat and contributors).
; Source revision: 8deb94c4d762bab3aa60c9565412691f01021bbb
; GPL-3.0; see README.md for provenance and semantic adaptations.

; The expanded literal grid needs more code space than the smaller ports.
; Keep it below the independently guarded $6F00-$7FFF host workspace.
ORG $2000

; Four tables, grouped by amount then shift: literal/literal, runtime/runtime,
; literal shift/runtime amount, runtime shift/literal amount.
; CARD(value) explicitly widens BEFORE shifting. CARD amounts keep word
; wraparound, including subtraction, independent of C integer promotions.
CARD ARRAY literalBoth(256)=$7001,runtimeBoth(256)=$7403,
           literalShift(256)=$7805,literalAmount(256)=$7C07
CARD ARRAY shiftCounts(16)=$06B0,amounts(8)=$06D0
BYTE value=$06F0,signature=$06FF
CARD firstIndex=$06F4

PROC FillLiterals(BYTE a CARD start)
  CARD index
  index=start
  literalBoth(index)=(CARD(a) LSH 0)+CARD(15)
  index==+1
  literalBoth(index)=(CARD(a) LSH 1)+CARD(15)
  index==+1
  literalBoth(index)=(CARD(a) LSH 2)+CARD(15)
