; Exercise decimal output on the console, the current output channel, and an explicit channel.
MODULE RESIDENT_NUMERIC_OUTPUT_TEST

USE SYS

REAL positiveReal,negativeReal
BYTE currentOutput=$B7

PROC Main()
  INT minimum,minusOne,minusValue

  minimum=0
  minimum==-32767
  minimum==-1
  minusOne=0
  minusOne==-1
  minusValue=0
  minusValue==-1234

  PrintB(0)
  Put('|)
  PrintBE(255)
  PrintBD(0,42)
  Put('|)
  PrintBDE(0,7)

  PrintC(0)
  Put('|)
  PrintCE(65535)
  PrintCD(0,1234)
  Put('|)
  PrintCDE(0,42)

  PrintI(minusOne)
  Put('|)
  PrintIE(32767)
  PrintID(0,minusValue)
  Put('|)
  PrintIDE(0,minimum)

  positiveReal=1.25
  negativeReal=-2.5
  Open(2,"D:CURRENT.TXT",8,0)
  Open(3,"D:EXPLICIT.TXT",8,0)
  currentOutput=2
  SYS.PrintR(@positiveReal)
  Put('|)
  SYS.PrintRE(@positiveReal)
  SYS.PrintRD(3,@negativeReal)
  PutD(3,'|)
  SYS.PrintRDE(3,@negativeReal)
  currentOutput=0
  Close(3)
  Close(2)

  DO
  OD
RETURN

ENDMODULE
