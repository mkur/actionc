; A void assembly leaf exposes inputs and writes without a result-definition proof.
BYTE seen=$0680, seenTag=$0681
CARD input=$0690, output=$0693
BYTE inputTag=$0692

;@actionc reviewed-6502 1708f582d66de737
;@actionc abi-inputs-only
;@actionc entry-reads abi
;@actionc reads-only none
;@actionc writes-only $0680 $AC/$AD
PROC Touch=*(BYTE value)
ASM
  sta $0680
  sta $AC
  ldx #$5A
  stx $AD
  rts
ENDASM

PROC Middle(BYTE value)
  Touch(value)
RETURN

CARD FUNC Hold(CARD keep BYTE tag)
  BYTE n
  n=tag
  Middle(7)
  seenTag=n
RETURN(keep+n)

PROC Main()
  output=Hold(input,inputTag)
RETURN
