BYTE readCharacter=$0600
BYTE currentOutput=$B7

PROC Main()
  Open(1,"D:INPUT.TXT",4,0)
  readCharacter=GetD(1)
  XIO(1,0,13,0,0,"D:INPUT.TXT")
  XIO(1,0,$7E,0,0,"")
  Close(1)
  Open(2,"D:OUTPUT.TXT",8,0)
  PutD(2,'Q)
  currentOutput=2
  Put('R)
  PutE()
  Print("C")
  Print("")
  PrintE("D")
  PrintE("")
  PrintD(2,"E")
  PrintD(2,"")
  PrintDE(2,"F")
  PrintDE(2,"")
  PutDE(2)
  Close(2)
  DO
  OD
RETURN
